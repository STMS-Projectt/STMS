      SELECT [s6].[Id], [s6].[ApproverEmployeeProfileId], [s6].[Comments], [s6].[DecidedAt], [s6].[Decision], [s6].[EvaluationReportId], [s6].[SelectedBidId], [s6].[Id0], [s6].[DepartmentId], [s6].[FullName], [s6].[IsActive], [s6].[JobTitle], [s6].[UserId], [s5].[Id], [s5].[Id0]&#xD;
      FROM (&#xD;
          SELECT TOP(1) [t].[Id], [e].[Id] AS [Id0]&#xD;
          FROM [Tenders] AS [t]&#xD;
          LEFT JOIN [EvaluationReports] AS [e] ON [t].[Id] = [e].[TenderId]&#xD;
          WHERE ([t].[Status] = N'Under Evaluation' OR [e].[Id] IS NOT NULL) AND [e].[Id] IS NOT NULL AND [e].[Status] IN (N'Pending Top Committee', N'Awarded', N'Cancelled', N'Cancelled - Awaiting Manager Handoff', N'Cancelled - Ready to Retender') AND EXISTS (&#xD;
              SELECT 1&#xD;
              FROM [TenderCommitteeMembers] AS [t0]&#xD;
              WHERE [t].[Id] = [t0].[TenderId] AND [t0].[CommitteeType] = N'Top' AND [t0].[EmployeeProfileId] = @employeeId) AND [t].[Id] = @id&#xD;
          ORDER BY [t].[Id], [e].[Id]&#xD;
      ) AS [s5]&#xD;
      INNER JOIN (&#xD;
          SELECT [t2].[Id], [t2].[ApproverEmployeeProfileId], [t2].[Comments], [t2].[DecidedAt], [t2].[Decision], [t2].[EvaluationReportId], [t2].[SelectedBidId], [e2].[Id] AS [Id0], [e2].[DepartmentId], [e2].[FullName], [e2].[IsActive], [e2].[JobTitle], [e2].[UserId]&#xD;
          FROM [TenderApprovals] AS [t2]&#xD;
          INNER JOIN [EmployeeProfiles] AS [e2] ON [t2].[ApproverEmployeeProfileId] = [e2].[Id]&#xD;
      ) AS [s6] ON [s5].[Id0] = [s6].[EvaluationReportId]&#xD;
      ORDER BY [s5].[Id], [s5].[Id0]&#xD;
