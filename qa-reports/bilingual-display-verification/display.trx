      Executed DbCommand (16ms) [Parameters=[@employee_Id='?' (DbType = Int32), @employee_DepartmentId='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT [t].[Id], [t].[Title], [t].[Status], [t].[PurchaseRequisitionId], CASE&#xD;
          WHEN [p].[CreatedByEmployeeProfileId] = @employee_Id AND [p].[Status] IN (N'Draft', N'Returned') THEN CAST(1 AS bit)&#xD;
          ELSE CAST(0 AS bit)&#xD;
      END&#xD;
      FROM [Tenders] AS [t]&#xD;
      INNER JOIN [PurchaseRequisitions] AS [p] ON [t].[PurchaseRequisitionId] = [p].[Id]&#xD;
