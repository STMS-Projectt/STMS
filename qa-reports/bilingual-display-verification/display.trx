      SELECT [t].[Id], [t].[Title], [t].[Status], [t].[PurchaseRequisitionId], [e].[Id], (&#xD;
          SELECT COUNT(*)&#xD;
          FROM [TenderRounds] AS [t0]&#xD;
          WHERE [t0].[TenderId] = [t].[Id]), (&#xD;
          SELECT COUNT(*)&#xD;
          FROM [EvaluationSubmissions] AS [e0]&#xD;
          WHERE [e0].[TenderId] = [t].[Id]), CASE&#xD;
          WHEN [e].[Id] IS NULL THEN 0&#xD;
          ELSE (&#xD;
              SELECT COUNT(*)&#xD;
              FROM [TenderApprovals] AS [t1]&#xD;
              WHERE [e].[Id] IS NOT NULL AND [e].[Id] = [t1].[EvaluationReportId] AND [t1].[Decision] LIKE N'Top Committee%')&#xD;
      END&#xD;
      FROM [Tenders] AS [t]&#xD;
      LEFT JOIN [EvaluationReports] AS [e] ON [t].[Id] = [e].[TenderId]&#xD;
      WHERE [t].[Title] LIKE N'Phase 6 %'&#xD;
      ORDER BY [t].[Id], [e].[Id]&#xD;
