      SELECT [p].[Id], [p].[Title], [d].[Name] AS [Department]&#xD;
      FROM [PurchaseRequisitions] AS [p]&#xD;
      INNER JOIN [Departments] AS [d] ON [p].[DepartmentId] = [d].[Id]&#xD;
      WHERE NOT EXISTS (&#xD;
          SELECT 1&#xD;
          FROM [Tenders] AS [t]&#xD;
          WHERE [p].[Id] = [t].[PurchaseRequisitionId] AND [t].[Status] &lt;&gt; N'Cancelled') AND ([p].[Status] = N'Approved' OR ([p].[Status] = N'Converted to Tender' AND (&#xD;
          SELECT TOP(1) [e].[Status]&#xD;
          FROM [Tenders] AS [t0]&#xD;
          LEFT JOIN [EvaluationReports] AS [e] ON [t0].[Id] = [e].[TenderId]&#xD;
          WHERE [p].[Id] = [t0].[PurchaseRequisitionId]&#xD;
          ORDER BY [t0].[Id] DESC) = N'Cancelled - Ready to Retender'))&#xD;
