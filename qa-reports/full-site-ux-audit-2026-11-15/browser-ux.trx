      LEFT JOIN [PurchaseRequisitionItems] AS [p0] ON [s].[Id] = [p0].[PurchaseRequisitionId]&#xD;
      LEFT JOIN (&#xD;
          SELECT [t].[Id], [t].[CloseDate], [t].[counter], [t].[CreatedAt], [t].[CreatedByEmployeeProfileId], [t].[Description], [t].[OpenDate], [t].[PurchaseRequisitionId], [t].[Status], [t].[Terms], [t].[Title], [e1].[Id] AS [Id0], [e1].[CreatedAt] AS [CreatedAt0], [e1].[FileKey], [e1].[FinalizedAt], [e1].[PreparedByEmployeeProfileId], [e1].[Recommendation], [e1].[RecommendedBidId], [e1].[ResultsSnapshot], [e1].[Status] AS [Status0], [e1].[Summary], [e1].[SupplierComparison], [e1].[TenderId]&#xD;
          FROM [Tenders] AS [t]&#xD;
