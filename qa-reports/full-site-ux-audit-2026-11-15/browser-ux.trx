      SELECT [p0].[Id], [p0].[Title] AS [Name], [d].[Name] AS [Context], [p0].[Status], [p0].[CreatedAt] AS [Date], NULL AS [TenderId]&#xD;
      FROM (&#xD;
          SELECT [p].[Id], [p].[CreatedAt], [p].[DepartmentId], [p].[Status], [p].[Title]&#xD;
