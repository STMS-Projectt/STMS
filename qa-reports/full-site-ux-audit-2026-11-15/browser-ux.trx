      SELECT [s].[Id], [s].[CategoryId], [s].[CreatedAt], [s].[CreatedByEmployeeProfileId], [s].[DepartmentId], [s].[Priority], [s].[Reason], [s].[ReviewNotes], [s].[ReviewedByEmployeeProfileId], [s].[Status], [s].[TargetDate], [s].[Title], [s].[Id0], [s].[Id1], [s].[Id2], [p0].[Id], [p0].[ItemName], [p0].[PurchaseRequisitionId], [p0].[Quantity], [p0].[Specifications], [p0].[Unit], [s].[Description], [s].[IsActive], [s].[Name], [s].[DepartmentId0], [s].[FullName], [s].[IsActive0], [s].[JobTitle], [s].[UserId], [s].[DepartmentId1], [s].[FullName0], [s].[IsActive1], [s].[JobTitle0], [s].[UserId0], [s0].[Id], [s0].[CloseDate], [s0].[counter], [s0].[CreatedAt], [s0].[CreatedByEmployeeProfileId], [s0].[Description], [s0].[OpenDate], [s0].[PurchaseRequisitionId], [s0].[Status], [s0].[Terms], [s0].[Title], [s0].[Id0], [s0].[CreatedAt0], [s0].[FileKey], [s0].[FinalizedAt], [s0].[PreparedByEmployeeProfileId], [s0].[Recommendation], [s0].[RecommendedBidId], [s0].[ResultsSnapshot], [s0].[Status0], [s0].[Summary], [s0].[SupplierComparison], [s0].[TenderId]&#xD;
      FROM (&#xD;
          SELECT TOP(2) [p].[Id], [p].[CategoryId], [p].[CreatedAt], [p].[CreatedByEmployeeProfileId], [p].[DepartmentId], [p].[Priority], [p].[Reason], [p].[ReviewNotes], [p].[ReviewedByEmployeeProfileId], [p].[Status], [p].[TargetDate], [p].[Title], [d].[Id] AS [Id0], [d].[Description], [d].[IsActive], [d].[Name], [e].[Id] AS [Id1], [e].[DepartmentId] AS [DepartmentId0], [e].[FullName], [e].[IsActive] AS [IsActive0], [e].[JobTitle], [e].[UserId], [e0].[Id] AS [Id2], [e0].[DepartmentId] AS [DepartmentId1], [e0].[FullName] AS [FullName0], [e0].[IsActive] AS [IsActive1], [e0].[JobTitle] AS [JobTitle0], [e0].[UserId] AS [UserId0]&#xD;
          FROM [PurchaseRequisitions] AS [p]&#xD;
          INNER JOIN [Departments] AS [d] ON [p].[DepartmentId] = [d].[Id]&#xD;
          INNER JOIN [EmployeeProfiles] AS [e] ON [p].[CreatedByEmployeeProfileId] = [e].[Id]&#xD;
          LEFT JOIN [EmployeeProfiles] AS [e0] ON [p].[ReviewedByEmployeeProfileId] = [e0].[Id]&#xD;
          WHERE [p].[Status] IN (N'Submitted', N'Under Review', N'Approved', N'Returned', N'Rejected', N'Converted to Tender') AND [p].[Id] = @id&#xD;
