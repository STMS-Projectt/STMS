      SELECT [p0].[Year], [p0].[Month], COUNT(*) AS [Count]&#xD;
      FROM (&#xD;
          SELECT DATEPART(year, [p].[CreatedAt]) AS [Year], DATEPART(month, [p].[CreatedAt]) AS [Month]&#xD;
          FROM [PurchaseRequisitions] AS [p]&#xD;
