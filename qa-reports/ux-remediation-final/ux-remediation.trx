      SELECT [t0].[Year], [t0].[Month], COUNT(*) AS [Count]&#xD;
      FROM (&#xD;
          SELECT DATEPART(year, [t].[CreatedAt]) AS [Year], DATEPART(month, [t].[CreatedAt]) AS [Month]&#xD;
          FROM [Tenders] AS [t]&#xD;
          WHERE [t].[CreatedAt] &gt;= @first AND [t].[CreatedAt] &lt; @end&#xD;
      ) AS [t0]&#xD;
      GROUP BY [t0].[Year], [t0].[Month]&#xD;
