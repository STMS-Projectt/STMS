      FROM (&#xD;
          SELECT TOP(2) [p].[Id], [p].[CategoryId], [p].[CreatedAt], [p].[CreatedByEmployeeProfileId], [p].[DepartmentId], [p].[Priority], [p].[Reason], [p].[ReviewNotes], [p].[ReviewedByEmployeeProfileId], [p].[Status], [p].[TargetDate], [p].[Title], [d].[Id] AS [Id0], [d].[Description], [d].[IsActive], [d].[Name], [e].[Id] AS [Id1], [e].[DepartmentId] AS [DepartmentId0], [e].[FullName], [e].[IsActive] AS [IsActive0], [e].[JobTitle], [e].[UserId], [e0].[Id] AS [Id2], [e0].[DepartmentId] AS [DepartmentId1], [e0].[FullName] AS [FullName0], [e0].[IsActive] AS [IsActive1], [e0].[JobTitle] AS [JobTitle0], [e0].[UserId] AS [UserId0]&#xD;
