      SELECT [s4].[Id], [s4].[AwardOutcome], [s4].[ComplianceClarificationId], [s4].[ComplianceNotes], [s4].[Currency], [s4].[DeliveryDays], [s4].[Status], [s4].[SubmittedAt], [s4].[SubmittedRoundNumber], [s4].[SupplierProfileId], [s4].[TenderId], [s4].[TotalPrice], [s4].[ValidityDays], [s4].[Id0], [s4].[Address], [s4].[ApplicationSubmittedAt], [s4].[CommercialRegNo], [s4].[CompanyName], [s4].[ContactPhone], [s4].[CreatedAt], [s4].[Status0], [s4].[StatusReason], [s4].[TaxNumber], [s4].[UserId], [s3].[Id], [s3].[Id0]&#xD;
      FROM (&#xD;
          SELECT TOP(1) [t].[Id], [e].[Id] AS [Id0]&#xD;
