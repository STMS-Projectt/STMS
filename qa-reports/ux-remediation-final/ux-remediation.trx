      ) AS [s3]&#xD;
      INNER JOIN (&#xD;
          SELECT [b].[Id], [b].[AwardOutcome], [b].[ComplianceClarificationId], [b].[ComplianceNotes], [b].[Currency], [b].[DeliveryDays], [b].[Status], [b].[SubmittedAt], [b].[SubmittedRoundNumber], [b].[SupplierProfileId], [b].[TenderId], [b].[TotalPrice], [b].[ValidityDays], [s].[Id] AS [Id0], [s].[Address], [s].[ApplicationSubmittedAt], [s].[CommercialRegNo], [s].[CompanyName], [s].[ContactPhone], [s].[CreatedAt], [s].[Status] AS [Status0], [s].[StatusReason], [s].[TaxNumber], [s].[UserId]&#xD;
          FROM [Bids] AS [b]&#xD;
          INNER JOIN [SupplierProfiles] AS [s] ON [b].[SupplierProfileId] = [s].[Id]&#xD;
          WHERE [b].[Status] = N'Compliant' AND [b].[SubmittedAt] IS NOT NULL&#xD;
