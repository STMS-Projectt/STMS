          LEFT JOIN [EvaluationReports] AS [e] ON [t].[Id] = [e].[TenderId]&#xD;
          WHERE ([t].[Status] = N'Under Evaluation' OR [e].[Id] IS NOT NULL) AND [e].[Id] IS NOT NULL AND [e].[Status] IN (N'Pending Top Committee', N'Awarded', N'Cancelled', N'Cancelled - Awaiting Manager Handoff', N'Cancelled - Ready to Retender') AND EXISTS (&#xD;
              SELECT 1&#xD;
              FROM [TenderCommitteeMembers] AS [t0]&#xD;
              WHERE [t].[Id] = [t0].[TenderId] AND [t0].[CommitteeType] = N'Top' AND [t0].[EmployeeProfileId] = @employeeId) AND [t].[Id] = @id&#xD;
