      Executed DbCommand (0ms) [Parameters=[@employeeId='?' (DbType = Int32), @id='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT TOP(2) [t].[Id], [t].[CloseDate], [t].[counter], [t].[CreatedAt], [t].[CreatedByEmployeeProfileId], [t].[Description], [t].[OpenDate], [t].[PurchaseRequisitionId], [t].[Status], [t].[Terms], [t].[Title], [e].[Id], [e].[CreatedAt], [e].[FileKey], [e].[FinalizedAt], [e].[PreparedByEmployeeProfileId], [e].[Recommendation], [e].[RecommendedBidId], [e].[ResultsSnapshot], [e].[Status], [e].[Summary], [e].[SupplierComparison], [e].[TenderId]&#xD;
      FROM [Tenders] AS [t]&#xD;
      LEFT JOIN [EvaluationReports] AS [e] ON [t].[Id] = [e].[TenderId]&#xD;
      WHERE ([t].[Status] = N'Under Evaluation' OR [e].[Id] IS NOT NULL) AND [e].[Id] IS NOT NULL AND [e].[Status] IN (N'Pending Top Committee', N'Awarded', N'Cancelled', N'Cancelled - Awaiting Manager Handoff', N'Cancelled - Ready to Retender') AND EXISTS (&#xD;
          SELECT 1&#xD;
          FROM [TenderCommitteeMembers] AS [t0]&#xD;
          WHERE [t].[Id] = [t0].[TenderId] AND [t0].[CommitteeType] = N'Top' AND [t0].[EmployeeProfileId] = @employeeId) AND [t].[Id] = @id&#xD;
      ORDER BY [t].[Id], [e].[Id]&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (0ms) [Parameters=[@employeeId='?' (DbType = Int32), @id='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT [s1].[Id], [s1].[CommitteeType], [s1].[EmployeeProfileId], [s1].[MemberRole], [s1].[TenderId], [s1].[Id0], [s1].[DepartmentId], [s1].[FullName], [s1].[IsActive], [s1].[JobTitle], [s1].[UserId], [s0].[Id], [s0].[Id0]&#xD;
      FROM (&#xD;
          SELECT TOP(1) [t].[Id], [e].[Id] AS [Id0]&#xD;
          FROM [Tenders] AS [t]&#xD;
          LEFT JOIN [EvaluationReports] AS [e] ON [t].[Id] = [e].[TenderId]&#xD;
          WHERE ([t].[Status] = N'Under Evaluation' OR [e].[Id] IS NOT NULL) AND [e].[Id] IS NOT NULL AND [e].[Status] IN (N'Pending Top Committee', N'Awarded', N'Cancelled', N'Cancelled - Awaiting Manager Handoff', N'Cancelled - Ready to Retender') AND EXISTS (&#xD;
              SELECT 1&#xD;
              FROM [TenderCommitteeMembers] AS [t0]&#xD;
              WHERE [t].[Id] = [t0].[TenderId] AND [t0].[CommitteeType] = N'Top' AND [t0].[EmployeeProfileId] = @employeeId) AND [t].[Id] = @id&#xD;
          ORDER BY [t].[Id], [e].[Id]&#xD;
      ) AS [s0]&#xD;
      INNER JOIN (&#xD;
          SELECT [t1].[Id], [t1].[CommitteeType], [t1].[EmployeeProfileId], [t1].[MemberRole], [t1].[TenderId], [e0].[Id] AS [Id0], [e0].[DepartmentId], [e0].[FullName], [e0].[IsActive], [e0].[JobTitle], [e0].[UserId]&#xD;
          FROM [TenderCommitteeMembers] AS [t1]&#xD;
          INNER JOIN [EmployeeProfiles] AS [e0] ON [t1].[EmployeeProfileId] = [e0].[Id]&#xD;
          WHERE [t1].[CommitteeType] IN (N'Evaluation', N'Top')&#xD;
      ) AS [s1] ON [s0].[Id] = [s1].[TenderId]&#xD;
