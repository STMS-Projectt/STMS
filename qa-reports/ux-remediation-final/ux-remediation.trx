              SELECT 1&#xD;
              FROM [TenderCommitteeMembers] AS [t0]&#xD;
              WHERE [t].[Id] = [t0].[TenderId] AND [t0].[CommitteeType] = N'Top' AND [t0].[EmployeeProfileId] = @employeeId) AND [t].[Id] = @id&#xD;
          ORDER BY [t].[Id], [e].[Id]&#xD;
      ) AS [s5]&#xD;
