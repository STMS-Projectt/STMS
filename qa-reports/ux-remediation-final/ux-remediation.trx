      SELECT [p0].[Id], [p0].[Title], [d].[Name], [p0].[Priority], [p0].[Status], [p0].[TargetDate]&#xD;
      FROM (&#xD;
          SELECT TOP(@p) [p].[Id], [p].[CreatedAt], [p].[DepartmentId], [p].[Priority], [p].[Status], [p].[TargetDate], [p].[Title], CASE&#xD;
              WHEN [p].[Priority] = N'Urgent' THEN 3&#xD;
              WHEN [p].[Priority] = N'High' THEN 2&#xD;
              WHEN [p].[Priority] = N'Normal' THEN 1&#xD;
              ELSE 0&#xD;
          END AS [c]&#xD;
          FROM [PurchaseRequisitions] AS [p]&#xD;
          WHERE [p].[Status] IN (N'Submitted', N'Under Review')&#xD;
          ORDER BY CASE&#xD;
              WHEN [p].[Priority] = N'Urgent' THEN 3&#xD;
              WHEN [p].[Priority] = N'High' THEN 2&#xD;
              WHEN [p].[Priority] = N'Normal' THEN 1&#xD;
              ELSE 0&#xD;
          END DESC, [p].[TargetDate], [p].[CreatedAt], [p].[Id]&#xD;
      ) AS [p0]&#xD;
      INNER JOIN [Departments] AS [d] ON [p0].[DepartmentId] = [d].[Id]&#xD;
      ORDER BY [p0].[c] DESC, [p0].[TargetDate], [p0].[CreatedAt], [p0].[Id]&#xD;
