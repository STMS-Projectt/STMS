      SELECT [s].[Id], [s].[AwardOutcome], [s].[ComplianceClarificationId], [s].[ComplianceNotes], [s].[Currency], [s].[DeliveryDays], [s].[Status], [s].[SubmittedAt], [s].[SubmittedRoundNumber], [s].[SupplierProfileId], [s].[TenderId], [s].[TotalPrice], [s].[ValidityDays], [s].[Id0], [s].[CloseDate], [s].[counter], [s].[CreatedAt], [s].[CreatedByEmployeeProfileId], [s].[Description], [s].[OpenDate], [s].[PurchaseRequisitionId], [s].[Status0], [s].[Terms], [s].[Title], [b0].[Id], [b0].[BidId], [b0].[Notes], [b0].[PurchaseRequisitionItemId], [b0].[Quantity], [b0].[UnitPrice], [b1].[Id], [b1].[BidId], [b1].[DocumentType], [b1].[FileName], [b1].[FilePath], [b1].[UploadedAt]&#xD;
      FROM (&#xD;
          SELECT TOP(1) [b].[Id], [b].[AwardOutcome], [b].[ComplianceClarificationId], [b].[ComplianceNotes], [b].[Currency], [b].[DeliveryDays], [b].[Status], [b].[SubmittedAt], [b].[SubmittedRoundNumber], [b].[SupplierProfileId], [b].[TenderId], [b].[TotalPrice], [b].[ValidityDays], [t].[Id] AS [Id0], [t].[CloseDate], [t].[counter], [t].[CreatedAt], [t].[CreatedByEmployeeProfileId], [t].[Description], [t].[OpenDate], [t].[PurchaseRequisitionId], [t].[Status] AS [Status0], [t].[Terms], [t].[Title]&#xD;
