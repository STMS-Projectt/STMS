@model SupplierProfile
@{ ViewData["Title"] = "Supplier details"; }
<h1>@ViewData["Title"]</h1>
<dl class="row">
    <dt class="col-sm-4">Company</dt><dd class="col-sm-8">@Model.CompanyName</dd>
    <dt class="col-sm-4">Tax number</dt><dd class="col-sm-8">@Model.TaxNumber</dd>
    <dt class="col-sm-4">Commercial registration</dt><dd class="col-sm-8">@Model.CommercialRegNo</dd>
    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.User.Email</dd>
    <dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@Model.ContactPhone</dd>
    <dt class="col-sm-4">Address</dt><dd class="col-sm-8">@Model.Address</dd>
    <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Model.Status</dd>
    <dt class="col-sm-4">Decision reason</dt><dd class="col-sm-8">@(Model.StatusReason ?? "—")</dd>
</dl>
<partial name="_SupplierDocuments" model="Model.SupplierDocuments" />
<div class="d-flex flex-wrap gap-2">
    @if ((Model.Status is SupplierStatus.Pending or SupplierStatus.Suspended) && Model.SupplierDocuments.Count > 0)
    {
        <a class="btn btn-success" asp-action="Approve" asp-route-id="@Model.Id">Approve</a>
    }
    @if (Model.Status == SupplierStatus.Pending)
    {
        <a class="btn btn-outline-danger" asp-action="Reject" asp-route-id="@Model.Id">Reject</a>
    }
    @if (Model.Status == SupplierStatus.Approved)
    {
        <a class="btn btn-outline-danger" asp-action="Suspend" asp-route-id="@Model.Id">Suspend</a>
    }
    <a class="btn btn-outline-secondary" asp-action="Index">Back to suppliers</a>
</div>
