@model SupplierProfile
@{
    var panel = Context.Request.Query["panel"].ToString();
    ViewData["Title"] = panel == "documents" ? "Supplier documents" : "Supplier details";
}
<a class="back-link" asp-action="Index"><partial name="_Icon" model='@("back")' /> @L.T("Suppliers")</a>
<header class="page-heading stms-hero admin-record-hero"><div><p class="eyebrow">@L.T("SUPPLIER APPLICATION")</p><h1>@(panel == "documents" ? "Supplier documents" : Model.CompanyName)</h1><p>@(panel == "documents" ? Model.CompanyName : $"Registered {Model.CreatedAt:dd MMM yyyy} (UTC)")</p></div><partial name="_Status" model="Model.Status" /></header>
@if (panel == "documents")
{
    <partial name="_SupplierDocuments" model="Model.SupplierDocuments" />
    @if (User.IsInRole("SourcingOfficer") && Model.Status is (SupplierStatus.Pending or SupplierStatus.Approved or SupplierStatus.Suspended))
    {
        <div class="record-panel-actions"><a data-workspace-dialog class="btn btn-outline-secondary" asp-controller="Clarifications" asp-action="Create" asp-route-kind="supplier" asp-route-recordId="@Model.Id"><partial name="_Icon" model='@("mail")' /> @L.T("Request a document")</a></div>
    }
}
else
{
<div class="form-shell">
    <div class="stack">
        <section class="surface detail-card"><h2>@L.T("Company information")</h2>
            <dl class="detail-grid">
                <div><dt>@L.T("Tax number")</dt><dd>@Model.TaxNumber</dd></div>
                <div><dt>@L.T("Commercial registration")</dt><dd>@Model.CommercialRegNo</dd></div>
                <div><dt>@L.T("Email")</dt><dd>@Model.User.Email</dd></div>
                <div><dt>@L.T("Phone")</dt><dd>@Model.ContactPhone</dd></div>
                <div><dt>@L.T("Address")</dt><dd>@Model.Address</dd></div>
                <div><dt>@L.T("Supply categories")</dt><dd>@(Model.Categories.Count == 0 ? "Unassigned" : string.Join(", ", Model.Categories.OrderBy(c => c.Name).Select(c => c.Name)))</dd></div>
            </dl>
            @if (User.IsInRole("Admin")) { <a data-workspace-dialog class="btn btn-outline-secondary mt-3" asp-action="Categories" asp-route-id="@Model.Id">@L.T("Edit categories")</a> }
        </section>
        @if (panel != "overview") { <partial name="_SupplierDocuments" model="Model.SupplierDocuments" /> }
    </div>
    <aside class="surface helper-card">
        <span class="icon-tile tone-teal"><partial name="_Icon" model='@("shield")' /></span>
        <h2>@L.T("Review decision")</h2>
        @if (Model.StatusReason is not null) { <p>@Model.StatusReason</p> }
        @if (Model.Status == SupplierStatus.Pending && Model.SupplierDocuments.Count == 0)
        { <div class="callout callout-warning">@L.T("Approval becomes available after the supplier uploads a document.")</div> }
        else if (Model.Status == SupplierStatus.Pending)
        { <p>@L.T("Review the company information and documents before making a decision.")</p> }
        <div class="button-row">
            @if ((Model.Status is SupplierStatus.Pending or SupplierStatus.Suspended) && Model.SupplierDocuments.Count > 0)
            { <a data-workspace-dialog class="btn btn-primary" asp-action="Approve" asp-route-id="@Model.Id"><partial name="_Icon" model='@("check")' /> @(Model.Status == SupplierStatus.Suspended ? "Activate" : "Approve")</a> }
            @if (User.IsInRole("Admin") && Model.Status == SupplierStatus.Pending)
            { <a data-workspace-dialog class="btn btn-outline-danger" asp-action="Reject" asp-route-id="@Model.Id">@L.T("Reject")</a> }
            @if (User.IsInRole("Admin") && Model.Status == SupplierStatus.Approved)
            { <a data-workspace-dialog class="btn btn-outline-danger" asp-action="Suspend" asp-route-id="@Model.Id">@L.T("Suspend")</a> }
        </div>
    </aside>
</div>
}
