@model IReadOnlyList<SupplierProfile>
@{ ViewData["Title"] = "Suppliers"; }
<h1>Suppliers</h1>
<form method="get" class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <label for="status">Status</label>
    <select id="status" name="status" class="form-select w-auto">
        <option value="">All statuses</option>
        @foreach (var status in SupplierStatus.All) { <option value="@status" selected="@(ViewBag.Status == status)">@status</option> }
    </select>
    <button class="btn btn-outline-primary" type="submit">Filter</button>
</form>
@if (Model.Count == 0)
{
    <p class="text-muted">No records found.</p>
}
else
{
    <div class="table-responsive"><table class="table table-striped align-middle">
        <thead><tr><th scope="col">Company</th><th scope="col">Tax number</th><th scope="col">Status</th><th scope="col">Registered (UTC)</th><th scope="col">Actions</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr><td>@item.CompanyName</td><td>@item.TaxNumber</td><td>@item.Status</td><td>@item.CreatedAt.ToString("yyyy-MM-dd")</td><td><a asp-action="Details" asp-route-id="@item.Id">Details</a></td></tr>
        }
        </tbody>
    </table></div>
}
