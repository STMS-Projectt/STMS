@model IReadOnlyList<SupplierProfile>
@{ ViewData["Title"] = "Suppliers"; }
<header class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>Suppliers</h1><p>Review company registrations and supporting documents.</p></div></header>
<section class="surface directory" aria-label="Suppliers directory" data-directory>
    <div class="directory-toolbar">
    @* Voice search trial on the Admin Suppliers page. *@
    <div class="d-flex align-items-center gap-2" hidden="@(Model.Count == 0)">
        <label class="search-box"><partial name="_Icon" model='@("search")' /><span class="visually-hidden">Search companies or tax numbers</span><input class="form-control" type="search" data-filter-search placeholder="Search companies or tax numbers"></label>
        <button type="button" class="btn btn-outline-secondary" data-directory-voice-search aria-label="Search by voice" title="Search by voice">🎤</button>
    </div>
    <span class="result-count" data-result-count aria-live="polite">@Model.Count records</span>
</div><nav class="filter-tabs" aria-label="Filter suppliers by status">
    <a asp-action="Index" aria-current="@(string.IsNullOrEmpty((string?)ViewBag.Status) ? "page" : null)">All statuses</a>
    @foreach (var status in SupplierStatus.All)
    {
        <a asp-action="Index" asp-route-status="@status" aria-current="@(ViewBag.Status == status ? "page" : null)">@status</a>
    }
</nav>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("supplier")' /></span><h2>No supplier applications</h2><p>Applications matching this status will appear here.</p></div>
    }
    else
    {
        <table class="directory-table" role="table">
            <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Company</th><th scope="col" role="columnheader">Tax number</th><th scope="col" role="columnheader">Status</th><th scope="col" role="columnheader">Registered (UTC)</th><th scope="col" role="columnheader">Actions</th></tr></thead>
            <tbody role="rowgroup">
            @foreach (var item in Model)
            {
                <tr role="row">
                    <td role="cell"><div class="record-name"><span class="avatar"><partial name="_Icon" model='@("supplier")' /></span><span>@item.CompanyName</span></div></td>
                    <td role="cell" data-label="Tax number">@item.TaxNumber</td>
                    <td role="cell" data-label="Status"><partial name="_Status" model='@(item.Status)' /></td>
                    <td role="cell" data-label="Registered (UTC)">@item.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td role="cell" data-label="Actions"><a class="table-action" asp-action="Details" asp-route-id="@item.Id">Open application <partial name="_Icon" model='@("arrow")' /><span class="visually-hidden"> for @item.CompanyName</span></a></td>
                </tr>
            }
            </tbody>
        </table>
        <div data-filter-empty hidden><div class="empty-state"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("search")' /></span><h2>No matching records</h2><p>Try a different name or clear your search.</p><button type="button" class="btn btn-outline-secondary">Clear search</button></div></div>
    }
</section>

@section Scripts {
    <script src="~/js/admin-directory-voice-search.js" asp-append-version="true"></script>
}
