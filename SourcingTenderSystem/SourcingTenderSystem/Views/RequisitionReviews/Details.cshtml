@model RequisitionReviewInput
@{ ViewData["Title"] = "Review purchase request"; var request = (PurchaseRequisition)ViewBag.Request; }
<h1>Review request #@request.Id</h1>
<partial name="_RequisitionSummary" model="request" />
<partial name="_RequisitionItems" model="request.Items" />
@if (request.Status == "Submitted" || request.Status == "Under Review")
{
    <form asp-action="Approve" asp-route-id="@request.Id" method="post" class="mb-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
        <p class="form-text">Enter notes explaining your decision. Return allows the employee to edit and resubmit.</p>
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-success" asp-action="Approve" asp-route-id="@request.Id">Approve</button>
            <button type="submit" class="btn btn-primary" asp-action="ApproveAndCreateTender" asp-route-id="@request.Id">Approve and create tender</button>
            <button type="submit" class="btn btn-warning" asp-action="Return" asp-route-id="@request.Id">Return for changes</button>
            <button type="submit" class="btn btn-danger" asp-action="Reject" asp-route-id="@request.Id">Reject</button>
        </div>
    </form>
}
@if (TenderRules.CanCreate(request))
{
    <div class="mb-3"><a data-workspace-dialog class="btn btn-primary" asp-controller="Tenders" asp-action="Create" asp-route-purchaseRequisitionId="@request.Id">Create tender</a></div>
}
@if (request.Tenders.Count > 0)
{
    <partial name="_TenderHistory" model="request.Tenders" />
}
<a asp-action="Pending">Back to pending requests</a>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

<div class="mb-3"><a class="btn btn-outline-secondary" asp-controller="Clarifications" asp-action="Index" asp-route-kind="request" asp-route-recordId="@request.Id">Clarification history</a></div>

<partial name="_RecordQr" model='@(Url.Action("Details", new { id = request.Id })!)' />
