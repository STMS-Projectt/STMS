@model RequisitionReviewInput
@{
    var request = (PurchaseRequisition)ViewBag.Request;
    ViewData["Title"] = "Review purchase request";
    var pending = request.Status is "Submitted" or "Under Review";
    var items = request.Items.OrderBy(i => i.Id).ToList();
    var daysLeft = (request.TargetDate.Date - DateTime.Today).Days;
    var priorityTone = request.Priority switch { "Low" => "low", "High" => "high", "Urgent" => "urgent", _ => "normal" };
}
<div class="pr-create prd rv">
<a class="back-link" asp-action="Pending"><partial name="_Icon" model='@("back")' /> @L.T("Back to pending requests")</a>

<header class="pr-hero prd-hero">
    <span class="pr-hero-icon"><partial name="_Icon" model='@("file")' /></span>
    <div>
        <p class="eyebrow">@L.F("Purchase request · PR-{0}", request.Id)</p>
        <h1>@request.Title</h1>
        <p class="prd-meta">
            <span><partial name="_Icon" model='@("building")' /> @request.Department.Name</span>
            <span><partial name="_Icon" model='@("users")' /> @request.CreatedByEmployeeProfile.FullName</span>
        </p>
    </div>
    <div class="prd-status"><partial name="_Status" model="request.Status" /></div>
</header>

<div class="prd-layout">
<div class="prd-main">
    @* ---------- Overview ---------- *@
    <section class="pr-card prd-card">
        <div class="prd-card-head">
            <div class="pr-section-head mb-0"><span class="pr-badge"><partial name="_Icon" model='@("dashboard")' /></span><div><h2>@L.T("Request overview")</h2><p>@L.T("Review the purpose and delivery requirements.")</p></div></div>
        </div>
        <div class="prd-stats">
            <div class="prd-stat"><span>@L.T("Priority")</span><strong><span class="prd-priority pr-@priorityTone"><i></i>@L.T(request.Priority)</span></strong></div>
            <div class="prd-stat">
                <span>@L.T("Target date")</span>
                <strong>@request.TargetDate.ToString("dd MMM yyyy", L.DisplayCulture)</strong>
                <small class="@(daysLeft < 0 ? "is-late" : "")">@(daysLeft >= 0 ? L.F("{0} days left", daysLeft) : L.T("Past due"))</small>
            </div>
            <div class="prd-stat"><span>@L.T("Created (UTC)")</span><strong>@request.CreatedAt.ToString("dd MMM yyyy", L.DisplayCulture)</strong><small>@request.CreatedAt.ToString("HH:mm")</small></div>
            <div class="prd-stat"><span>@L.T("Assigned reviewer")</span><strong class="rv-reviewer">@(request.ReviewedByEmployeeProfile?.FullName ?? L.T("Unassigned"))</strong></div>
        </div>
        <div class="prd-reason">
            <h3>@L.T("Reason for purchase")</h3>
            <p class="request-prose mb-0">@request.Reason</p>
        </div>
        @if (!string.IsNullOrWhiteSpace(request.ReviewNotes))
        {
            <div class="prd-note mt-3 mb-0"><span class="pr-badge"><partial name="_Icon" model='@("mail")' /></span><div><h2>@L.T("Latest review notes")</h2><p class="request-prose mb-0">@request.ReviewNotes</p></div></div>
        }
    </section>

    @* ---------- Items ---------- *@
    <section class="pr-card prd-card">
        <div class="prd-card-head">
            <div class="pr-section-head mb-0"><span class="pr-badge"><partial name="_Icon" model='@("briefcase")' /></span><div><h2>@L.T("Requested items")</h2><p>@L.T("Quantities and specifications for review.")</p></div></div>
            <span class="pr-count">@items.Count</span>
        </div>
        @if (items.Count == 0)
        {
            <div class="prd-empty"><span class="pr-badge"><partial name="_Icon" model='@("inbox")' /></span><h3>@L.T("No items were included in this request.")</h3></div>
        }
        else
        {
            <ol class="prd-items">
                @for (var i = 0; i < items.Count; i++)
                {
                    var item = items[i];
                    <li class="prd-item rv-item">
                        <span class="pr-item-no">@(i + 1)</span>
                        <div class="prd-item-body">
                            <h3>@item.ItemName</h3>
                            <p class="request-prose">@(string.IsNullOrWhiteSpace(item.Specifications) ? L.T("No specifications provided.") : item.Specifications)</p>
                        </div>
                        <span class="prd-qty">@item.Quantity <small>@L.T(item.Unit)</small></span>
                    </li>
                }
            </ol>
        }
    </section>
    <partial name="_TenderHistory" model="request.Tenders" />
</div>

<aside class="prd-side">
    @if (pending)
    {
        @* ---------- Decision ---------- *@
        <form asp-action="Approve" asp-route-id="@request.Id" method="post" class="rv-decision">
            <div class="pr-section-head"><span class="pr-badge"><partial name="_Icon" model='@("check")' /></span><div><h2>@L.T("Review decision")</h2><p>@L.T("Explain the decision before choosing an action.")</p></div></div>
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <label asp-for="Notes" class="form-label">@L.T("Review notes")</label>
            <textarea asp-for="Notes" class="form-control" rows="4" placeholder="@L.T("Explain the reason for your decision...")" aria-describedby="review-notes-help"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
            <p id="review-notes-help" class="rv-hint">@L.T("Your notes appear on the request and in the employee’s notification. Explain the required changes before returning it.")</p>

            <div class="rv-actions" aria-label="@L.T("Approval options")">
                <button type="submit" class="btn btn-primary rv-main" asp-action="ApproveAndCreateTender" asp-route-id="@request.Id"><partial name="_Icon" model='@("plus")' /> @L.T("Approve and create tender")</button>
                <button type="submit" class="btn rv-approve" asp-action="Approve" asp-route-id="@request.Id"><partial name="_Icon" model='@("check")' /> @L.T("Approve only")</button>
            </div>
            <div class="rv-divider"><span>@L.T("Return or reject")</span></div>
            <div class="rv-actions rv-actions-2" aria-label="@L.T("Return or reject")">
                <button type="submit" class="btn rv-return" asp-action="Return" asp-route-id="@request.Id"><partial name="_Icon" model='@("back")' /> @L.T("Return for changes")</button>
                <button type="submit" class="btn rv-reject" asp-action="Reject" asp-route-id="@request.Id"><partial name="_Icon" model='@("close")' /> @L.T("Reject")</button>
            </div>
        </form>
    }
    else if (TenderRules.CanCreate(request))
    {
        <div class="prd-submit">
            <span class="pr-badge"><partial name="_Icon" model='@("briefcase")' /></span>
            <h2>@L.T("Next step")</h2>
            <p>@L.T("Create a draft tender for this request.")</p>
            <a data-workspace-dialog class="btn btn-primary pr-submit w-100 justify-content-center" asp-controller="Tenders" asp-action="Create" asp-route-purchaseRequisitionId="@request.Id"><partial name="_Icon" model='@("plus")' /> @L.T("Create tender")</a>
        </div>
    }

    <div class="prd-links">
        <h2>@L.T("Clarifications")</h2>
        <a data-workspace-page class="prd-link" asp-controller="Clarifications" asp-action="StartRequest" asp-route-id="@request.Id"><partial name="_Icon" model='@("mail")' /> @L.T("Start a clarification")</a>
        <a data-workspace-page class="prd-link" asp-controller="Clarifications" asp-action="Index" asp-route-kind="request" asp-route-recordId="@request.Id"><partial name="_Icon" model='@("clock")' /> @L.T("View history")</a>
        @if (request.ReviewedByEmployeeProfileId == null && pending)
        {
            <form asp-controller="Clarifications" asp-action="ClaimRequest" asp-route-id="@request.Id" method="post"><button class="prd-link rv-claim" type="submit"><partial name="_Icon" model='@("users")' /> @L.T("Take review")</button></form>
        }
    </div>
</aside>
</div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
