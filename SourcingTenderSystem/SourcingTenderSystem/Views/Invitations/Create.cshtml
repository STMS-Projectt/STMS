@model Invitation
@{
    ViewData["Title"] = "New supplier invitation";
    var suppliers = (IReadOnlyList<SupplierProfile>)ViewData["Suppliers"]!;
    var selected = (HashSet<int>)ViewData["SelectedSuppliers"]!;
}
<a class="back-link" asp-action="Index"><partial name="_Icon" model='@("back")' /> Supplier invitations</a>
<header class="page-heading"><div><p class="eyebrow">SUPPLIER INVITATIONS</p><h1>New invitation</h1><p>Choose a tender, its suppliers, and the invitation expiry date.</p></div></header>
<div class="form-shell">
    <form class="surface form-card" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="TenderId" class="form-label">Tender</label>
            <select asp-for="TenderId" class="form-select" asp-items="ViewBag.TenderId" required><option value="">Select a tender</option></select>
            <span asp-validation-for="TenderId" class="text-danger"></span>
        </div>
        <fieldset class="mb-3">
            <legend class="form-label">Approved suppliers</legend>
            @if (suppliers.Count == 0)
            {
                <p class="subtle mb-0">No approved suppliers are available. Ask an administrator to approve a supplier account.</p>
            }
            else
            {
                <div class="border rounded p-3 overflow-auto" style="max-height: 16rem">
                    @foreach (var supplier in suppliers)
                    {
                        <label class="form-check">
                            <input class="form-check-input" type="checkbox" name="selectedSuppliers" value="@supplier.Id" checked="@selected.Contains(supplier.Id)" />
                            <span class="form-check-label">@supplier.CompanyName</span>
                        </label>
                    }
                </div>
            }
        </fieldset>
        <div class="mb-3">
            <label asp-for="ExpiresAt" class="form-label">Expires at (UTC)</label>
            <input asp-for="ExpiresAt" class="form-control" required />
            <span asp-validation-for="ExpiresAt" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary" disabled="@(suppliers.Count == 0)">Send invitations</button>
    </form>
</div>
