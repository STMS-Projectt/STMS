@model IEnumerable<SourcingTenderSystem.Models.Invitation>

@{
    ViewData["Title"] = "Supplier invitations";
}

<h1>Supplier invitations</h1>
@if (ViewData["TenderTitle"] is string tenderTitle)
{
    <p class="subtle">Invitations for <strong>@tenderTitle</strong> · <a asp-action="Index">Show all invitations</a></p>
}

<p>
    <a data-workspace-dialog class="btn btn-primary" asp-action="Create" asp-route-tenderId="@(Context.Request.Query["tenderId"].ToString())">New invitation</a>
</p>
<section class="surface directory dept-directory" data-directory>
<partial name="_ListFilters" model='@("Search invitations", Model.Select(i => i.Status))' />
<div class="table-responsive"><table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Tender)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SupplierProfile.CompanyName)
            </th>  
            
            <th>
                @Html.DisplayNameFor(model => model.SentAt)
            </th>
           
            <th>
                @Html.DisplayNameFor(model => model.ExpiresAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DeclineReason)
            </th>
            <th>
                Action
            </th>

            <th>Round</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr data-status="@item.Status">
            <td>
                    @Html.DisplayFor(model => item.Tender.Title)
            </td>
            <td>
                    @Html.DisplayFor(model => item.SupplierProfile.CompanyName)
            </td>
           
            <td>
                @Html.DisplayFor(model => item.SentAt)
            </td>
            <td>
                @Html.DisplayFor(model => item.ExpiresAt)
            </td>
          @* <td>
                @Html.DisplayFor(model => item.RespondedAt)
               </td>*@
                <td>
                    @Html.DisplayFor(model => item.Status)
                </td>
            <td>
                @Html.DisplayFor(model => item.DeclineReason)
            </td>
          
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a>
            </td>
            <td>@(item.RoundNumber?.ToString() ?? "Legacy · unknown")</td>
        </tr>
}
    </tbody>
</table></div>
<partial name="_ListFilterEmpty" />
</section>
