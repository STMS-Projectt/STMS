@model IEnumerable<Invitation>
@{
    ViewData["Title"] = "Supplier invitations";
    var rows = Model.ToList();
}
<header class="page-heading stms-hero admin-record-hero"><div><p class="eyebrow">SUPPLIER OUTREACH</p><h1>Supplier invitations</h1><p>@(ViewData["TenderTitle"] as string ?? "Track invitations and supplier responses.")</p></div>
    <div class="button-row">
        @if (ViewData["TenderTitle"] is string) { <a class="btn btn-outline-secondary" asp-action="Index">Show all</a> }
        @if (ViewData["CanInvite"] is not false)
        {
            <a data-workspace-dialog class="btn btn-primary" asp-action="Create" asp-route-tenderId="@(Context.Request.Query["tenderId"].ToString())"><partial name="_Icon" model='@("plus")' /> New invitation</a>
        }
    </div>
</header>
<section class="surface directory dept-directory" data-directory aria-label="Supplier invitations">
    <div class="dept-directory-heading"><h2>Invitation register</h2><p>Search by supplier, tender, or response.</p></div>
    @if (rows.Count == 0) { <div class="empty-state"><h2>No invitations yet</h2></div> }
    else
    {
        <partial name="_ListFilters" model='@("Search invitations", rows.Select(i => i.Status))' />
        <partial name="_DirectoryPages" model='@("Invitation pages")' />
        <div class="record-list" data-record-list>
        @foreach (var row in rows)
        {
            <article class="record-card" data-record data-status="@row.Status">
                <div class="record-name"><span class="avatar"><partial name="_Icon" model='@("mail")' /></span><span>@row.SupplierProfile.CompanyName<small>@row.Tender.Title · Invitation #@row.Id</small></span></div>
                <dl class="record-facts"><div><dt>Round</dt><dd>@(row.RoundNumber?.ToString() ?? "Legacy")</dd></div><div><dt>Status</dt><dd><partial name="_Status" model="row.Status" /></dd></div><div><dt>Sent (UTC)</dt><dd>@row.SentAt.ToString("dd MMM yyyy HH:mm")</dd></div><div><dt>Expires (UTC)</dt><dd>@row.ExpiresAt.ToString("dd MMM yyyy HH:mm")</dd></div></dl>
                <div class="record-action"><a class="record-icon-action" data-workspace-dialog="details" asp-action="Details" asp-route-id="@row.Id" aria-label="View invitation @row.Id" data-tooltip="View invitation"><partial name="_Icon" model='@("eye")' /></a></div>
            </article>
        }
        </div>
        <partial name="_ListFilterEmpty" />
    }
</section>
