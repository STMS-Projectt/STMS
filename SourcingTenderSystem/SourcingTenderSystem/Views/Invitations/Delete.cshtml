@model Invitation

@{
    ViewData["Title"] = L.T("Delete");
}

<h1>@L.T("Delete")</h1>

<h3>@L.T("Are you sure you want to delete this?")</h3>
<div>
    <h4>@L.T("Invitation")</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TenderId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TenderId)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SupplierProfileId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SupplierProfileId)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SentAt)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SentAt)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ExpiresAt)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ExpiresAt)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RespondedAt)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RespondedAt)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DeclineReason)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DeclineReason)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Tender)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Tender)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SupplierProfile)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SupplierProfile)
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">@L.T("Back to List")</a>
    </form>
</div>
