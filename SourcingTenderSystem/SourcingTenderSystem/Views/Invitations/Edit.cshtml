@model SourcingTenderSystem.Models.Invitation

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Invitation</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="TenderId" class="control-label  fw-bold"> Tender</label>
                <select asp-for="TenderId" class="form-control" asp-items="ViewBag.TenderId">
                    <option value="">-- Select Tender --</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label class="control-label fw-bold">Suppliers:</label>
                <div class="dropdown">
                    <!--  dropdown -->
                    <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start d-flex justify-content-between align-items-center" type="button" id="supplierDropdownButton" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                        <span id="dropdownButtonText">-- Select Suppliers --</span>
                    </button>

                    <!--  Checkboxes -->
                    <ul class="dropdown-menu w-100 p-3 shadow" aria-labelledby="supplierDropdownButton" style="max-height: 220px; overflow-y: auto;">
                        @if (ViewBag.Suppliers != null)
                        {
                            foreach (var supplier in ViewBag.Suppliers)
                            {
                                <li class="mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input supplier-checkbox" type="checkbox" name="selectedSuppliers" value="@supplier.Id" id="supplier_@supplier.Id" data-name="@supplier.CompanyName">
                                        <label class="form-check-label" for="supplier_@supplier.Id">
                                            @supplier.CompanyName
                                        </label>
                                    </div>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="dropdown-item text-muted">No suppliers available</li>
                        }
                    </ul>
                </div>
            </div>
            @* <div class="form-group">
                <label asp-for="SentAt" class="control-label"></label>
                <input asp-for="SentAt" class="form-control" />
                <span asp-validation-for="SentAt" class="text-danger"></span>
            </div>
            *@


            <div class="form-group">
                <label asp-for="ExpiresAt" class="control-label  fw-bold"> Expires Date</label>
                <input asp-for="ExpiresAt" class="form-control" />
                <span asp-validation-for="ExpiresAt" class="text-danger"></span>
            </div>

            @* <div class="form-group">
                <label asp-for="RespondedAt" class="control-label"></label>
                <input asp-for="RespondedAt" class="form-control" />
                <span asp-validation-for="RespondedAt" class="text-danger"></span>
            </div> *@

       

          
            @*  <div class="form-group">
                <label asp-for="SupplierProfile" class="control-label"></label>
                <input asp-for="SupplierProfile" class="form-control" />
                <span asp-validation-for="SupplierProfile" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>*@

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
