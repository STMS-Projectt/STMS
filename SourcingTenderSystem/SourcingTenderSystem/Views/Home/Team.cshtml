@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111e33" />
    <partial name="_BrandHead" />
    <title>@L.T("Development team") · STMS</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;600;700;850&amp;family=Space+Mono:wght@@400;700&amp;display=swap" />
    <link rel="stylesheet" href="~/team/team.css" asp-append-version="true" />
</head>
<body>
<noscript><p class="team-noscript"><a asp-action="Index">@L.T("Home")</a> · @L.T("Enable JavaScript to explore the development team.")</p></noscript>
<div class="viewport-fixed">
  <!-- Woven Canvas & Vignette -->
  <div class="textile-canvas-bg" aria-hidden="true"></div>
  <div class="backdrop-vignette" aria-hidden="true"></div>

  <!-- Header -->
  <header class="topbar">
    <a class="brand" asp-controller="Home" asp-action="Index">
      <partial name="_BrandIcon" />
      <span>STMS · <em lang="@L.Language">@L.T("Home")</em></span>
    </a>
    <div class="sewing-indicator-tag">
      <span class="stitch-pulse-dot"></span>
      <span id="needleStatus">Tailoring Needle Active</span>
    </div>
  </header>

  <!-- Title (Dissolves as you dive in) -->
  <section class="intro-text" id="introText">
    <p class="eyebrow">Seven Faces · Woven into One</p>
    <h1>The people <span>stitched together.</span></h1>
  </section>

  <!-- 3D Scene Viewport -->
  <main class="scene-3d" id="scene3d">
    <!-- STAGE 1: Orbit Ring -->
    <div class="orbit-world" id="orbitWorld">
      <div class="portal-rings">
        <div class="embroidery-ring ring-outer"></div>
        <div class="embroidery-ring ring-inner"></div>
      </div>
      <div id="cluster"></div>
    </div>

    <!-- STAGE 2: Stitched Spotlight Stage (تُخاط غرزة بغرزة أمام المستخدم) -->
    <section class="stitched-stage" id="stitchedStage" aria-live="polite">
      <div class="label-card" id="labelCard">
        <canvas id="cardWeaveCanvas" aria-hidden="true"></canvas>
        <!-- Live SVG Tailor Stitch Border -->
        <svg class="svg-stitch-frame" id="svgStitchFrame" preserveAspectRatio="none">
          <rect id="stitchBorderRect" class="stitch-border-path" x="6" y="6" width="98%" height="98%" rx="16" />
        </svg>

        <!-- Moving Needle and Thread on Card -->
        <div class="sewing-needle-cursor" id="sewingNeedle">
          <div class="needle-eye"></div>
          <div class="needle-blade"></div>
          <div class="needle-thread-line"></div>
        </div>

        <!-- Left: Photo Weaving Box -->
        <div class="portrait-weaving-box">
          <div class="portrait-cutout-wrapper">
            <img id="spotlightImg" alt="Specialist portrait" />
            <canvas id="embroideredPortrait" aria-label="Portrait embroidered stitch by stitch"></canvas>
            <div class="weft-warp-scanner"></div>
            <div class="sewing-scanline" id="sewingScanline"></div>
            <span class="initials" id="spotlightInitials"></span>
          </div>

          <div class="fabric-patch-tag">
            <span>THREAD COUNT: 180 GSM</span>
            <span id="spotlightIndex">01 / 07</span>
          </div>
        </div>

        <!-- Right: Info sewn in live -->
        <div class="info-col">
          <div class="stitch-counter" id="stitchCounter">STITCHES: 0 / 1000</div>
          
          <div class="stitched-name-container">
            <h2 class="stitched-name" id="stitchedName"></h2>
          </div>

          <div class="role-box">
            <span class="stitched-role" id="stitchedRole">Product Owner</span>
            <span class="apparel-pill" id="stitchedTag">Apparel Architecture</span>
          </div>

          <p class="tailor-chalk-note" id="stitchedBio">
            Orchestrating bespoke fabric tenders, yarn quality lab-dips, and direct mill agreements.
          </p>

          <!-- Sewn Patches for GitHub & LinkedIn -->
          <nav class="sewn-links-row">
            <a class="sewn-patch-btn" id="githubPatch" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .8a11.2 11.2 0 0 0-3.54 21.82c.56.1.76-.24.76-.54v-2.14c-3.1.67-3.76-1.32-3.76-1.32-.5-1.28-1.23-1.28-1.23-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 .1 1.64.8 2.96.56.1-.72.39-1.21.71-1.49-2.48-.28-5.08-1.24-5.08-5.53 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.08 1.15A10.7 10.7 0 0 1 12 6.5c.95 0 1.9.13 2.79.38 2.14-1.45 3.07-1.15 3.07-1.15.62 1.54.23 2.68.12 2.96.72.78 1.15 1.78 1.15 3 0 4.3-2.6 5.24-5.1 5.52.4.35.76 1.03.76 2.08v2.79c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z"/></svg>
              <span>GITHUB PATCH</span>
              <span aria-hidden="true">↗</span>
            </a>
            <a class="sewn-patch-btn btn-linkedin-patch" id="linkedinPatch" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.31 10.85h-2.95V14.1c0-1.1-.02-2.52-1.54-2.52-1.54 0-1.78 1.2-1.78 2.44v4.73H9.54V9.2h2.83v1.3h.04a3.1 3.1 0 0 1 2.79-1.53c2.98 0 3.56 1.96 3.56 4.5v5.28Z"/></svg>
              <span>LINKEDIN LABEL</span>
              <span>↗</span>
            </a>
          </nav>
        </div>
      </div>
    </section>
  </main>

  <!-- Live Stitch Progress Gauge -->
  <button type="button" class="stitch-progress-hud">
    <div class="stitch-bar-track">
      <div class="stitch-bar-fill" id="stitchBarFill"></div>
    </div>
    <span id="stitchStatusText">Scroll to Sew In ↡</span>
  </button>

  <div id="timelinePills" hidden aria-hidden="true"></div>
  <span id="modeToggleText" hidden></span>
</div>
<script src="~/team/team.js" asp-append-version="true"></script>
</body>
</html>
