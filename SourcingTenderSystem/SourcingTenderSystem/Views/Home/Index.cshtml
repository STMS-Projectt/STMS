@{
    Layout = null;
}
<!doctype html>
<html lang="@L.Language" dir="@L.Direction">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@L.T("Little Threads — Kidswear Supply")</title>
  <meta name="description" content="Little Threads connects verified children's clothing suppliers with retailers. Walk through our store and see how it works.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@@0,500;0,600;1,500&family=Inter:wght@@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/home/css/style.css" asp-append-version="true">
  <partial name="_DisplayHead" />
  <link rel="stylesheet" href="~/css/display-preferences.css" asp-append-version="true">

  <!-- three.js (ES modules). "<!script" opts out of the ASP.NET script tag helper, which would otherwise replace this import map with the app's static-assets map. -->
  <!script type="importmap">
  {
    "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@@0.160.0/build/three.module.js",
      "three/addons/": "https://cdn.jsdelivr.net/npm/three@@0.160.0/examples/jsm/"
    }
  }
  </!script>
</head>
<body class="stms-home">

  <!-- ================= LOADER ================= -->
  <div id="loader" aria-live="polite">
    <div class="loader-inner">
      <div class="brand-mark">L</div>
      <div class="loader-title serif">Little Threads</div>
      <div class="loader-bar"><span id="loaderBar"></span></div>
      <div class="loader-text" id="loaderText">@L.T("Opening the store…")</div>
    </div>
  </div>

  <!-- ================= NAVBAR ================= -->
  <header>
    <nav class="navbar" id="navbar">
      <partial name="_DisplayPreferences" />
      <a href="#home" class="logo" aria-label="@L.T("Little Threads home")">
        <span class="brand-mark">L</span>
        <span class="logo-text"><b>Little Threads</b><small>KIDSWEAR SUPPLY</small></span>
      </a>
      <button class="burger" id="burger" aria-label="@L.T("Open menu")" aria-expanded="false"><span></span><span></span></button>
      <div class="nav-links" id="navLinks">
        <a href="#home" class="nav-link active" data-section="home">@L.T("Home")</a>
        <a href="#about" class="nav-link" data-section="about">@L.T("About")</a>
        <a href="#how-it-works" class="nav-link" data-section="how-it-works">@L.T("How It Works")</a>
        <a href="#contact" class="nav-link" data-section="contact">@L.T("Contact")</a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline">@L.T("Login")</a>
        <a asp-controller="SupplierRegistration" asp-action="Register" class="btn btn-dark">@L.T("Supplier Registration")</a>
      </div>
    </nav>
  </header>

  <main>
    <!-- ================= HOME: 3D WALK-THROUGH ================= -->
    <section id="home" class="walk-track" aria-label="@L.T("Walk through the Little Threads store")">
      <div class="stage" id="stage">
        <canvas id="gl"></canvas>
        <div class="vignette" id="vignette"></div>
        <div class="veil" id="veil"></div>

        <!-- Hero (outside the store) -->
        <div class="hero-fade" id="heroFade"></div>
        <div class="hero" id="hero">
          <div>
            <div class="eyebrow">@L.T("Wholesale children’s apparel")</div>
            <h1 class="serif">@L.T("Step inside the") <em>@L.T("finest")</em> @L.T("kidswear supply.")</h1>
          </div>
          <div class="scroll-cue">
            <div class="mouse"><span id="wheel"></span></div>
            @L.T("SCROLL TO WALK IN")
          </div>
        </div>

        <!-- Department cards + hotspots (filled by main.js) -->
        <div id="departments"></div>

        <!-- Video wall controls (shown in front of the screen at the end of the walk) -->
        <div class="video-ui" id="videoUI">
          <button class="btn btn-gold btn-lg" id="videoPlay" aria-pressed="false"><span class="ico">▶</span> @L.T("Play our story")</button>
          <button class="btn btn-outline-light" id="videoMute" hidden>@L.T("Mute")</button>
          <span class="video-note" id="videoNote"></span>
        </div>

        <!-- Department progress -->
        <div class="dept-bar glass" id="deptBar"></div>
      </div>
    </section>

    <!-- ================= HOW IT WORKS ================= -->
    <section id="how-it-works" class="section hiw">
      <div class="container">
        <div class="section-head reveal">
          <div class="eyebrow">@L.T("The supplier journey")</div>
          <h2 class="serif">@L.T("How it works")</h2>
          <p>@L.T("Six simple steps from sign-up to your first payout.")</p>
        </div>
        <div class="steps" id="steps">
          <div class="steps-line"><span id="stepsLine"></span></div>
          <!-- step cards injected by main.js -->
        </div>
        <div class="center reveal"><a asp-controller="SupplierRegistration" asp-action="Register" class="btn btn-gold btn-lg">@L.T("Become a Supplier →")</a></div>
      </div>
    </section>

    <!-- ================= ABOUT ================= -->
    <section id="about" class="section about" aria-labelledby="aboutTitle">
      <div class="container about-top">
        <div class="about-copy">
          <div class="eyebrow">@L.T("About us · Our mission")</div>
          <h2 class="serif reveal" id="aboutTitle">@L.T("Dressing the next generation — with suppliers you can") <em>@L.T("trust.")</em></h2>
          <p class="reveal">@L.T("Little Threads makes children’s apparel sourcing transparent, reliable and fair. We give verified manufacturers a trusted storefront, and give retailers quality, full size runs and on-time delivery they can count on.")</p>
          <ul class="about-points reveal">
            <li><svg class="i"><use href="#i-check"/></svg>@L.T("Every supplier is verified before going live")</li>
            <li><svg class="i"><use href="#i-check"/></svg>@L.T("Full size runs from newborn to 14 years")</li>
            <li><svg class="i"><use href="#i-check"/></svg>@L.T("Quality-checked, packed and tracked by our team")</li>
          </ul>
          <div class="about-cta reveal">
            <a href="#contact" class="btn btn-gold btn-lg">@L.T("Talk to our team →")</a>
            <a href="#how-it-works" class="btn btn-outline btn-lg">@L.T("How it works")</a>
          </div>
        </div>
        <div class="about-collage reveal" aria-hidden="true">
          <figure class="ph ph-main"><img src="~/home/assets/store-front.jpg" alt="" loading="lazy"></figure>
          <figure class="ph ph-small"><img src="~/home/assets/about-team.jpg" alt="" loading="lazy"></figure>
          <div class="float-badge">
            <span class="fb-ico"><svg class="i"><use href="#i-shield"/></svg></span>
            <div><b>@L.T("Verified suppliers")</b><span>@L.T("Checked documents, quality & capacity")</span></div>
          </div>
          <div class="float-chip"><span class="dot"></span>@L.T("Since 2026")</div>
        </div>
      </div>

      <div class="container about-stats reveal">
        <div><b class="serif" data-count="500" data-suffix="+">0</b><span>@L.T("Verified suppliers")</span></div>
        <div><b class="serif" data-count="12" data-suffix="K">0</b><span>@L.T("Products listed")</span></div>
        <div><b class="serif" data-count="98" data-suffix="%">0</b><span>@L.T("On-time delivery")</span></div>
        <div><b class="serif" data-count="24" data-suffix="h">0</b><span>@L.T("Average reply time")</span></div>
      </div>

      <div class="container about-values">
        <article class="value-card reveal">
          <span class="v-ico"><svg class="i"><use href="#i-shield"/></svg></span><span class="v-num">01</span>
          <h3>@L.T("Verified suppliers only")</h3><p>@L.T("Every manufacturer is checked — documents, quality and capacity — before going live.")</p>
        </article>
        <article class="value-card reveal">
          <span class="v-ico"><svg class="i"><use href="#i-heart"/></svg></span><span class="v-num">02</span>
          <h3>@L.T("Made for little ones")</h3><p>@L.T("Soft, safe, certified fabrics and full size runs from newborn to 14 years.")</p>
        </article>
        <article class="value-card reveal">
          <span class="v-ico"><svg class="i"><use href="#i-truck"/></svg></span><span class="v-num">03</span>
          <h3>@L.T("Checked, packed, tracked")</h3><p>@L.T("Our dispatch team quality-checks every order and ships it with live tracking.")</p>
        </article>
      </div>
    </section>

    <!-- ================= CONTACT ================= -->
    <section id="contact" class="section contact-sec" aria-labelledby="contactTitle">
      <div class="contact-banner">
        <div class="container banner-txt">
          <div class="eyebrow light">@L.T("Contact")</div>
          <h2 class="serif" id="contactTitle">@L.T("Come say hello to the team.")</h2>
          <p>@L.T("Whether you make children’s clothing or sell it, we’d love to hear from you.")</p>
          <div class="quick">
            <a href="tel:+0000000000"><svg class="i"><use href="#i-phone"/></svg>@L.T("Call")</a>
            <a href="https://wa.me/0000000000" target="_blank" rel="noopener"><svg class="i"><use href="#i-wa"/></svg>WhatsApp</a>
            <a href="mailto:hello@@littlethreads.com"><svg class="i"><use href="#i-mail"/></svg>@L.T("Email")</a>
          </div>
        </div>
      </div>

      <div class="container contact-card reveal">
        <form id="contactForm" novalidate>
          <div class="eyebrow">@L.T("Send a message")</div>
          <h3 class="serif">@L.T("How can we help?")</h3>
          <fieldset class="topics" aria-label="@L.T("Topic")">
            <label><input type="radio" name="topic" value="Becoming a supplier" checked><span>@L.T("Becoming a supplier")</span></label>
            <label><input type="radio" name="topic" value="Buying wholesale"><span>@L.T("Buying wholesale")</span></label>
            <label><input type="radio" name="topic" value="Partnership"><span>@L.T("Partnership")</span></label>
            <label><input type="radio" name="topic" value="Other"><span>@L.T("Other")</span></label>
          </fieldset>
          <div class="grid2">
            <label class="fl"><span>@L.T("Full name")</span><input name="name" type="text" autocomplete="name" placeholder="@L.T("")" required></label>
            <label class="fl"><span>@L.T("Email")</span><input name="email" type="email" autocomplete="email" placeholder="@L.T("")" required></label>
            <label class="fl"><span>@L.T("Company / Store")</span><input name="company" type="text" autocomplete="organization" placeholder="@L.T("")"></label>
            <label class="fl"><span>@L.T("Monthly order volume")</span>
              <select name="volume"><option value="Less than 500 pieces">@L.T("Less than 500 pieces")</option><option selected>500 – 2,000 pieces</option><option>2,000 – 10,000 pieces</option><option>10,000+ pieces</option></select></label>
          </div>
          <label class="fl"><span>@L.T("Message")</span><textarea name="message" rows="4" placeholder="@L.T("")" required></textarea></label>
          <div class="form-row">
            <label class="consent"><input type="checkbox" name="consent" required><i aria-hidden="true"></i>@L.T("I agree to be contacted.")</label>
            <button class="btn btn-gold btn-lg" type="submit">@L.T("Send message →")</button>
          </div>
          <div class="form-note" id="formNote" role="status"></div>
        </form>

        <aside class="next">
          <div class="eyebrow">@L.T("What happens next")</div>
          <ol class="next-steps">
            <li><b>1</b><div><h4>@L.T("We read your message")</h4><p>@L.T("The right team picks it up within hours.")</p></div></li>
            <li><b>2</b><div><h4>@L.T("A short call")</h4><p>@L.T("We learn about your products or needs.")</p></div></li>
            <li><b>3</b><div><h4>@L.T("You’re set up")</h4><p>@L.T("Onboarding or a tailored quote — fast.")</p></div></li>
          </ol>
          <div class="mapcard">
            <svg viewBox="0 0 340 150" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect width="340" height="150" fill="#EEF1F2"/><g stroke="#fff" stroke-width="10"><path d="M-10 40 L350 70"/><path d="M80 -10 L120 160"/><path d="M240 -10 L210 160"/><path d="M-10 120 L350 105"/></g><g stroke="#fff" stroke-width="4"><path d="M-10 90 L350 20"/><path d="M160 -10 L170 160"/></g><rect x="20" y="70" width="40" height="30" rx="4" fill="#d9f7ec"/><rect x="260" y="20" width="60" height="30" rx="4" fill="#d9f7ec"/><circle cx="168" cy="78" r="26" fill="rgba(8,118,108,.16)"/><path d="M168 92s-12-10-12-19a12 12 0 0 1 24 0c0 9-12 19-12 19Z" fill="#111e33"/><circle cx="168" cy="73" r="4.5" fill="#d9f7ec"/></svg>
            <div class="addr"><div><b>@L.T("Supply Hub")</b><span>Main St. 12, Your City</span></div>
              <a class="btn btn-outline" href="https://www.google.com/maps/search/?api=1&query=Main+St+12+Your+City" target="_blank" rel="noopener">@L.T("Directions")</a></div>
          </div>
        </aside>
      </div>

      <div class="container faq">
        <div><div class="eyebrow">FAQ</div><h3 class="serif">@L.T("Quick answers before you write.")</h3></div>
        <div class="faq-list">
          <details open><summary>@L.T("How long does supplier verification take?")<span></span></summary><p>@L.T("Most suppliers are verified and live within 5 working days once their documents are complete.")</p></details>
          <details><summary>@L.T("Is there a minimum order quantity?")<span></span></summary><p>@L.T("Each supplier sets their own MOQ per product. You can see it on every product page before you order.")</p></details>
          <details><summary>@L.T("Which countries do you ship to?")<span></span></summary><p>@L.T("We currently ship across the region and are adding new destinations every quarter. Ask us about your location.")</p></details>
          <details><summary>@L.T("How do suppliers get paid?")<span></span></summary><p>@L.T("Payouts are made securely after delivery is confirmed, with clear monthly sales reports.")</p></details>
        </div>
      </div>
    </section>
  </main>

  <!-- ================= FOOTER ================= -->
  <footer class="site-footer">
    <div class="container ft-top">
      <div>
        <div class="ft-big serif">@L.T("Dressing the next generation,") <em>@L.T("together.")</em></div>
        <p>@L.T("Get monthly kidswear trends, new suppliers and sourcing tips — straight to your inbox.")</p>
        <form class="ft-news" id="newsForm" novalidate>
          <input type="email" name="email" placeholder="@L.T("Enter your email")" aria-label="@L.T("Email address")" required>
          <button class="btn btn-dark btn-lg" type="submit">@L.T("Subscribe")</button>
        </form>
        <div class="ft-note" id="newsNote" role="status"></div>
      </div>
      <nav class="ft-cols" aria-label="@L.T("Footer")">
        <div><h5>@L.T("Explore")</h5><ul><li><a href="#home">@L.T("Home")</a></li><li><a href="#about">@L.T("About")</a></li><li><a href="#how-it-works">@L.T("How It Works")</a></li><li><a href="#contact">@L.T("Contact")</a></li></ul></div>
        <div><h5>@L.T("Suppliers")</h5><ul><li><a asp-controller="SupplierRegistration" asp-action="Register">@L.T("Registration")</a></li><li><a asp-controller="Account" asp-action="Login">@L.T("Login")</a></li><li><a href="#">@L.T("Guidelines")</a></li><li><a href="#">@L.T("Pricing")</a></li></ul></div>
        <div><h5>@L.T("Departments")</h5><ul><li><a href="#home">@L.T("Girls & Baby")</a></li><li><a href="#home">@L.T("Boys")</a></li><li><a href="#home">@L.T("Accessories")</a></li><li><a href="#home">@L.T("Our Team")</a></li></ul></div>
      </nav>
    </div>
    <div class="container ft-mid">
      <a href="#home" class="logo"><span class="brand-mark">L</span><span class="logo-text"><b>Little Threads</b><small>KIDSWEAR SUPPLY</small></span></a>
      <div class="ft-contact">
        <div><b>@L.T("CALL")</b><a href="tel:+0000000000">+000 000 0000</a></div>
        <div><b>@L.T("EMAIL")</b><a href="mailto:hello@@littlethreads.com">hello@@littlethreads.com</a></div>
        <div><b>@L.T("VISIT")</b><span>Main St. 12, Your City</span></div>
      </div>
      <div class="ft-social">
        <a href="#" aria-label="Instagram"><svg class="i"><use href="#i-ig"/></svg></a>
        <a href="#" aria-label="LinkedIn"><svg class="i"><use href="#i-li"/></svg></a>
        <a href="#" aria-label="Facebook"><svg class="i"><use href="#i-fb"/></svg></a>
        <a href="#" aria-label="TikTok"><svg class="i"><use href="#i-tk"/></svg></a>
      </div>
    </div>
    <div class="ft-marquee serif" aria-hidden="true"><span>Little Threads · Kidswear Supply · Little Threads · Kidswear Supply ·&nbsp;</span><span>Little Threads · Kidswear Supply · Little Threads · Kidswear Supply ·&nbsp;</span></div>
    <div class="ft-strip"><div class="container"><span>© <span id="year"></span> @L.T("Little Threads. All rights reserved.")</span><span><a href="#">@L.T("Privacy")</a> · <a href="#">@L.T("Terms")</a> · <a href="#">@L.T("Cookies")</a></span><span>@L.T("Made with care for little ones")</span></div></div>
  </footer>

  <!-- icon sprite -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
    <symbol id="i-phone" viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></symbol>
    <symbol id="i-mail" viewBox="0 0 24 24"><path d="M3 6h18v12H3zM3 7l9 6 9-6"/></symbol>
    <symbol id="i-wa" viewBox="0 0 24 24"><path d="M3 21l1.6-4.7A9 9 0 1 1 8 19.6L3 21Z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 1a4 4 0 0 1-2-2l1-1-1-2L9 9.5"/></symbol>
    <symbol id="i-ig" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="5"/><circle cx="12" cy="12" r="3.5"/><circle cx="17" cy="7" r=".8"/></symbol>
    <symbol id="i-li" viewBox="0 0 24 24"><path d="M6 10v8M6 6v.1M10 18v-8M10 13a3 3 0 0 1 6 0v5"/></symbol>
    <symbol id="i-fb" viewBox="0 0 24 24"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8Z"/></symbol>
    <symbol id="i-tk" viewBox="0 0 24 24"><path d="M14 4v10a3.5 3.5 0 1 1-3.5-3.5M14 4c.5 2.5 2.5 4 5 4"/></symbol>
    <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3Z"/><path d="M9 12l2 2 4-4"/></symbol>
    <symbol id="i-heart" viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></symbol>
    <symbol id="i-truck" viewBox="0 0 24 24"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></symbol>
  </defs></svg>

  <script type="module" src="~/home/js/main.js"></script>
</body>
</html>
