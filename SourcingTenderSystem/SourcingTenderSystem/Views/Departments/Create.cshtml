@model DepartmentInput
@{ ViewData["Title"] = "Add department"; }
<h1>Add department</h1>
<form method="post" asp-antiforgery="true" class="admin-form" >
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <partial name="_Fields" model="Model" />
    <button class="btn btn-primary" type="submit">Create department</button>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
