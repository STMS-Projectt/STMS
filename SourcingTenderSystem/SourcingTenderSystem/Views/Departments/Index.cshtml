@model IReadOnlyList<Department>
@{ ViewData["Title"] = "Departments"; }
<header class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>Departments</h1><p>Organize employee accounts by department.</p></div><a class="btn btn-primary" asp-action="Create" ><partial name="_Icon" model='@("plus")' /> Add department</a></header>
<section class="surface directory" aria-label="Departments directory" data-directory>
    <div class="directory-toolbar">
    <label class="search-box" hidden="@(Model.Count == 0)"><partial name="_Icon" model='@("search")' /><span class="visually-hidden">Search departments</span><input class="form-control" type="search" data-filter-search placeholder="Search departments"></label>
    <span class="result-count" data-result-count aria-live="polite">@Model.Count records</span>
</div>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("building")' /></span><h2>No departments yet</h2><p>Add a department so employees can be assigned to it.</p><a class="btn btn-primary" asp-action="Create" >Add department</a></div>
    }
    else
    {
        <table class="directory-table" role="table">
            <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Department</th><th scope="col" role="columnheader">Status</th><th scope="col" role="columnheader">Actions</th></tr></thead>
            <tbody role="rowgroup">
            @foreach (var item in Model)
            {
                <tr role="row">
                    <td role="cell"><div class="record-name"><span class="avatar"><partial name="_Icon" model='@("building")' /></span><span>@item.Name</span></div></td>
                    <td role="cell" data-label="Status"><partial name="_Status" model='@(item.IsActive ? "Active" : "Inactive")' /></td>
                    <td role="cell" data-label="Actions"><a class="table-action" asp-action="Details" asp-route-id="@item.Id">View details <partial name="_Icon" model='@("arrow")' /><span class="visually-hidden"> for @item.Name</span></a></td>
                </tr>
            }
            </tbody>
        </table>
        <div data-filter-empty hidden><div class="empty-state"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("search")' /></span><h2>No matching records</h2><p>Try a different name or clear your search.</p><button type="button" class="btn btn-outline-secondary">Clear search</button></div></div>
    }
</section>
