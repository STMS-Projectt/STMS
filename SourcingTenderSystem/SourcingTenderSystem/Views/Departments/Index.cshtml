@model IReadOnlyList<DepartmentDirectoryRow>
@{ ViewData["Title"] = "Departments"; }
<header class="page-heading stms-hero"><div><p class="eyebrow">ADMINISTRATION</p><h1>Departments</h1><p>Organize employee accounts by department.</p></div><a data-workspace-dialog class="btn btn-primary" asp-action="Create" ><partial name="_Icon" model='@("plus")' /> Add department</a></header>
<partial name="_DesignMetrics" model='@(new[] { ("Departments", Model.Count, "building", "blue"), ("Active", Model.Count(d => d.IsActive), "check", "teal"), ("Inactive", Model.Count(d => !d.IsActive), "clock", "amber"), ("Assigned employees", Model.Sum(d => d.EmployeeCount), "users", "violet") })' />
<section class="surface directory dept-directory" aria-label="Departments directory" data-directory>
    <div class="dept-directory-heading"><h2>Department directory</h2><p>Find a team and see its assigned employees.</p></div>
    <div class="directory-filter-panel">
    @if (Model.Count > 0) { <partial name="_DirectoryStatusButtons" /> }
    <div class="directory-toolbar dept-filters">
    <div class="directory-search" hidden="@(Model.Count == 0)">
        <label class="search-box"><partial name="_Icon" model='@("search")' /><span class="visually-hidden">Search departments</span><input class="form-control" type="search" data-filter-search placeholder="Search departments"></label>
        <partial name="_DirectoryVoice" />
    </div>
    @if (Model.Count > 0)
    {
        <label>Employees<select class="form-select" data-filter-staff><option value="">All departments</option><option value="staffed">With employees</option><option value="empty">Without employees</option></select></label>
        <label>Sort by<select class="form-select" data-filter-sort><option value="">Name (A–Z)</option><option value="desc">Name (Z–A)</option><option value="staff">Most employees</option></select></label>
        <button type="button" class="btn btn-outline-secondary" data-filter-reset>Reset</button>
    }
    <span class="result-count" data-result-count aria-live="polite">@Model.Count records</span>
</div>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("building")' /></span><h2>No departments yet</h2><p>Add a department so employees can be assigned to it.</p><a data-workspace-dialog class="btn btn-primary" asp-action="Create" >Add department</a></div>
    }
    else
    {
        <div class="record-list" data-record-list>
            @foreach (var item in Model)
            {
                <article class="record-card" data-record data-status="@(item.IsActive ? "active" : "inactive")" data-staff="@item.EmployeeCount">
                    <div class="record-name"><span class="avatar"><partial name="_Icon" model='@("building")' /></span><span>@item.Name @if (!string.IsNullOrWhiteSpace(item.Description)) { <small class="dept-description">@item.Description</small> }</span></div><dl class="record-facts">
                    <div><dt class="visually-hidden">Status</dt><dd><partial name="_Status" model='@(item.IsActive ? "Active" : "Inactive")' /></dd></div>
                    <div><dt class="record-field-icon" title="Employees"><partial name="_Icon" model='@("users")' /><span class="visually-hidden">Employees</span></dt><dd><strong class="dept-staff-count">@item.EmployeeCount</strong></dd></div>
                    </dl><div class="record-action"><a data-workspace-dialog="details" class="record-icon-action" asp-action="Details" asp-route-id="@item.Id" aria-label="View details for @item.Name" data-tooltip="View details"><partial name="_Icon" model='@("eye")' /></a></div>
                </article>
            }
            </div>
        <div data-filter-empty hidden><div class="empty-state"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("search")' /></span><h2>No matching records</h2><p>Try a different name or reset the filters.</p><button type="button" class="btn btn-outline-secondary">Reset filters</button></div></div>
    }
</section>
