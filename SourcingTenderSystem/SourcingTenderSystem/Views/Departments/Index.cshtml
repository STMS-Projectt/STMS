@model IReadOnlyList<DepartmentDirectoryRow>
@{ ViewData["Title"] = "Departments"; }
<header class="page-heading stms-hero dept-overview"><div><p class="eyebrow">ADMINISTRATION</p><h1>Departments</h1><p>Organize employee accounts by department.</p></div><a data-workspace-dialog class="btn btn-primary" asp-action="Create" ><partial name="_Icon" model='@("plus")' /> Add department</a></header>
<partial name="_DesignMetrics" model='@(new[] { ("Departments", Model.Count, "building", "blue"), ("Active", Model.Count(d => d.IsActive), "check", "teal"), ("Inactive", Model.Count(d => !d.IsActive), "clock", "amber"), ("Assigned employees", Model.Sum(d => d.EmployeeCount), "users", "violet") })' />
<section class="surface directory dept-directory" aria-label="Departments directory" data-directory>
    <div class="dept-directory-heading">
        <span class="icon-tile tone-teal"><partial name="_Icon" model='@("building")' /></span>
        <div><p class="eyebrow">ORGANIZATION</p><h2>Department directory</h2><p>Find a team and see its assigned employees.</p></div>
    </div>
    <div class="directory-filter-panel dept-filter-dock" aria-label="Department filters">
        @if (Model.Count > 0)
        {
            <div class="dept-filter-menu" data-dept-menu>
                <button type="button" class="dept-dock-button" aria-expanded="false" aria-haspopup="true"><partial name="_Icon" model='@("filter")' /><span>Status</span></button>
                <div class="dept-filter-popover" hidden><strong>Status</strong><partial name="_DirectoryStatusButtons" /></div>
            </div>
            <div class="dept-filter-menu" data-dept-menu>
                <button type="button" class="dept-dock-button" aria-expanded="false" aria-haspopup="true"><partial name="_Icon" model='@("users")' /><span>Employees</span></button>
                <div class="dept-filter-popover" hidden><strong>Employees</strong><button type="button" data-dept-select="staff" data-value="">All departments</button><button type="button" data-dept-select="staff" data-value="staffed">With employees</button><button type="button" data-dept-select="staff" data-value="empty">Without employees</button></div>
            </div>
            <div class="dept-filter-menu" data-dept-menu>
                <button type="button" class="dept-dock-button" aria-expanded="false" aria-haspopup="true"><partial name="_Icon" model='@("sort")' /><span>Sort</span></button>
                <div class="dept-filter-popover" hidden><strong>Sort by</strong><button type="button" data-dept-select="sort" data-value="">Name (A–Z)</button><button type="button" data-dept-select="sort" data-value="desc">Name (Z–A)</button><button type="button" data-dept-select="sort" data-value="staff">Most employees</button></div>
            </div>
            <select data-filter-staff hidden aria-label="Employees filter"><option value="">All departments</option><option value="staffed">With employees</option><option value="empty">Without employees</option></select>
            <select data-filter-sort hidden aria-label="Sort departments"><option value="">Name (A–Z)</option><option value="desc">Name (Z–A)</option><option value="staff">Most employees</option></select>
        }
        <button type="button" class="dept-dock-button" data-dept-search-open aria-label="Search departments" title="Search departments"><partial name="_Icon" model='@("search")' /><span>Search</span></button>
        <button type="button" class="dept-dock-button" data-filter-reset aria-label="Reset filters" title="Reset filters"><partial name="_Icon" model='@("refresh")' /><span>Reset</span></button>
        <span data-result-count aria-live="polite" hidden>@Model.Count records</span>
    </div>
    <dialog class="dept-search-dialog" aria-label="Search departments" data-dept-search-dialog>
        <div class="dept-search-heading"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("search")' /></span><div><h2>Search departments</h2><p>Find a team by name or description.</p></div><button type="button" class="dept-search-close" data-dept-search-close aria-label="Close search">×</button></div>
        <div class="directory-search">
            <label class="search-box"><partial name="_Icon" model='@("search")' /><span class="visually-hidden">Search departments</span><input class="form-control" type="search" data-filter-search placeholder="Search departments" autocomplete="off"></label>
            <partial name="_DirectoryVoice" />
        </div>
        <p class="dept-search-hint">Results update as you type.</p>
    </dialog>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("building")' /></span><h2>No departments yet</h2><p>Add a department so employees can be assigned to it.</p><a data-workspace-dialog class="btn btn-primary" asp-action="Create" >Add department</a></div>
    }
    else
    {
        <div class="record-list" data-record-list>
            @foreach (var item in Model)
            {
                <article class="record-card" data-record data-status="@(item.IsActive ? "active" : "inactive")" data-staff="@item.EmployeeCount">
                    <div class="record-name"><span class="avatar"><partial name="_Icon" model='@("building")' /></span><span>@item.Name @if (!string.IsNullOrWhiteSpace(item.Description)) { <small class="dept-description">@item.Description</small> }</span></div><dl class="record-facts">
                    <div><dt class="visually-hidden">Status</dt><dd><partial name="_Status" model='@(item.IsActive ? "Active" : "Inactive")' /></dd></div>
                    <div><dt class="record-field-icon" title="Employees"><partial name="_Icon" model='@("users")' /><span class="visually-hidden">Employees</span></dt><dd><strong class="dept-staff-count">@item.EmployeeCount</strong></dd></div>
                    </dl><div class="record-action"><a data-workspace-dialog="details" class="record-icon-action" asp-action="Details" asp-route-id="@item.Id" aria-label="View details for @item.Name" data-tooltip="View details"><partial name="_Icon" model='@("eye")' /></a></div>
                </article>
            }
            </div>
        <div data-filter-empty hidden><div class="empty-state"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("search")' /></span><h2>No matching records</h2><p>Try a different name or reset the filters.</p><button type="button" class="btn btn-outline-secondary">Reset filters</button></div></div>
        <nav class="dept-pagination" data-dept-pagination aria-label="Department pages" hidden>
            <button type="button" data-page-prev aria-label="Previous page">Previous</button>
            <span data-page-status aria-live="polite"></span>
            <button type="button" data-page-next aria-label="Next page">Next</button>
        </nav>
    }
</section>
@section Scripts {
    <script src="~/js/departments.js" asp-append-version="true" defer></script>
}
