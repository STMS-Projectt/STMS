@model IReadOnlyList<Department>
@{ ViewData["Title"] = "Departments"; }
<h1>Departments</h1>
<p><a class="btn btn-primary" asp-action="Create">Add department</a></p>
@if (Model.Count == 0)
{
    <p class="text-muted">No records found.</p>
}
else
{
    <div class="table-responsive"><table class="table table-striped align-middle">
        <thead><tr><th scope="col">Name</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr><td>@item.Name</td><td>@(item.IsActive ? "Active" : "Inactive")</td><td><a asp-action="Details" asp-route-id="@item.Id">Details</a></td></tr>
        }
        </tbody>
    </table></div>
}
