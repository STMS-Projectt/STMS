@model Department
@{ ViewData["Title"] = "Department details"; }
<a class="back-link" asp-action="Index" ><partial name="_Icon" model='@("back")' /> Departments</a>
<header class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>@Model.Name</h1><p>Department profile and assignment status.</p></div><a data-workspace-dialog class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit department</a></header>
<div class="form-shell"><section class="surface detail-card"><h2>Department information</h2><dl class="detail-grid"><div><dt>Name</dt><dd>@Model.Name</dd></div>
<div><dt>Status</dt><dd><partial name="_Status" model='@(Model.IsActive ? "Active" : "Inactive")' /></dd></div>
<div><dt>Description</dt><dd>@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</dd></div>
<div><dt>Employees</dt><dd>@Model.EmployeeProfiles.Count</dd></div></dl></section>
<aside class="surface helper-card"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("users")' /></span><h2>Employees</h2><p>Manage employee accounts and department assignments in the employee directory.</p><a class="text-link" asp-controller="Employees" asp-action="Index">Open employees <partial name="_Icon" model='@("arrow")' /></a></aside></div>
