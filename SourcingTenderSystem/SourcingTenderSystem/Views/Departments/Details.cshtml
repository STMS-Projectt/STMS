@model Department
@{ ViewData["Title"] = "Department details"; }
<a class="back-link" asp-action="Index" ><partial name="_Icon" model='@("back")' /> @L.T("Departments")</a>
<header class="page-heading stms-hero admin-record-hero"><div><p class="eyebrow">@L.T("ADMINISTRATION")</p><h1>@Model.Name</h1><p>@L.T("Department profile and assignment status.")</p></div><a data-workspace-dialog class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">@L.T("Edit department")</a></header>
<div class="form-shell"><section class="surface detail-card"><h2>@L.T("Department information")</h2><dl class="detail-grid"><div><dt>@L.T("Name")</dt><dd>@Model.Name</dd></div>
<div><dt>@L.T("Status")</dt><dd><partial name="_Status" model='@(Model.IsActive ? "Active" : "Inactive")' /></dd></div>
<div><dt>@L.T("Description")</dt><dd>@(string.IsNullOrWhiteSpace(Model.Description) ? L.T("No description provided.") : Model.Description)</dd></div>
<div><dt>@L.T("Employees")</dt><dd>@Model.EmployeeProfiles.Count</dd></div></dl></section>
<aside class="surface helper-card"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("users")' /></span><h2>@L.T("Employees")</h2><p>@L.T("Manage employee accounts and department assignments in the employee directory.")</p><a class="text-link" asp-controller="Employees" asp-action="Index">@L.T("Open employees") <partial name="_Icon" model='@("arrow")' /></a></aside></div>
