@model IReadOnlyList<Notification>
@{ ViewData["Title"] = "Notifications"; }
<header class="page-heading stms-hero"><div><p class="eyebrow">YOUR WORKSPACE</p><h1>Notifications</h1><p>New clarification requests, responses, and workflow updates.</p></div></header>
@if (Model.Count == 0) { <section class="surface empty-state"><h2>No notifications yet</h2></section> }
else
{
    <section class="surface directory dept-directory" data-directory>
    <div class="dept-directory-heading"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("mail")' /></span><div><h2>Inbox</h2><p>Find a notification or filter by read status.</p></div></div>
    <partial name="_ListFilters" model='@("Search notifications", Model.Select(n => n.IsRead ? "Read" : "Unread"))' />
    <partial name="_DirectoryPages" model='@("Notification pages")' />
    <div class="record-list" data-record-list>
        @foreach (var item in Model)
        {
            var action = item.Link is not null ? "Open notification" : "Mark as read";
            <article class="record-card" data-record data-status="@(item.IsRead ? "Read" : "Unread")">
                <div class="record-name"><span class="avatar"><partial name="_Icon" model='@("mail")' /></span><span>@item.Title<small>@item.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</small></span></div>
                <dl class="record-facts"><div><dt class="visually-hidden">Message</dt><dd>@item.Message</dd></div>
                    <div><dt class="visually-hidden">Status</dt><dd><span class="status-pill @(item.IsRead ? "status-positive" : "status-waiting")">@(item.IsRead ? "Read" : "Unread")</span></dd></div></dl>
                <div class="record-action">
                    @if (item.Link is not null || !item.IsRead)
                    {
                        <form asp-action="Read" asp-route-id="@item.Id" method="post" data-workspace-dialog="@(item.Link is not null ? "details" : null)">
                            <button class="record-icon-action" type="submit" aria-label="@(action): @item.Title" data-tooltip="@action"><partial name="_Icon" model='@(item.Link is not null ? "eye" : "check")' /></button>
                        </form>
                    }
                </div>
            </article>
        }
    </div>
    <partial name="_ListFilterEmpty" />
</section>
}
