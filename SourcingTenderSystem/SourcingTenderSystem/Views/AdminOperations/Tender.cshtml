@model AdminTenderView
@{
    ViewData["Title"] = "Tender details";
    var tender = Model.Tender;
}
<a class="back-link" asp-action="Tenders"><partial name="_Icon" model='@("back")' /> Tenders</a>
<header class="page-heading"><div><p class="eyebrow">TENDER #@tender.Id</p><h1>@tender.Title</h1><p>@tender.Status · @tender.PurchaseRequisition.Department.Name</p></div>
<div class="button-row">
    <a class="btn btn-outline-secondary" asp-action="RequestDetails" asp-route-id="@tender.PurchaseRequisitionId">View request</a>
    @if (tender.Status == "Under Evaluation" || tender.EvaluationReport != null) { <a class="btn btn-primary" asp-controller="EvaluationWorkflow" asp-action="Details" asp-route-id="@tender.Id">View evaluation</a> }
</div></header>
<section class="surface detail-card mb-3"><h2>Tender information</h2>
    <dl class="detail-grid"><div><dt>Opens (UTC)</dt><dd>@tender.OpenDate.ToString("dd MMM yyyy HH:mm")</dd></div><div><dt>Closes (UTC)</dt><dd>@tender.CloseDate.ToString("dd MMM yyyy HH:mm")</dd></div></dl>
    <p style="white-space:pre-wrap">@tender.Description</p>
    <details><summary>Terms</summary><p style="white-space:pre-wrap">@tender.Terms</p></details>
</section>
<section class="surface detail-card mb-3"><h2>Committee</h2>
@if (tender.CommitteeMembers.Count == 0) { <p class="subtle mb-0">No members assigned.</p> }
else { <ul class="mb-0">@foreach (var member in tender.CommitteeMembers.OrderBy(m => m.CommitteeType).ThenBy(m => m.MemberRole)) { <li>@member.EmployeeProfile.FullName · @member.MemberRole · @member.CommitteeType</li> }</ul> }
</section>
<div class="dashboard-grid">
@foreach (var (title, records) in new[] { ("Invitations", Model.Invitations), ("Submitted bids", Model.Bids) })
{
    <section class="surface directory"><div class="directory-toolbar"><h2 class="mb-0">@title</h2></div>
    @if (records.Count == 0) { <div class="empty-state">No records yet.</div> }
    else { <div class="table-responsive"><table class="directory-table"><thead><tr><th scope="col">Supplier</th><th scope="col">Status</th></tr></thead><tbody>
        @foreach (var row in records) { <tr><td>@row.Name</td><td>@row.Status</td></tr> }
    </tbody></table></div> }</section>
}
</div>
