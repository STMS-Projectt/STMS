@model AdminTenderView
@{
    var tender = Model.Tender;
    var panel = Context.Request.Query["panel"].ToString();
    var labels = new Dictionary<string, string> { ["overview"] = "Tender summary", ["committee"] = "Committee members", ["invitations"] = "Tender invitations", ["bids"] = "Submitted bids" };
    var full = !labels.TryGetValue(panel, out var label);
    ViewData["Title"] = label ?? "Tender details";
}
<a class="back-link" asp-action="Tenders"><partial name="_Icon" model='@("back")' /> @L.T("Tenders")</a>
<header class="page-heading stms-hero admin-record-hero"><div><p class="eyebrow">@L.F("Tender #{0}", tender.Id)</p><h1>@(label is null ? tender.Title : L.T(label))</h1><p>@(full ? $"{L.T(tender.Status)} · {tender.PurchaseRequisition.Department.Name}" : tender.Title)</p></div>
@if (full || panel == "overview")
{
<div class="record-action">
    <a data-workspace-dialog="details" class="record-icon-action" asp-action="RequestDetails" asp-route-id="@tender.PurchaseRequisitionId" aria-label="@L.T("View purchase request")" data-tooltip="@L.T("View purchase request")" title="@L.T("View purchase request")"><partial name="_Icon" model='@("file")' /></a>
    <a data-workspace-dialog="details" class="record-icon-action" asp-action="TenderQr" asp-route-id="@tender.Id" aria-label="@L.T("Show tender QR code")" data-tooltip="@L.T("Show tender QR code")" title="@L.T("Show tender QR code")"><partial name="_Icon" model='@("qr")' /></a>
    @if (tender.Status == "Under Evaluation" || tender.EvaluationReport != null) { <a data-workspace-dialog="details" class="record-icon-action" asp-controller="EvaluationWorkflow" asp-action="Details" asp-route-id="@tender.Id" aria-label="@L.T("View evaluation")" data-tooltip="@L.T("View evaluation")" title="@L.T("View evaluation")"><partial name="_Icon" model='@("check")' /></a> }
</div>
}
</header>
@if (full) { <partial name="_RecordQr" model='@(Url.Action("Tender", new { id = tender.Id })!)' /> }
@if (full || panel == "overview")
{
<section class="surface detail-card mb-3"><h2>@L.T("Tender information")</h2>
    <dl class="detail-grid"><div><dt>@L.T("Opens (UTC)")</dt><dd>@tender.OpenDate.ToString("dd MMM yyyy HH:mm", L.DisplayCulture)</dd></div><div><dt>@L.T("Closes (UTC)")</dt><dd>@tender.CloseDate.ToString("dd MMM yyyy HH:mm", L.DisplayCulture)</dd></div></dl>
    <p style="white-space:pre-wrap">@tender.Description</p>
    <details><summary>@L.T("Terms")</summary><p style="white-space:pre-wrap">@tender.Terms</p></details>
</section>
}
@if (full || panel == "committee")
{
<section class="surface detail-card mb-3"><h2>@L.T("Committee")</h2>
@if (tender.CommitteeMembers.Count == 0) { <p class="subtle mb-0">@L.T("No members assigned.")</p> }
else { <ul class="mb-0">@foreach (var member in tender.CommitteeMembers.OrderBy(m => m.CommitteeType).ThenBy(m => m.MemberRole)) { <li>@member.EmployeeProfile.FullName · @L.T(member.MemberRole) · @L.T(member.CommitteeType)</li> }</ul> }
</section>
}
@if (full || panel is "invitations" or "bids")
{
<div class="@(full ? "dashboard-grid" : "stack")">
@foreach (var (key, title, records) in new[] { ("invitations", "Invitations", Model.Invitations), ("bids", "Submitted bids", Model.Bids) })
{
    if (!full && panel != key) continue;
    <section class="surface directory"><div class="directory-toolbar"><h2 class="mb-0">@L.T(title)</h2></div>
    @if (records.Count == 0) { <div class="empty-state">@L.T("No records yet.")</div> }
    else
    {
        <div class="record-list">
        @foreach (var row in records)
        {
            <article class="record-card"><div class="record-name"><span class="avatar"><partial name="_Icon" model='@("supplier")' /></span><span>@row.Name</span></div>
                <dl class="record-facts"><div><dt>@L.T("Status")</dt><dd><partial name="_Status" model="row.Status" /></dd></div></dl>
                <div class="record-action">
                    @if (title == "Invitations") { <a data-workspace-dialog="details" class="record-icon-action" asp-action="InvitationDetails" asp-route-id="@row.Id" aria-label="@L.T("View invitation details")" data-tooltip="@L.T("View invitation details")" title="@L.T("View invitation details")"><partial name="_Icon" model='@("eye")' /></a> }
                    else { <a data-workspace-dialog="details" class="record-icon-action" asp-action="BidDetails" asp-route-id="@row.Id" aria-label="@L.T("View bid details")" data-tooltip="@L.T("View bid details")" title="@L.T("View bid details")"><partial name="_Icon" model='@("eye")' /></a> }
                </div>
            </article>
        }
        </div>
    }</section>
}
</div>
}
