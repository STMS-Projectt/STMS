@model SupplierProfile
@{ ViewData["Title"] = "Application documents"; }
<header class="page-heading stms-hero application-hero"><div><p class="eyebrow">SUPPLIER APPLICATION</p><h1>Application documents</h1><p>Add each PDF with its own document type and expiry date.</p></div><span class="icon-tile tone-teal"><partial name="_Icon" model='@("file")' /></span></header>
<partial name="_ApplicationSteps" model="2" />
@if (TempData["ApplicationError"] is string error) { <p class="alert alert-warning" role="alert">@error</p> }
<div class="form-shell application-shell">
    <section class="surface detail-card">
        <div class="record-section-heading">
            <div><h2>Supporting documents</h2><p>@Model.SupplierDocuments.Count in this draft</p></div>
            <a asp-action="AddDocument" data-workspace-dialog class="btn btn-primary"><partial name="_Icon" model='@("plus")' /> Add a document</a>
        </div>
        @if (Model.SupplierDocuments.Count == 0)
        {
            <div class="empty-state"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("upload")' /></span><h2>No documents added yet</h2><p>Add at least one supporting PDF to submit your application.</p></div>
        }
        else
        {
            <div class="record-list record-list-inset">
                @foreach (var document in Model.SupplierDocuments.OrderByDescending(d => d.UploadedAt))
                {
                    <article class="record-card">
                        <div class="record-name"><span class="avatar"><partial name="_Icon" model='@("file")' /></span><span>@document.DocumentType<small>@(document.FileName ?? "PDF")</small></span></div>
                        <dl class="record-facts"><div><dt>Expiry date</dt><dd>@(document.ExpiryDate?.ToString("dd MMM yyyy") ?? "No expiry date")</dd></div></dl>
                        <div class="record-action">
                            <a class="record-icon-action" asp-action="DownloadDocument" asp-route-id="@document.Id" aria-label="Download @document.DocumentType" data-tooltip="Download"><partial name="_Icon" model='@("download")' /></a>
                            <form asp-action="RemoveDocument" asp-route-id="@document.Id" method="post" data-workspace-confirm="Remove this document from your draft?" onsubmit="return window.stmsWorkspaceReady || confirm(this.dataset.workspaceConfirm);"><button type="submit" class="record-icon-action record-icon-danger" aria-label="Remove @document.DocumentType" data-tooltip="Remove from draft"><partial name="_Icon" model='@("trash")' /></button></form>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
    <aside class="surface helper-card application-assist">
        <span class="icon-tile tone-teal"><partial name="_Icon" model='@("shield")' /></span><h2>Ready for review?</h2>
        <p>After submission, you can track the application and read requests for additional documents from your dashboard.</p>
        <form asp-action="SubmitApplication" method="post"><button type="submit" class="btn btn-primary" disabled="@(Model.SupplierDocuments.Count == 0)">Submit application <partial name="_Icon" model='@("arrow")' /></button></form>
    </aside>
</div>
