@using SourcingTenderSystem.Services
@model ComplianceReviewViewModel
@{
    var tender = Model.Tender;
    var now = DateTime.UtcNow;
    var canClose = tender.Status == "Open" && tender.OpenDate <= now && tender.CloseDate > now;
    ViewData["Title"] = L.T("Review & compare offers");
}
<header class="page-heading stms-hero admin-record-hero"><div><p class="eyebrow">@L.T("BID COMPLIANCE")</p><h1>@L.T("Review & compare offers")</h1></div></header>
<partial name="~/Views/Bids/_Alerts.cshtml" />

@* Tender information *@
<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">@tender.Title</h2>
        <p class="card-text">@tender.Description</p>
        <p class="card-text mb-0">
            <small class="text-muted">@L.F("Scheduled deadline: {0} (UTC) · Tender status: {1}", tender.CloseDate.ToString("yyyy-MM-dd HH:mm", L.DisplayCulture), L.T(tender.Status))</small>
        </p>
    </div>
</div>

@if (canClose)
{
    <details class="surface detail-card mb-3">
        <summary class="fw-semibold">@L.T("Close tender early")</summary>
        <p class="mt-3">@L.T("Closing now stops new submissions immediately. You can then review offers already submitted.")</p>
        <form asp-action="Close" asp-route-tenderId="@tender.Id" method="post">
            <label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="confirmClose" value="true" required /> @L.T("I confirm that bidding should end now.")</label>
            <button class="btn btn-danger" type="submit">@L.T("Close")</button>
        </form>
    </details>
}
@if (!Model.TenderIsClosed)
{
    <div class="alert alert-info" role="status">@L.F("Tender status: {0}. Compliance decisions are available after closing.", L.T(tender.Status))</div>
}
else if (Model.Bids.Count > 0)
{
    var waiting = Model.Bids.Count(b => b.Status == "Pending Clarification");
    var unreviewed = Model.Bids.Count(b => b.Status == "Submitted");
    if (waiting + unreviewed > 0)
    {
        <p class="callout" role="status"><strong>@L.T("Compliance still in progress.")</strong> @unreviewed to review · @waiting awaiting clarification. Only bids marked compliant are included in evaluation.</p>
    }
}
@if (Model.MixedCurrencies)
{
    <div class="alert alert-warning" role="alert">@L.T("Older bids are shown in their original currencies. Prices are not compared across currencies.")</div>
}

@if (tender.Status is "Draft" or "Published" or "Open")
{
    <p class="subtle">@L.T("Offers remain sealed until the tender is closed.")</p>
}
else if (Model.Bids.Count == 0)
{
    <p class="text-muted">@L.T("This tender has no submitted bids.")</p>
}
else
{
    <p class="text-muted">@L.T(Model.MixedCurrencies ? "One column per bid, sorted by total price within each currency (lowest first)." : "One column per bid, sorted by total price (lowest first).")</p>

    @* Side-by-side table: rows = information, columns = bids *@
    <div class="table-responsive mb-4">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col">@L.T("Supplier")</th>
                    @foreach (var bid in Model.Bids)
                    {
                        <th scope="col">
                            @bid.SupplierProfile.CompanyName
                            <br /><small class="text-muted fw-normal">@L.F("Bid #{0}", bid.Id)</small>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">@L.T("Status")</th>
                    @foreach (var bid in Model.Bids)
                    {
                        <td><partial name="~/Views/Bids/_StatusBadge.cshtml" model="bid.Status" /></td>
                    }
                </tr>
                <tr>
                    <th scope="row">@L.T("Total price")</th>
                    @foreach (var bid in Model.Bids)
                    {
                        <td><strong>@bid.TotalPrice.ToString("N2") @bid.Currency</strong></td>
                    }
                </tr>
                <tr>
                    <th scope="row">@L.T("Delivery")</th>
                    @foreach (var bid in Model.Bids)
                    {
                        <td>@L.F("{0} days", bid.DeliveryDays)</td>
                    }
                </tr>
                <tr>
                    <th scope="row">@L.T("Offer validity")</th>
                    @foreach (var bid in Model.Bids)
                    {
                        <td>@L.F("{0} days", bid.ValidityDays)</td>
                    }
                </tr>
                <tr>
                    <th scope="row">@L.T("Submitted (UTC)")</th>
                    @foreach (var bid in Model.Bids)
                    {
                        <td>@(bid.SubmittedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                    }
                </tr>

                @* One row per requested item: the unit price of every bid *@
                @foreach (var item in Model.RequestedItems)
                {
                    <tr>
                        <th scope="row">
                            @item.ItemName
                            <br /><small class="text-muted fw-normal">@item.Quantity @item.Unit</small>
                        </th>
                        @foreach (var bid in Model.Bids)
                        {
                            var bidItem = bid.BidItems.FirstOrDefault(bi => bi.PurchaseRequisitionItemId == item.Id);
                            <td>
                                @if (bidItem == null)
                                {
                                    <span class="badge bg-warning text-dark">@L.T("No price")</span>
                                }
                                else
                                {
                                    <span>@bidItem.UnitPrice.ToString("N2")</span>
                                    <small class="text-muted">× @bidItem.Quantity = @((bidItem.UnitPrice * bidItem.Quantity).ToString("N2"))</small>
                                    @if (bidItem.Notes != null)
                                    {
                                        <br /><small class="text-muted">@bidItem.Notes</small>
                                    }
                                }
                            </td>
                        }
                    </tr>
                }

                <tr>
                    <th scope="row">@L.T("Documents")</th>
                    @foreach (var bid in Model.Bids)
                    {
                        <td>
                            @if (bid.BidDocuments.Count == 0)
                            {
                                <span class="text-muted">@L.T("None")</span>
                            }
                            else
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var document in bid.BidDocuments)
                                    {
                                        <li>
                                            <a asp-controller="BidDocuments" asp-action="Download" asp-route-id="@document.Id">@L.T(document.DocumentType)</a>
                                            <small class="text-muted">@document.FileName</small>
                                        </li>
                                    }
                                </ul>
                            }
                        </td>
                    }
                </tr>
                <tr>
                    <th scope="row">@L.T("Compliance notes")</th>
                    @foreach (var bid in Model.Bids)
                    {
                        <td>@(bid.ComplianceNotes ?? "—")</td>
                    }
                </tr>

                @if (Model.TenderIsClosed)
                {
                    <tr>
                        <th scope="row">@L.T("Actions")</th>
                        @foreach (var bid in Model.Bids)
                        {
                            <td>
                                @if (bid.Status == "Pending Clarification" && bid.ComplianceClarification is { } clarification)
                                {
                                    <a data-workspace-dialog="details" asp-controller="Clarifications" asp-action="Details" asp-route-id="@clarification.Id">@L.F("Clarification: {0}", L.T(clarification.Status))</a>
                                }
                                @if (bid.Status == "Submitted" || bid.Status == "Pending Clarification" && bid.ComplianceClarification?.Status == "Resolved")
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        <form asp-action="MarkCompliant" asp-route-id="@bid.Id" method="post" asp-antiforgery="true"
                                              data-workspace-confirm="@L.T("Mark this bid as Compliant?")" onsubmit="return window.stmsWorkspaceReady || confirm(this.dataset.workspaceConfirm);">
                                            <button type="submit" class="btn btn-sm btn-success">@L.T("Compliant")</button>
                                        </form>
                                        <a data-workspace-dialog class="btn btn-sm btn-outline-danger" asp-action="MarkNonCompliant" asp-route-id="@bid.Id">@L.T("Non-compliant")</a>
                                        @* Placeholder: clarification requests belong to Person 4 (ClarificationsController).
                                           Replace this with the real link when it is ready. *@
                                        <a class="btn btn-sm btn-outline-secondary disabled" aria-disabled="true">@L.T("Request clarification")</a>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Send to evaluation: only while the tender is Closed *@
@if (Model.TenderIsClosed)
{
    <div class="card mb-3">
        <div class="card-header">@L.F("Send to evaluation · Round {0} of {1}", tender.Counter, TenderRules.MaxRounds)</div>
        <p class="px-3 pt-3">@L.F("Eligible suppliers: {0} · Required: {1}.", ViewBag.EligibleSuppliers, TenderRules.Minimum(tender))
        @if (!TenderRules.CanEvaluate(tender, (int)ViewBag.EligibleSuppliers))
        {
            <span>@L.T("The bid minimum has not been met.")</span>
            <a data-workspace-dialog="details" asp-controller="Tenders" asp-action="Details" asp-route-id="@tender.Id" asp-route-panel="rounds">@L.T("View bidding rounds")</a>
        }</p>
        <ul class="list-group list-group-flush">
            <li class="list-group-item">
                @if (Model.SubmittedCount == 0)
                {
                    <span class="badge bg-success">@L.T("OK")</span>
                }
                else
                {
                    <span class="badge bg-danger">@L.T("Missing")</span>
                }
                @L.F("All bids checked ({0} not checked)", Model.SubmittedCount)
            </li>
            <li class="list-group-item">
                @if (Model.CompliantCount > 0)
                {
                    <span class="badge bg-success">@L.T("OK")</span>
                }
                else
                {
                    <span class="badge bg-danger">@L.T("Missing")</span>
                }
                @L.F("At least one compliant bid ({0} compliant)", Model.CompliantCount)
            </li>
        </ul>
        <div class="card-body">
            @if (Model.CanSendToEvaluation)
            {
                <form asp-action="SendToEvaluation" asp-route-tenderId="@tender.Id" method="post" asp-antiforgery="true"
                      data-workspace-confirm="@L.T("Send this tender to evaluation? The compliance check will be closed.")" onsubmit="return window.stmsWorkspaceReady || confirm(this.dataset.workspaceConfirm);">
                    <button type="submit" class="btn btn-primary">@L.T("Assign evaluation committee")</button>
                </form>
            }
            else
            {
                <button type="button" class="btn btn-primary" disabled>@L.T("Assign evaluation committee")</button>
            }
        </div>
    </div>
}

<a class="btn btn-outline-secondary back-link" asp-action="Pending">@L.T("Back to compliance list")</a>

<section class="surface detail-card mt-3">
    <h2>@L.T("Clarifications")</h2>
    <div class="button-row">
        <a class="btn btn-outline-secondary" asp-controller="Clarifications" asp-action="Index" asp-route-kind="tender" asp-route-recordId="@tender.Id">@L.T("Tender history")</a>
        @foreach (var bid in Model.Bids)
        {
            <a data-workspace-dialog="details" class="btn btn-outline-secondary" asp-controller="Clarifications" asp-action="Index" asp-route-kind="bid" asp-route-recordId="@bid.Id">@L.F("Bid #{0} history", bid.Id)</a>
            @if (ViewData["CanRequestBidDocuments"] is true && bid.SubmittedAt.HasValue && bid.Status is ("Submitted" or "Pending Clarification"))
            {
                <a data-workspace-dialog class="btn btn-outline-secondary" asp-controller="Clarifications" asp-action="Create" asp-route-kind="bid" asp-route-recordId="@bid.Id"><partial name="_Icon" model='@("file")' /> @L.F("Request a PDF for bid #{0}", bid.Id)</a>
            }
        }
    </div>
</section>
