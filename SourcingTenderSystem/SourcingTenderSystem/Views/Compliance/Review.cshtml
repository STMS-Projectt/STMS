@using SourcingTenderSystem.Services
@model ComplianceReviewViewModel
@{
    var tender = Model.Tender;
    var now = DateTime.UtcNow;
    var canClose = tender.Status == "Open" && tender.OpenDate <= now && tender.CloseDate > now;
    ViewData["Title"] = L.T("Review & compare offers");
    var waiting = Model.Bids.Count(b => b.Status == "Pending Clarification");
    var unreviewed = Model.Bids.Count(b => b.Status == "Submitted");
    var nonCompliant = Model.Bids.Count(b => b.Status == "Non-Compliant");
    var eligible = (int)ViewBag.EligibleSuppliers;
}
<div class="pr-create prd cr">
<header class="pr-hero prd-hero">
    <span class="pr-hero-icon"><partial name="_Icon" model='@("shield")' /></span>
    <div>
        <p class="eyebrow">@L.T("BID COMPLIANCE")</p>
        <h1>@L.T("Review & compare offers")</h1>
        <p class="prd-meta">
            <span><partial name="_Icon" model='@("briefcase")' /> @tender.Title</span>
            <span><partial name="_Icon" model='@("clock")' /> @L.F("Scheduled deadline: {0} (UTC)", tender.CloseDate.ToString("dd MMM yyyy · HH:mm", L.DisplayCulture))</span>
        </p>
    </div>
    <div class="prd-status"><span class="tm-status"><i></i>@L.T(tender.Status)</span></div>
    @if (Model.Bids.Count > 0)
    {
        <div class="cm-stats">
            <div><strong>@Model.Bids.Count</strong><span>@L.T("Bids")</span></div>
            <div class="@(unreviewed > 0 ? "is-hot" : "")"><strong>@unreviewed</strong><span>@L.T("To review")</span></div>
            <div><strong>@waiting</strong><span>@L.T("Awaiting clarification")</span></div>
            <div><strong>@Model.CompliantCount</strong><span>@L.T("Compliant")</span></div>
        </div>
    }
</header>
@if (TempData["Msg"] != null) { <div class="alert alert-success tm-alert" role="status"><partial name="_Icon" model='@("check")' /> @TempData["Msg"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger tm-alert" role="alert"><partial name="_Icon" model='@("warning")' /> @TempData["Error"]</div> }

@if (!string.IsNullOrWhiteSpace(tender.Description))
{
    <p class="cr-desc">@tender.Description</p>
}

@if (canClose)
{
    <details class="pr-card prd-card mb-3 cr-close">
        <summary><partial name="_Icon" model='@("pause")' /> @L.T("Close tender early")</summary>
        <p class="mt-3">@L.T("Closing now stops new submissions immediately. You can then review offers already submitted.")</p>
        <form asp-action="Close" asp-route-tenderId="@tender.Id" method="post">
            <label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="confirmClose" value="true" required /> @L.T("I confirm that bidding should end now.")</label>
            <button class="btn tm-btn tm-btn-danger" type="submit">@L.T("Close")</button>
        </form>
    </details>
}
@if (!Model.TenderIsClosed)
{
    <p class="prd-note mb-3"><span>@L.F("Tender status: {0}. Compliance decisions are available after closing.", L.T(tender.Status))</span></p>
}
else if (Model.Bids.Count > 0 && waiting + unreviewed > 0)
{
    <div class="cm-alert"><span class="pr-badge"><partial name="_Icon" model='@("warning")' /></span><div><strong>@L.T("Compliance still in progress.")</strong><p>@L.F("{0} to review · {1} awaiting clarification. Only bids marked compliant are included in evaluation.", unreviewed, waiting)</p></div></div>
}
@if (Model.MixedCurrencies)
{
    <p class="prd-note is-returned mb-3"><span>@L.T("Older bids are shown in their original currencies. Prices are not compared across currencies.")</span></p>
}

<div class="cr-layout">
<div class="cr-main">
<section class="pr-card prd-card">
    <div class="prd-card-head">
        <div class="pr-section-head mb-0"><span class="pr-badge"><partial name="_Icon" model='@("chart")' /></span><div><h2>@L.T("Offer comparison")</h2>
            <p>@L.T(Model.MixedCurrencies ? "One column per bid, sorted by total price within each currency (lowest first)." : "One column per bid, sorted by total price (lowest first).")</p></div></div>
    </div>
@if (tender.Status is "Draft" or "Published" or "Open")
{
    <div class="prd-empty"><span class="pr-badge"><partial name="_Icon" model='@("shield")' /></span><h3>@L.T("Offers remain sealed until the tender is closed.")</h3></div>
}
else if (Model.Bids.Count == 0)
{
    <div class="prd-empty"><span class="pr-badge"><partial name="_Icon" model='@("inbox")' /></span><h3>@L.T("This tender has no submitted bids.")</h3></div>
}
else
{
    var lowestPrice = Model.MixedCurrencies ? (decimal?)null : Model.Bids.Min(b => b.TotalPrice);
<div class="table-responsive compare-wrap cr-table">
        <table class="table align-middle compare-table">
            <thead>
                <tr>
                    <th scope="col">@L.T("Supplier")</th>
                    @foreach (var bid in Model.Bids)
                    {
                        var company = bid.SupplierProfile.CompanyName;
                        <th scope="col">
                            <div class="compare-supplier">
                                <span class="compare-avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(company) ? "?" : company.Trim()[0].ToString().ToUpperInvariant())</span>
                                <span>@company<small>@L.F("Bid #{0}", bid.Id)</small></span>
                            </div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">@L.T("Status")</th>
                    @foreach (var bid in Model.Bids)
                    {
                        <td><partial name="~/Views/Bids/_StatusBadge.cshtml" model="bid.Status" /></td>
                    }
                </tr>
                <tr class="cr-group"><th colspan="@(Model.Bids.Count + 1)">@L.T("Offer")</th></tr>
                <tr class="compare-total">
                    <th scope="row">@L.T("Total price")</th>
                    @foreach (var bid in Model.Bids)
                    {
                        <td class="@(bid.TotalPrice == lowestPrice ? "is-lowest" : "")"><strong>@bid.TotalPrice.ToString("N2") <span>@bid.Currency</span></strong>@if (bid.TotalPrice == lowestPrice && Model.Bids.Count > 1) { <span class="compare-flag">@L.T("Lowest")</span> }</td>
                    }
                </tr>
                <tr>
                    <th scope="row">@L.T("Final cost (with tax)")</th>
                    @foreach (var bid in Model.Bids)
                    {
                        <td><strong>@bid.TotalWithTax.ToString("N2")</strong> <small class="text-muted">@bid.Currency</small>@if (!bid.IncludesSalesTax) { <small class="cr-muted d-block">@L.T("Tax not added")</small> }</td>
                    }
                </tr>
                <tr>
                    <th scope="row">@L.T("Legal warranty")</th>
                    @foreach (var bid in Model.Bids)
                    {
                        <td>@(bid.LegalWarrantyMonths is int m ? L.F("{0} months", m) : "—")</td>
                    }
                </tr>
                <tr>
                    <th scope="row">@L.T("Bank guarantee")</th>
                    @foreach (var bid in Model.Bids)
                    {
                        <td>@if (bid.HasBankGuarantee) { <span>@bid.BankName</span><small class="cr-muted d-block">@bid.BankGuaranteeAmount?.ToString("N2") @bid.Currency · @bid.BankGuaranteeExpiry?.ToString("dd MMM yyyy", L.DisplayCulture)</small> } else { <span class="text-muted">—</span> }</td>
                    }
                </tr>
                <tr class="cr-group"><th colspan="@(Model.Bids.Count + 1)">@L.T("Schedule")</th></tr>
                <tr>
                    <th scope="row">@L.T("Delivery")</th>
                    @foreach (var bid in Model.Bids)
                    {
                        <td>@L.F("{0} days", bid.DeliveryDays)</td>
                    }
                </tr>
                <tr>
                    <th scope="row">@L.T("Offer validity")</th>
                    @foreach (var bid in Model.Bids)
                    {
                        <td>@L.F("{0} days", bid.ValidityDays)</td>
                    }
                </tr>
                <tr>
                    <th scope="row">@L.T("Submitted (UTC)")</th>
                    @foreach (var bid in Model.Bids)
                    {
                        <td>@(bid.SubmittedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                    }
                </tr>

                @if (Model.RequestedItems.Count > 0) { <tr class="cr-group"><th colspan="@(Model.Bids.Count + 1)">@L.T("Item prices")</th></tr> }
                @* One row per requested item: the unit price of every bid *@
                @foreach (var item in Model.RequestedItems)
                {
                    <tr>
                        <th scope="row" class="compare-item">
                            @item.ItemName
                            <small>@item.Quantity @item.Unit</small>
                        </th>
                        @foreach (var bid in Model.Bids)
                        {
                            var bidItem = bid.BidItems.FirstOrDefault(bi => bi.PurchaseRequisitionItemId == item.Id);
                            <td>
                                @if (bidItem == null)
                                {
                                    <span class="badge bg-warning text-dark">@L.T("No price")</span>
                                }
                                else
                                {
                                    <div class="compare-line"><strong>@bidItem.UnitPrice.ToString("N2")</strong><small>× @bidItem.Quantity = @((bidItem.UnitPrice * bidItem.Quantity).ToString("N2"))</small></div>
                                    @if (bidItem.Notes != null)
                                    {
                                        <small class="compare-note">@bidItem.Notes</small>
                                    }
                                }
                            </td>
                        }
                    </tr>
                }

                <tr class="cr-group"><th colspan="@(Model.Bids.Count + 1)">@L.T("Documents and compliance")</th></tr>
                <tr>
                    <th scope="row">@L.T("Documents")</th>
                    @foreach (var bid in Model.Bids)
                    {
                        <td>
                            @if (bid.BidDocuments.Count == 0)
                            {
                                <span class="text-muted">@L.T("None")</span>
                            }
                            else
                            {
                                <ul class="compare-docs">
                                    @foreach (var document in bid.BidDocuments)
                                    {
                                        <li>
                                            <a asp-controller="BidDocuments" asp-action="Download" asp-route-id="@document.Id" title="@document.FileName">
                                                <span class="compare-doc-icon" aria-hidden="true"><partial name="_Icon" model='@("file")' /></span>
                                                <span><strong>@L.T(document.DocumentType)</strong><small>@document.FileName</small></span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                        </td>
                    }
                </tr>
                <tr>
                    <th scope="row">@L.T("Compliance notes")</th>
                    @foreach (var bid in Model.Bids)
                    {
                        <td class="@(bid.ComplianceNotes == null ? "compare-empty" : "")">@(bid.ComplianceNotes ?? "—")</td>
                    }
                </tr>

                @if (Model.TenderIsClosed)
                {
                    <tr class="compare-actions">
                        <th scope="row">@L.T("Actions")</th>
                        @foreach (var bid in Model.Bids)
                        {
                            <td>
                                @if (bid.Status == "Pending Clarification" && bid.ComplianceClarification is { } clarification)
                                {
                                    <a data-workspace-dialog="details" asp-controller="Clarifications" asp-action="Details" asp-route-id="@clarification.Id">@L.F("Clarification: {0}", L.T(clarification.Status))</a>
                                }
                                @if (bid.Status == "Submitted" || bid.Status == "Pending Clarification" && bid.ComplianceClarification?.Status == "Resolved")
                                {
                                    <div class="compare-action-buttons">
                                        <form asp-action="MarkCompliant" asp-route-id="@bid.Id" method="post" asp-antiforgery="true"
                                              data-workspace-confirm="@L.T("Mark this bid as Compliant?")" onsubmit="return window.stmsWorkspaceReady || confirm(this.dataset.workspaceConfirm);">
                                            <button type="submit" class="btn btn-sm btn-success"><partial name="_Icon" model='@("check")' /> @L.T("Compliant")</button>
                                        </form>
                                        <a data-workspace-dialog class="btn btn-sm btn-outline-danger" asp-action="MarkNonCompliant" asp-route-id="@bid.Id"><partial name="_Icon" model='@("close")' /> @L.T("Non-compliant")</a>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
</section>
</div>

<aside class="cr-side prd-side">
@if (Model.TenderIsClosed)
{
    <section class="rv-decision">
        <div class="pr-section-head"><span class="pr-badge"><partial name="_Icon" model='@("users")' /></span><div><h2>@L.T("Send to evaluation")</h2><p>@L.F("Round {0} of {1}", tender.Counter, TenderRules.MaxRounds) · @L.F("Eligible suppliers: {0} · Required: {1}.", eligible, TenderRules.Minimum(tender))</p></div></div>
        <ul class="bd-checklist">
            <li class="@(Model.SubmittedCount == 0 ? "is-ok" : "")"><span class="bd-tick"><partial name="_Icon" model='@(Model.SubmittedCount == 0 ? "check" : "close")' /></span>@L.F("All bids checked ({0} not checked)", Model.SubmittedCount)</li>
            <li class="@(Model.CompliantCount > 0 ? "is-ok" : "")"><span class="bd-tick"><partial name="_Icon" model='@(Model.CompliantCount > 0 ? "check" : "close")' /></span>@L.F("At least one compliant bid ({0} compliant)", Model.CompliantCount)</li>
            <li class="@(TenderRules.CanEvaluate(tender, eligible) ? "is-ok" : "")"><span class="bd-tick"><partial name="_Icon" model='@(TenderRules.CanEvaluate(tender, eligible) ? "check" : "close")' /></span>@L.F("Eligible suppliers: {0} · Required: {1}.", eligible, TenderRules.Minimum(tender))</li>
        </ul>
        @if (!TenderRules.CanEvaluate(tender, eligible))
        {
            <p class="rv-hint">@L.T("The bid minimum has not been met.") <a data-workspace-dialog="details" asp-controller="Tenders" asp-action="Details" asp-route-id="@tender.Id" asp-route-panel="rounds">@L.T("View bidding rounds")</a></p>
        }
        @if (Model.CanSendToEvaluation)
        {
            <form asp-action="SendToEvaluation" asp-route-tenderId="@tender.Id" method="post" asp-antiforgery="true"
                  data-workspace-confirm="@L.T("Send this tender to evaluation? The compliance check will be closed.")" onsubmit="return window.stmsWorkspaceReady || confirm(this.dataset.workspaceConfirm);">
                <button type="submit" class="btn btn-primary rv-main w-100 d-inline-flex justify-content-center gap-2"><partial name="_Icon" model='@("users")' /> @L.T("Assign evaluation committee")</button>
            </form>
        }
        else
        {
            <button type="button" class="btn btn-primary w-100" disabled>@L.T("Assign evaluation committee")</button>
        }
    </section>
}
    <div class="prd-links">
        <h2>@L.T("Clarifications")</h2>
        <a class="prd-link" asp-controller="Clarifications" asp-action="Index" asp-route-kind="tender" asp-route-recordId="@tender.Id"><partial name="_Icon" model='@("clock")' /> @L.T("Tender history")</a>
        @foreach (var bid in Model.Bids)
        {
            <a data-workspace-dialog="details" class="prd-link" asp-controller="Clarifications" asp-action="Index" asp-route-kind="bid" asp-route-recordId="@bid.Id"><partial name="_Icon" model='@("mail")' /> @L.F("Bid #{0} history", bid.Id) <small class="cr-muted">· @bid.SupplierProfile.CompanyName</small></a>
            @if (ViewData["CanRequestBidDocuments"] is true && bid.SubmittedAt.HasValue && bid.Status is ("Submitted" or "Pending Clarification"))
            {
                <a data-workspace-dialog class="prd-link" asp-controller="Clarifications" asp-action="Create" asp-route-kind="bid" asp-route-recordId="@bid.Id"><partial name="_Icon" model='@("file")' /> @L.F("Request a PDF for bid #{0}", bid.Id)</a>
            }
        }
        <a class="prd-link td-back" asp-action="Pending"><partial name="_Icon" model='@("back")' /> @L.T("Back to compliance list")</a>
    </div>
</aside>
</div>
</div>
