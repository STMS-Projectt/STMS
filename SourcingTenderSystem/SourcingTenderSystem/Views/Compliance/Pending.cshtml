@model List<CompliancePendingRow>
@{
    ViewData["Title"] = "Compliance check";
}
<h1>Compliance check</h1>
<partial name="~/Views/Bids/_Alerts.cshtml" />
<p class="text-muted">Open and closed tenders. Close bidding before reviewing offers and sending the tender to evaluation.</p>

@if (Model.Count == 0)
{
    <p class="text-muted">There are no tenders in the compliance queue.</p>
}
else
{
    <section class="surface directory dept-directory" data-directory>
    <partial name="_ListFilters" model='@("Search compliance queue", Model.Select(r => r.Tender.Status))' />
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Tender</th>
                    <th scope="col">Deadline (UTC)</th>
                    <th scope="col" class="text-center">Not checked</th>
                    <th scope="col" class="text-center">Compliant</th>
                    <th scope="col" class="text-center">Non-Compliant</th>
                    <th scope="col">State</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr data-status="@row.Tender.Status">
                        <td>@row.Tender.Title</td>
                        <td>@row.Tender.CloseDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-center">@(row.Tender.Status == "Open" ? "—" : row.SubmittedCount.ToString())</td>
                        <td class="text-center">@(row.Tender.Status == "Open" ? "—" : row.CompliantCount.ToString())</td>
                        <td class="text-center">@(row.Tender.Status == "Open" ? "—" : row.NonCompliantCount.ToString())</td>
                        <td>
                            @if (row.Tender.Status == "Open") { <span class="status-pill status-neutral">Open</span> }
                            else if (row.ReadyForEvaluation)
                            {
                                <span class="badge bg-success">Ready for evaluation</span>
                            }
                            else if (row.SubmittedCount > 0)
                            {
                                <span class="badge bg-warning text-dark">@row.SubmittedCount to check</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">No compliant bid</span>
                            }
                        </td>
                        <td>
                            <a class="btn btn-sm btn-primary" asp-action="Review" asp-route-tenderId="@row.Tender.Id">Review &amp; compare</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_ListFilterEmpty" />
    </section>
}
