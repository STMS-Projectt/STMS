@using SourcingTenderSystem.Security
@if (User.Identity?.IsAuthenticated == true)
{
    <form asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="@(User.IsInRole(Roles.Admin) ? "side-link sign-out" : "btn btn-outline-secondary")"><partial name="_Icon" model='@("logout")' /> Sign out</button>
    </form>
}
