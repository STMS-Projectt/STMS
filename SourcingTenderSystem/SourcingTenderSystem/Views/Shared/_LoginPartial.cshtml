@using SourcingTenderSystem.Security
<ul class="navbar-nav">
@if (User.Identity?.IsAuthenticated == true)
{
    if (User.IsInRole(Roles.Admin))
    {
        <li class="nav-item"><a class="nav-link" asp-controller="AdminDashboard" asp-action="Index">Administration</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Departments" asp-action="Index">Departments</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Employees" asp-action="Index">Employees</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Suppliers" asp-action="Index">Suppliers</a></li>
    }
    else if (!Roles.EmployeeRoles.Any(User.IsInRole))
    {
        <li class="nav-item"><a class="nav-link" asp-controller="SupplierRegistration" asp-action="RegistrationStatus">Registration status</a></li>
    }
    <li class="nav-item">
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="nav-link btn btn-link">Sign out</button>
        </form>
    </li>
}
else
{
    <li class="nav-item"><a class="nav-link" asp-controller="SupplierRegistration" asp-action="Register">Supplier registration</a></li>
    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
}
</ul>
