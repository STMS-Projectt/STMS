@using SourcingTenderSystem.Security
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject SourcingTenderSystem.Data.ApplicationDbContext WorkspaceDb

@{
    var admin = User.IsInRole(Roles.Admin);
    var sourcing = !admin && User.IsInRole(Roles.SourcingOfficer);
    var committee = !admin && !sourcing && (User.IsInRole(Roles.TechnicalCommittee) || User.IsInRole(Roles.FinancialCommittee) || User.IsInRole(Roles.SourcingManager) || User.IsInRole(Roles.TopCommittee) || ViewContext.RouteData.Values["controller"]?.ToString() == "CommitteeReviews" && User.IsInRole("RequestingDepartment"));
    var department = !admin && !sourcing && !committee && User.IsInRole("RequestingDepartment");
    var signedIn = User.Identity?.IsAuthenticated == true;
    var supplierStatus = signedIn && !Roles.EmployeeRoles.Any(User.IsInRole)
        ? await WorkspaceDb.SupplierProfiles.AsNoTracking().Where(s => s.UserId == User.FindFirstValue(ClaimTypes.NameIdentifier))
            .Select(s => s.Status).SingleOrDefaultAsync()
        : null;
    var supplier = supplierStatus != null;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    if (controller == "Account" && (action == "BiometricSetup" || action == "BiometricVerify" || action == "Login"))
    {
        admin = false;
        sourcing = false;
        committee = false;
        department = false;
        supplier = false;
    }

    var workspace = admin || department || sourcing || supplier || committee;
    var workspaceKey = admin ? "admin" : department ? "department" : sourcing ? "sourcing" : supplier ? "supplier" : committee ? "committee" : "portal";
    var fragment = workspace && Context.Request.Headers["X-STMS-Fragment"] == "workspace";
    Context.Response.Headers.Append("Vary", "X-STMS-Fragment");
    if (fragment) Context.Response.Headers.CacheControl = "private, no-store";
    var title = ViewData["Title"]?.ToString();
}

@if (!fragment) { @Html.Raw("<!DOCTYPE html><html lang='en'>") }
@if (!fragment)
{
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@title · Sourcing Desk</title>
    <link rel="icon" type="image/svg+xml" href="~/sourcing-desk.svg" asp-append-version="true">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

    @if (department)
    {
        <link rel="stylesheet" href="~/css/department.css" asp-append-version="true">
    }
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true">
</head>
}

@if (!fragment)
{
    var classes = (workspace ? "workspace" : "portal") + (department ? " department-workspace" : "");
    @Html.Raw("<body class='" + classes + "'>")
}
<div data-workspace-frame="@workspaceKey" data-page-title="@title · Sourcing Desk" hidden></div>
    <a class="skip-link" href="#main">Skip to content</a>

    @if (sourcing)
    {
        <partial name="_SourcingNavigation" />
    }
    else if (committee)
    {
        <partial name="_CommitteeNavigation" />
    }
    else if (department)
    {
        <partial name="_DepartmentNavigation" />
    }
    else if (supplier)
    {
        <partial name="_SupplierNavigation" model="supplierStatus" />
    }
    else if (admin)
    {
        <aside class="sidebar" id="workspace-nav" aria-label="Administration">
            <a class="brand" asp-controller="AdminDashboard" asp-action="Index">
                <span class="brand-mark">
                    <partial name="_Icon" model='@("brand")' />
                </span>
                <span>Sourcing Desk<small>Administration</small></span>
            </a>

            <div class="side-nav">
                <span class="nav-caption">WORKSPACE</span>

                @foreach (var item in new[]
                {
                    ("AdminDashboard", "Overview", "dashboard"),
                    ("Departments", "Departments", "building"),
                    ("Employees", "Employees", "users"),
                    ("Suppliers", "Suppliers", "supplier")
                })
                {
                    <a class="side-link @(controller == item.Item1 ? "is-current" : "")"
                       aria-current="@(controller == item.Item1 ? "page" : null)"
                       asp-controller="@item.Item1"
                       asp-action="Index">
                        <partial name="_Icon" model="item.Item3" />
                        @item.Item2
                    </a>
                }

                <partial name="~/Views/Profile/_ProfileNav.cshtml" />
            </div>

            <div class="side-bottom">
                <a class="side-link" asp-controller="Home" asp-action="Index">
                    <partial name="_Icon" model='@("arrow")' />
                    Public portal
                </a>

                <partial name="_LoginPartial" />
            </div>
        </aside>

        <button type="button"
                class="nav-scrim"
                data-nav-close
                tabindex="-1"
                aria-label="Close navigation"
                hidden>
        </button>
    }

    <div class="site-body">
        @if (department || sourcing || supplier || committee)
        {
            <header class="workspace-bar">
                <div class="bar-context">
                    <button class="btn btn-outline-secondary menu-toggle"
                            type="button"
                            data-nav-toggle
                            aria-controls="workspace-nav"
                            aria-expanded="false"
                            aria-label="Open navigation">
                        <partial name="_Icon" model='@("menu")' />
                    </button>

                    <span class="context-root">@(sourcing ? "Sourcing" : supplier ? "Supplier" : committee ? "Evaluation" : "Department")</span>
                    <span class="context-separator" aria-hidden="true">/</span>
                    <strong>@title</strong>
                </div>

                <div class="bar-profile">
                    <partial name="_ProfileAvatar" />
                    <span>
                        <strong>@(sourcing ? "Sourcing officer" : supplier ? "Supplier" : committee ? "Committee reviewer" : "Department employee")</strong>
                        <small title="@User.Identity?.Name">@User.Identity?.Name</small>
                    </span>
                </div>
            </header>
        }
        else if (admin)
        {
            <header class="workspace-bar">
                <div class="bar-context">
                    <button class="btn btn-outline-secondary menu-toggle"
                            type="button"
                            data-nav-toggle
                            aria-controls="workspace-nav"
                            aria-expanded="false"
                            aria-label="Open navigation">
                        <partial name="_Icon" model='@("menu")' />
                    </button>

                    <span class="context-root">Administration</span>
                    <span class="context-separator" aria-hidden="true">/</span>
                    <strong>@(controller == "AdminDashboard" ? "Overview" : title ?? controller)</strong>
                </div>

                <div class="bar-profile">
                    <partial name="_ProfileAvatar" />
                    <span>
                        <strong>Administrator</strong>
                        <small title="@User.Identity?.Name">@User.Identity?.Name</small>
                    </span>
                </div>
            </header>
        }
        else
        {
            <header class="portal-bar">
                <div class="portal-bar-inner">
                    <a class="brand" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark">
                            <partial name="_Icon" model='@("brand")' />
                        </span>
                        <span>Sourcing Desk<small>Supplier portal</small></span>
                    </a>

                    <nav class="portal-nav" aria-label="Account">
                        @if (signedIn && !Roles.EmployeeRoles.Any(User.IsInRole))
                        {
                            <a class="portal-link"
                               asp-controller="SupplierRegistration"
                               asp-action="RegistrationStatus">My application</a>
                        }

                        @if (!signedIn)
                        {
                            <a class="portal-link"
                               asp-controller="Account"
                               asp-action="Login">Sign in</a>

                            <a class="btn btn-primary portal-register"
                               asp-controller="SupplierRegistration"
                               asp-action="Register">Supplier registration</a>
                        }

                        <partial name="_LoginPartial" />
                    </nav>
                </div>
            </header>
        }

        <main id="main" class="page-content" tabindex="-1">
            @if (TempData["Message"] is string message)
            {
                <div class="notice notice-success" role="status">
                    <partial name="_Icon" model='@("check")' />
                    <span>@message</span>
                    <button class="icon-button"
                            type="button"
                            data-dismiss-notice
                            aria-label="Dismiss notification">
                        <partial name="_Icon" model='@("close")' />
                    </button>
                </div>
            }

            @RenderBody()
        </main>

        <footer class="site-footer">
            <span>Sourcing Desk</span>
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </footer>
    </div>

    @if (!fragment)
    {
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @if (signedIn) { <script src="~/js/notifications.js" asp-append-version="true" defer></script> }
        @if (workspace)
        {
            <dialog class="workspace-dialog" id="workspace-dialog" aria-labelledby="workspace-dialog-title">
                <div class="workspace-dialog-bar"><strong id="workspace-dialog-title">Edit record</strong><button type="button" class="icon-button" data-dialog-close aria-label="Close dialog"><partial name="_Icon" model='@("close")' /></button></div>
                <div class="workspace-dialog-loader" data-dialog-loader hidden role="status"><span class="workspace-spinner" aria-hidden="true"></span><span data-dialog-loader-label>Loading…</span></div>
                <div data-dialog-content></div>
            </dialog>
            <dialog id="workspace-confirm" class="workspace-dialog workspace-confirm" aria-labelledby="workspace-confirm-title">
                <form method="dialog" class="p-4">
                    <h2 id="workspace-confirm-title">Confirm action</h2>
                    <p class="mt-2" data-confirm-question></p>
                    <div class="button-row justify-content-end">
                        <button class="btn btn-outline-secondary" value="cancel" autofocus>Cancel</button>
                        <button class="btn btn-primary" value="confirm">Continue</button>
                    </div>
                </form>
            </dialog>
            <div class="workspace-progress" hidden role="status" aria-label="Loading"></div>
            <div class="visually-hidden" aria-live="polite" data-workspace-status></div>
            <script src="~/js/workspace.js" asp-append-version="true" defer></script>
        }
    }
    <div data-page-scripts hidden>@await RenderSectionAsync("Scripts", required: false)</div>
@if (!fragment) { @Html.Raw("</body></html>") }
