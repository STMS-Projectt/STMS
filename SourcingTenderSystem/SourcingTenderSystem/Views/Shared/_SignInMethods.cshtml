@inject SourcingTenderSystem.Services.Biometrics.FaceLab FaceLab
@model SourcingTenderSystem.ViewModels.Biometrics.BiometricVerifyViewModel
@{
    var reference = Model.Manage && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier) is { } claim && FaceLab.HasReference(claim.Value);
    var first = !Model.HasFace && !Model.HasFingerprint;
    var canPhone = Model.Manage ? !Model.HasFingerprint : first || Model.HasFingerprint;
    var faceState = !FaceLab.Enabled ? ("Unavailable", "status-neutral") : !Model.Manage ? ("Verification required", "status-waiting")
        : reference ? ("Enrolled", "status-positive") : ("Not enrolled", "status-neutral");
}
<div data-bio data-manage="@(Model.Manage ? "true" : "false")" data-phone-options="@Url.Action("PhoneOptions", "Account")" data-phone="@Url.Action("Phone", "Account")">
    @Html.AntiForgeryToken()
    @if (Model.Manage)
    {
        <section class="surface detail-card face-setup mb-3" aria-labelledby="face-setup-title">
            <div class="card-heading">
                <span class="icon-tile tone-blue"><partial name="_Icon" model='@("face")' /></span>
                <span class="status-pill @faceState.Item2" data-face-badge><span></span>@faceState.Item1</span>
            </div>
            <h2 id="face-setup-title">Face Recognition Setup</h2>
            <p class="subtle">Register your face to enable camera-based sign-in.</p>
            @if (!FaceLab.Enabled)
            {
                <p class="notice notice-muted mb-0"><partial name="_Icon" model='@("warning")' /><span>Face recognition is not configured in this environment. Use your password or passkey.</span></p>
            }
            else
            {
                <div class="face-layout" data-face-lab data-mode="enroll" data-start="@Url.Action("FaceLabStart", "Account")" data-frame="@Url.Action("FaceLabCapture", "Account")" data-confirm="@Url.Action("FaceLabConfirm", "Account")">
                    <partial name="_FaceCamera" />
                    <div class="face-side">
                        <h3 class="h6">Before you start</h3>
                        <ul class="face-guidance">
                            <li>Use even, front-facing lighting.</li>
                            <li>Keep only one face in the camera guide.</li>
                            <li>Look directly at the camera, then turn slightly when asked.</li>
                            <li>Avoid movement in the background.</li>
                        </ul>
                        <label class="field" data-face-show="idle failed" for="face-lab-password">Current password
                            <input type="password" class="form-control" id="face-lab-password" autocomplete="current-password" data-face-password />
                        </label>
                        <p class="field-hint" data-face-show="idle failed">Your password is required before a face reference is created or replaced.</p>
                        <div class="button-row mt-3">
                            <button type="button" class="btn btn-primary" data-face-start data-face-show="idle failed"><partial name="_Icon" model='@("camera")' /> @(reference ? "Replace enrolled face" : "Set up face recognition")</button>
                            <button type="button" class="btn btn-primary" data-face-capture data-face-show="ready" hidden><partial name="_Icon" model='@("face")' /> Capture face</button>
                            <button type="button" class="btn btn-primary" data-face-save data-face-show="captured" hidden><partial name="_Icon" model='@("check")' /> Save face</button>
                            <button type="button" class="btn btn-outline-secondary" data-face-retry data-face-show="captured" hidden>Try again</button>
                            <button type="button" class="btn btn-outline-secondary" data-face-cancel data-face-show="starting ready checking captured" hidden>Cancel</button>
                        </div>
                        @if (reference)
                        {
                            <form asp-controller="Account" asp-action="FaceLabDelete" method="post" class="mt-3" data-face-show="idle failed" data-workspace-confirm="Remove your enrolled face? You will no longer be able to sign in with face recognition.">
                                <button type="submit" class="btn btn-link text-danger p-0">Remove enrolled face</button>
                            </form>
                        }
                    </div>
                </div>
                <p class="field-hint mt-3 mb-0"><strong>Academic demonstration.</strong> Captured frames are sent to the free Face++ service for comparison. This method has no certified liveness detection and can be fooled by photos or video; keep your password and passkey as your primary sign-in methods. @(FaceLab.DemoLoginEnabled ? "Face sign-in is enabled on the sign-in page." : "Face sign-in is currently disabled on the sign-in page in this environment.")</p>
            }
        </section>
    }
    <section class="surface detail-card mb-3">
        <div class="card-heading"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("key")' /></span><span class="status-pill @(Model.HasFingerprint ? "status-positive" : "status-neutral")"><span></span>@(Model.HasFingerprint ? "Registered" : "Not registered")</span></div>
        <h2>Passkey</h2><p class="subtle">Use your phone or this device's screen unlock (fingerprint, face unlock or PIN) through a passkey.</p>
        @if (Model.Manage && canPhone)
        {
            <label class="field mb-2" for="bio-password">Current password<input class="form-control" id="bio-password" type="password" autocomplete="current-password" /></label>
            <p class="field-hint">Required when adding another verification method.</p>
        }
        @if (canPhone) { <button type="button" class="btn btn-outline-secondary" data-phone-button data-create="@(!Model.HasFingerprint ? "true" : "false")">@(Model.HasFingerprint ? "Verify with phone" : "Set up on phone")</button> }
        <p class="mt-3 mb-0" data-bio-status role="status" aria-live="polite"></p>
    </section>
    <div class="button-row">
        @if (Model.Manage && !first && Model.ReturnUrl != null) { <a data-full-page class="btn btn-primary" href="@Model.ReturnUrl">Continue to workspace</a> }
        @if (!Model.Manage) { <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="btn btn-outline-secondary">Back to sign in</button></form> }
    </div>
</div>
