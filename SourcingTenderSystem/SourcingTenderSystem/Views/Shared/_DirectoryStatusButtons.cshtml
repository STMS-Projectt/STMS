<div class="directory-status-options" role="group" aria-label="@L.T("Filter by status")">
    <button type="button" data-status-choice="" aria-pressed="true">@L.T("All statuses")</button>
    <button type="button" data-status-choice="active" aria-pressed="false">@L.T("Active")</button>
    <button type="button" data-status-choice="inactive" aria-pressed="false">@L.T("Inactive")</button>
</div>
