@inject Microsoft.AspNetCore.Identity.UserManager<Microsoft.AspNetCore.Identity.IdentityUser> Users
@{
    var account = await Users.GetUserAsync(User);
    var exists = account != null && await Users.GetAuthenticationTokenAsync(account, "Profile", "Photo") != null;
}
<a class="avatar overflow-hidden text-decoration-none" asp-controller="Profile" asp-action="Index" aria-label="My profile">
    @if (exists) { <img class="w-100 h-100" style="object-fit:cover" src="@Url.Action("Photo", "Profile")" alt="" /> }
    else { @((User.Identity?.Name ?? "U").FirstOrDefault().ToString().ToUpperInvariant()) }
</a>
