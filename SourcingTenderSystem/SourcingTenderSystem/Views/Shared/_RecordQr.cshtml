@using QRCoder
@model string
@inject IConfiguration Config
@{
    // "PublicBaseUrl" (e.g. a Cloudflare Tunnel link) lets a phone open the QR; otherwise the current site address is used.
    var baseUrl = Config["PublicBaseUrl"] is { Length: > 0 } publicUrl ? publicUrl.TrimEnd('/') : $"{Context.Request.Scheme}://{Context.Request.Host}";
    var link = baseUrl + Model;
    using var data = QRCodeGenerator.GenerateQrCode(link, QRCodeGenerator.ECCLevel.M);
    using var qr = new PngByteQRCode(data);
    var image = Convert.ToBase64String(qr.GetGraphic(5));
}
<details open="@(ViewData["RecordQrOpen"] is true)" class="surface detail-card mb-3 record-qr">
    <summary class="fw-semibold">@L.T("QR code and share link")</summary>
    <div class="d-flex gap-3 align-items-center flex-wrap mt-3">
        <img width="144" height="144" src="data:image/png;base64,@image" alt="@L.T("QR code for this record")" />
        <div style="min-width:0">
            <p class="subtle">@L.T("Scan with your phone to open this record. Sign-in and access permissions still apply.")</p>
            <a class="btn btn-outline-secondary mb-2" href="data:image/png;base64,@image" download="sourcing-record-qr.png">@L.T("Save QR code")</a>
            <a class="d-block text-break small" href="@link">@link</a>
        </div>
    </div>
</details>
