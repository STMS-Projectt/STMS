@using QRCoder
@model Bid
@inject IConfiguration Config
@* Tax, legal warranty and bank guarantee of one bid + QR code to the e-guarantee verification page *@
@{
    var verifyPath = Url.Action("Index", "GuaranteeVerify", new { code = Model.GuaranteeVerificationCode.ToString("N") });
    // "PublicBaseUrl" (e.g. a Cloudflare Tunnel link) lets a phone open the QR; otherwise the current site address is used.
    var baseUrl = Config["PublicBaseUrl"] is { Length: > 0 } publicUrl ? publicUrl.TrimEnd('/') : $"{Context.Request.Scheme}://{Context.Request.Host}";
    var verifyLink = baseUrl + verifyPath;
    string? qrImage = null;
    if (Model.HasBankGuarantee)
    {
        using var data = QRCodeGenerator.GenerateQrCode(verifyLink, QRCodeGenerator.ECCLevel.M);
        using var qr = new PngByteQRCode(data);
        qrImage = Convert.ToBase64String(qr.GetGraphic(4));
    }
    var warrantyFile = Model.BidDocuments.LastOrDefault(d => d.DocumentType == BidDocument.LegalWarranty);
    var guaranteeFile = Model.BidDocuments.LastOrDefault(d => d.DocumentType == BidDocument.BankGuarantee);
}
<section class="pr-create pr-card prd-card record-section bg-sum">
    <div class="prd-card-head">
        <div class="pr-section-head mb-0"><span class="pr-badge"><partial name="_Icon" model='@("shield")' /></span><div><h2>@L.T("Cost, warranty and bank guarantee")</h2></div></div>
    </div>
    <div class="bg-cost">
        <div><span>@L.T("Price before tax")</span><strong>@Model.TotalPrice.ToString("N2") <small>@Model.Currency</small></strong></div>
        <i aria-hidden="true">+</i>
        <div><span>@L.T("Sales tax (16%)")</span><strong>@(Model.IncludesSalesTax ? Model.TaxAmount.ToString("N2") : "0.00") <small>@(Model.IncludesSalesTax ? Model.Currency : L.T("Not added"))</small></strong></div>
        <i aria-hidden="true">=</i>
        <div class="bg-final"><span>@L.T("Final cost")</span><strong>@Model.TotalWithTax.ToString("N2") <small>@Model.Currency</small></strong></div>
    </div>
    <div class="bg-two">
        <div class="bg-box">
            <h3><partial name="_Icon" model='@("file")' /> @L.T("Legal warranty")</h3>
            <strong>@(Model.LegalWarrantyMonths is int months ? L.F("{0} months", months) : L.T("Not provided"))</strong>
            @if (warrantyFile != null) { <a class="bg-file" asp-controller="BidDocuments" asp-action="Download" asp-route-id="@warrantyFile.Id" asp-route-preview="true" target="_blank" rel="noopener"><partial name="_Icon" model='@("eye")' /> @L.T("View warranty file")</a> }
        </div>
        <div class="bg-box">
            <h3><partial name="_Icon" model='@("shield")' /> @L.T("Bank guarantee")</h3>
            @if (Model.HasBankGuarantee)
            {
                <strong>@Model.BankName</strong>
                <p>@Model.BankGuaranteeAmount?.ToString("N2") @Model.Currency · @L.F("valid until {0}", Model.BankGuaranteeExpiry?.ToString("yyyy-MM-dd"))</p>
            }
            else { <strong>@L.T("Not provided")</strong> }
            @if (guaranteeFile != null) { <a class="bg-file" asp-controller="BidDocuments" asp-action="Download" asp-route-id="@guaranteeFile.Id" asp-route-preview="true" target="_blank" rel="noopener"><partial name="_Icon" model='@("eye")' /> @L.T("View guarantee file")</a> }
        </div>
    </div>
    @if (qrImage != null)
    {
        <div class="bg-qr">
            <img width="112" height="112" src="data:image/png;base64,@qrImage" alt="@L.T("QR code to verify the bank guarantee")" />
            <div>
                <p class="mb-1">@L.T("Scan to verify this bank guarantee on the e-guarantee verification page.")</p>
                <p class="small mb-2">@L.T("Verification code"): <code>@Model.GuaranteeVerificationCode.ToString("N")</code></p>
                <a class="btn tm-btn" href="@verifyLink" target="_blank" rel="noopener"><partial name="_Icon" model='@("shield")' /> @L.T("Open verification page")</a>
            </div>
        </div>
    }
</section>
