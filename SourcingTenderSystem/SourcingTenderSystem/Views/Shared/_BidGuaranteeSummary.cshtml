@using QRCoder
@model Bid
@inject IConfiguration Config
@* Tax, legal warranty and bank guarantee of one bid + QR code to the e-guarantee verification page *@
@{
    var verifyPath = Url.Action("Index", "GuaranteeVerify", new { code = Model.GuaranteeVerificationCode.ToString("N") });
    // "PublicBaseUrl" (e.g. a Cloudflare Tunnel link) lets a phone open the QR; otherwise the current site address is used.
    var baseUrl = Config["PublicBaseUrl"] is { Length: > 0 } publicUrl ? publicUrl.TrimEnd('/') : $"{Context.Request.Scheme}://{Context.Request.Host}";
    var verifyLink = baseUrl + verifyPath;
    string? qrImage = null;
    if (Model.HasBankGuarantee)
    {
        using var data = QRCodeGenerator.GenerateQrCode(verifyLink, QRCodeGenerator.ECCLevel.M);
        using var qr = new PngByteQRCode(data);
        qrImage = Convert.ToBase64String(qr.GetGraphic(4));
    }
    var warrantyFile = Model.BidDocuments.LastOrDefault(d => d.DocumentType == BidDocument.LegalWarranty);
    var guaranteeFile = Model.BidDocuments.LastOrDefault(d => d.DocumentType == BidDocument.BankGuarantee);
    var daysLeft = Model.BankGuaranteeExpiry is DateTime exp ? (exp.Date - DateTime.UtcNow.Date).Days : (int?)null;
}
<section class="pr-create record-section cw">
    <div class="cw-head">
        <span class="cw-icon"><partial name="_Icon" model='@("shield")' /></span>
        <div><h2>@L.T("Cost, warranty and bank guarantee")</h2><p>@L.T("Final cost including tax, and the guarantees attached to this bid.")</p></div>
    </div>

    @* ---------- Cost receipt ---------- *@
    <div class="cw-receipt">
        <div class="cw-line"><span>@L.T("Price before tax")</span><i></i><strong>@Model.TotalPrice.ToString("N2") <small>@Model.Currency</small></strong></div>
        <div class="cw-line"><span>@L.T("Sales tax (16%)")</span><i></i><strong>@(Model.IncludesSalesTax ? "+ " + Model.TaxAmount.ToString("N2") : L.T("Not added")) @if (Model.IncludesSalesTax) { <small>@Model.Currency</small> }</strong></div>
        <div class="cw-total"><span>@L.T("Final cost")</span><strong>@Model.TotalWithTax.ToString("N2") <small>@Model.Currency</small></strong></div>
    </div>

    @* ---------- Warranty + guarantee ---------- *@
    <div class="cw-cards">
        <article class="cw-card cw-warranty">
            <header><span class="cw-card-icon"><partial name="_Icon" model='@("file")' /></span><h3>@L.T("Legal warranty")</h3>
                <span class="cw-badge @(Model.LegalWarrantyMonths != null ? "is-ok" : "is-missing")">@(Model.LegalWarrantyMonths != null ? L.T("Provided") : L.T("Not provided"))</span></header>
            <p class="cw-value">@(Model.LegalWarrantyMonths is int months ? L.F("{0} months", months) : "—")</p>
            @if (warrantyFile != null) { <a class="cw-file" asp-controller="BidDocuments" asp-action="Download" asp-route-id="@warrantyFile.Id" asp-route-preview="true" target="_blank" rel="noopener"><span class="cw-pdf">PDF</span><span>@L.T("View warranty file")<small>@warrantyFile.FileName</small></span></a> }
            else { <p class="cw-empty">@L.T("No warranty file uploaded.")</p> }
        </article>
        <article class="cw-card cw-guarantee">
            <header><span class="cw-card-icon"><partial name="_Icon" model='@("shield")' /></span><h3>@L.T("Bank guarantee")</h3>
                @if (Model.HasBankGuarantee)
                {
                    <span class="cw-badge @(daysLeft >= 0 ? "is-ok" : "is-late")">@(daysLeft >= 0 ? L.F("{0} days left", daysLeft!) : L.T("Expired"))</span>
                }
                else { <span class="cw-badge is-missing">@L.T("Not provided")</span> }
            </header>
            @if (Model.HasBankGuarantee)
            {
                <p class="cw-value">@Model.BankName</p>
                <dl class="cw-facts">
                    <div><dt>@L.T("Amount")</dt><dd>@Model.BankGuaranteeAmount?.ToString("N2") @Model.Currency</dd></div>
                    <div><dt>@L.T("Expiry date")</dt><dd>@Model.BankGuaranteeExpiry?.ToString("dd MMM yyyy", L.DisplayCulture)</dd></div>
                </dl>
            }
            else { <p class="cw-value">—</p> }
            @if (guaranteeFile != null) { <a class="cw-file" asp-controller="BidDocuments" asp-action="Download" asp-route-id="@guaranteeFile.Id" asp-route-preview="true" target="_blank" rel="noopener"><span class="cw-pdf">PDF</span><span>@L.T("View guarantee file")<small>@guaranteeFile.FileName</small></span></a> }
        </article>
    </div>

    @if (qrImage != null)
    {
        <div class="cw-verify">
            <img width="104" height="104" src="data:image/png;base64,@qrImage" alt="@L.T("QR code to verify the bank guarantee")" />
            <div class="cw-verify-body">
                <h3>@L.T("Verify the bank guarantee")</h3>
                <p>@L.T("Scan to verify this bank guarantee on the e-guarantee verification page.")</p>
                <div class="cw-code"><span>@L.T("Verification code")</span><code>@Model.GuaranteeVerificationCode.ToString("N")</code></div>
            </div>
            <a class="btn cw-verify-btn" href="@verifyLink" target="_blank" rel="noopener"><partial name="_Icon" model='@("shield")' /> @L.T("Open verification page")</a>
        </div>
    }
</section>
