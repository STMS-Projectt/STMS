@model ICollection<SupplierDocument>
<section class="surface detail-card">
    <div class="card-heading"><div><h2>Supporting documents</h2><p>@Model.Count uploaded</p></div></div>
    @if (Model.Count == 0)
    {
        <p class="subtle mb-0">No documents have been uploaded yet.</p>
    }
    else
    {
        <ul class="docs-list">
        @foreach (var document in Model.OrderByDescending(x => x.UploadedAt))
        {
            <li><div><span class="icon-tile tone-blue"><partial name="_Icon" model='@("file")' /></span>
                <span><strong>@document.DocumentType</strong><small>PDF · Uploaded @document.UploadedAt.ToString("dd MMM yyyy") (UTC)@if (document.ExpiryDate is DateTime expires) { <text> · Expires @expires.ToString("dd MMM yyyy")</text> }</small></span></div>
                <a class="btn btn-outline-secondary" asp-action="DownloadDocument" asp-route-id="@document.Id" aria-label="Download @document.DocumentType PDF"><partial name="_Icon" model='@("download")' /> Download</a>
            </li>
        }
        </ul>
    }
</section>
