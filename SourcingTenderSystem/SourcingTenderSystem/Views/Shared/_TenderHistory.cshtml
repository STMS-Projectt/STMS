@model IEnumerable<Tender>
@using SourcingTenderSystem.Security
@if (Model.Any())
{
    <section class="surface detail-card mt-3"><h2>Tender history</h2><div class="record-list record-list-inset">
    @foreach (var tender in Model.OrderByDescending(t => t.Id))
    {
        <article class="record-card">
            <div class="record-name"><span class="avatar"><partial name="_Icon" model='@("briefcase")' /></span><span>@tender.Title<small>Tender #@tender.Id</small></span></div>
            <dl class="record-facts"><div><dt class="visually-hidden">Status</dt><dd><partial name="_Status" model="tender.Status" /></dd></div></dl>
            @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.SourcingOfficer))
            {
                <div class="record-action"><a class="record-icon-action" data-workspace-dialog="details" asp-controller='@(User.IsInRole(Roles.Admin) ? "AdminOperations" : "Tenders")' asp-action='@(User.IsInRole(Roles.Admin) ? "Tender" : "Details")' asp-route-id="@tender.Id" aria-label="View tender @tender.Title" data-tooltip="View tender"><partial name="_Icon" model='@("eye")' /></a></div>
            }
        </article>
    }
    </div></section>
}
