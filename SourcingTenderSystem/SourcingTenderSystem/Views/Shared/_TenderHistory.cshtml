@model IEnumerable<Tender>
@using SourcingTenderSystem.Security
@if (Model.Any())
{
    <section class="surface detail-card mt-3"><h2>Tender history</h2><ul class="list-group list-group-flush">
    @foreach (var tender in Model.OrderByDescending(t => t.Id))
    {
        <li class="list-group-item d-flex justify-content-between gap-2 flex-wrap">
            <span><strong>#@tender.Id · @tender.Title</strong> · @tender.Status</span>
            @if (User.IsInRole(Roles.Admin)) { <a data-workspace-dialog="details" asp-controller="AdminOperations" asp-action="Tender" asp-route-id="@tender.Id">View tender</a> }
            else if (User.IsInRole(Roles.SourcingOfficer)) { <a asp-controller="Tenders" asp-action="Details" asp-route-id="@tender.Id">View tender</a> }
        </li>
    }
    </ul></section>
}
