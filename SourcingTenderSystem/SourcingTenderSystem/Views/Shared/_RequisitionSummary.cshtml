@model PurchaseRequisition
<dl class="row">
    <dt class="col-sm-3">Title</dt><dd class="col-sm-9">@Model.Title</dd>
    <dt class="col-sm-3">Department</dt><dd class="col-sm-9">@Model.Department.Name</dd>
    <dt class="col-sm-3">Created by</dt><dd class="col-sm-9">@Model.CreatedByEmployeeProfile.FullName</dd>
    <dt class="col-sm-3">Created at (UTC)</dt><dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
    <dt class="col-sm-3">Reason</dt><dd class="col-sm-9" style="white-space: pre-wrap; overflow-wrap: anywhere">@Model.Reason</dd>
    <dt class="col-sm-3">Priority</dt><dd class="col-sm-9">@Model.Priority</dd>
    <dt class="col-sm-3">Target date</dt><dd class="col-sm-9">@Model.TargetDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><strong>@Model.Status</strong></dd>
    @if (!string.IsNullOrWhiteSpace(Model.ReviewNotes))
    {
        <dt class="col-sm-3">Latest review notes</dt>
        <dd class="col-sm-9" style="white-space: pre-wrap; overflow-wrap: anywhere">@Model.ReviewNotes</dd>
    }
    @if (Model.ReviewedByEmployeeProfile != null)
    {
        <dt class="col-sm-3">Reviewed by</dt><dd class="col-sm-9">@Model.ReviewedByEmployeeProfile.FullName</dd>
    }
</dl>
