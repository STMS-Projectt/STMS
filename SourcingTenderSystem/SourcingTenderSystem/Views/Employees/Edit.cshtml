@model EmployeeInput
@{ ViewData["Title"] = L.T("Edit employee"); }
<a class="back-link" asp-action="Index" ><partial name="_Icon" model='@("back")' /> @L.T("Employees")</a>
<header class="page-heading admin-action-heading"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("users")' /></span><div><p class="eyebrow">@L.T("ADMINISTRATION")</p><h1>@L.T("Edit employee")</h1><p>@L.T("Update profile information, access and department assignment.")</p></div></header>
<div class="form-shell">
    <form method="post" asp-antiforgery="true" class="surface form-card admin-action-card" >
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <partial name="_Fields" model="Model" />
        <div class="form-actions"><button class="btn btn-primary" type="submit">@L.T("Save changes") <partial name="_Icon" model='@("arrow")' /></button><a class="btn btn-outline-secondary" asp-action="Index" >@L.T("Cancel")</a></div>
    </form>
    <aside class="surface helper-card"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("shield")' /></span><h2>@L.T("Access changes")</h2><p>@L.T("Changing a role affects what the employee can access. An inactive account cannot sign in.")</p></aside>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
