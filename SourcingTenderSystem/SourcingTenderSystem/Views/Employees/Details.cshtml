@model EmployeeProfile
@{ ViewData["Title"] = "Employee details"; }
<h1>@ViewData["Title"]</h1>
<dl class="row">
    <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@Model.FullName</dd>
    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.User.Email</dd>
    <dt class="col-sm-4">Job title</dt><dd class="col-sm-8">@(string.IsNullOrEmpty(Model.JobTitle) ? "—" : Model.JobTitle)</dd>
    <dt class="col-sm-4">Department</dt><dd class="col-sm-8">@(Model.Department?.Name ?? "—")</dd>
    <dt class="col-sm-4">Role</dt><dd class="col-sm-8">@ViewBag.Roles</dd>
    <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.IsActive ? "Active" : "Inactive")</dd>
</dl>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a> <a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>
@if (Model.IsActive && ViewBag.IsSelf == false)
{
    <a class="btn btn-outline-danger" asp-action="Deactivate" asp-route-id="@Model.Id">Deactivate</a>
}
