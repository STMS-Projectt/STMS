@model AdminPasswordInput
@{ ViewData["Title"] = "Reset employee password"; }
<a class="back-link" asp-action="Details" asp-route-id="@ViewData["EmployeeId"]">Back to employee</a>
<header class="page-heading"><div><p class="eyebrow">ACCOUNT ACCESS</p><h1>Reset password</h1><p>Set a new password for @ViewData["EmployeeName"].</p></div></header>
<form class="surface form-card" asp-action="ResetPassword" asp-route-id="@ViewData["EmployeeId"]" method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <label asp-for="Password" class="form-label">New password</label><input asp-for="Password" class="form-control mb-3" autocomplete="new-password" required />
    <label asp-for="ConfirmPassword" class="form-label">Confirm password</label><input asp-for="ConfirmPassword" class="form-control mb-3" autocomplete="new-password" required />
    <button class="btn btn-primary" type="submit">Reset password</button>
</form>
