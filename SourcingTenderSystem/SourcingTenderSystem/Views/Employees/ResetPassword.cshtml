@model AdminPasswordInput
@{ ViewData["Title"] = "Reset employee password"; }
<a class="back-link" asp-action="Details" asp-route-id="@ViewData["EmployeeId"]">@L.T("Back to employee")</a>
<header class="page-heading admin-action-heading"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("key")' /></span><div><p class="eyebrow">@L.T("ACCOUNT ACCESS")</p><h1>@L.T("Reset password")</h1><p>@L.F("Set a new password for {0}.", ViewData["EmployeeName"])</p></div></header>
<form class="surface form-card admin-action-card" asp-action="ResetPassword" asp-route-id="@ViewData["EmployeeId"]" method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <label asp-for="Password" class="form-label">@L.T("New password")</label><input asp-for="Password" class="form-control mb-3" autocomplete="new-password" required />
    <label asp-for="ConfirmPassword" class="form-label">@L.T("Confirm password")</label><input asp-for="ConfirmPassword" class="form-control mb-3" autocomplete="new-password" required />
    <button class="btn btn-primary" type="submit">@L.T("Reset password")</button>
</form>
