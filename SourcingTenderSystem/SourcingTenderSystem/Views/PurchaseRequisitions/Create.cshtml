@model RequisitionInput
@{
    ViewData["Title"] = L.T("New purchase request");
    var categories = (IEnumerable<Category>)ViewBag.Categories;
    var priorities = new[] { ("Low", "low"), ("Normal", "normal"), ("High", "high"), ("Urgent", "urgent") };
    var items = Model.Items.Count > 0 ? Model.Items : new List<RequisitionItemInput> { new() };
    var units = new[] { "Piece", "Box", "Set", "Kg", "Liter", "Meter", "License", "Service" };
}
<div class="pr-create">
<a class="back-link" asp-controller="PurchaseRequisitions" asp-action="MyRequests"><partial name="_Icon" model='@("back")' /> @L.T("My Requests")</a>

<header class="pr-hero">
    <span class="pr-hero-icon"><partial name="_Icon" model='@("file")' /></span>
    <div>
        <p class="eyebrow">@L.T("PURCHASE REQUESTS")</p>
        <h1>@L.T("New purchase request")</h1>
        <p>@L.T("Start with the reason and target date. Add your item lines after saving.")</p>
    </div>
    <ol class="pr-steps" aria-label="@L.T("Draft workflow")">
        <li class="is-active"><span>1</span>@L.T("Request details")</li>
        <li class="is-active"><span>2</span>@L.T("Add items")</li>
        <li><span>3</span>@L.T("Submit for review")</li>
    </ol>
</header>

<div class="pr-layout">
    <form class="pr-card" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @* ---------- 1. What do you need ---------- *@
        <section class="pr-section">
            <div class="pr-section-head"><span class="pr-badge"><partial name="_Icon" model='@("inbox")' /></span><div><h2>@L.T("What do you need?")</h2><p>@L.T("Pick a category and give the request a clear title.")</p></div></div>
            <div class="pr-grid">
                <div class="pr-field">
                    <label asp-for="CategoryId" class="form-label">@L.T("Category")</label>
                    <select asp-for="CategoryId" class="form-select" required>
                        <option value="">@L.T("Select a category")</option>
                        @foreach (var category in categories) { <option value="@category.Id">@category.Name</option> }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
                <div class="pr-field">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" maxlength="200" placeholder="@L.T("e.g. Laptops for the new team")" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
            </div>
            <div class="pr-field">
                <div class="pr-label-row"><label asp-for="Reason" class="form-label"></label><small class="pr-counter" data-pr-counter="Reason">0 / 2000</small></div>
                <textarea asp-for="Reason" class="form-control" rows="4" maxlength="2000" placeholder="@L.T("Explain why this purchase is needed and how it will be used.")"></textarea>
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>
        </section>

        @* ---------- 2. Priority and timing ---------- *@
        <section class="pr-section">
            <div class="pr-section-head"><span class="pr-badge"><partial name="_Icon" model='@("clock")' /></span><div><h2>@L.T("Priority and timing")</h2><p>@L.T("How urgent is it and when do you need it?")</p></div></div>
            <fieldset class="pr-field">
                <legend class="form-label">@L.T("Priority")</legend>
                <div class="pr-priority" role="radiogroup">
                    @foreach (var (value, tone) in priorities)
                    {
                        <label class="pr-chip pr-@tone">
                            <input type="radio" name="Priority" value="@value" checked="@(Model.Priority == value)" />
                            <span><i aria-hidden="true"></i>@L.T(value)</span>
                        </label>
                    }
                </div>
                <span asp-validation-for="Priority" class="text-danger"></span>
            </fieldset>
            <div class="pr-field pr-date">
                <label asp-for="TargetDate" class="form-label"></label>
                <input asp-for="TargetDate" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                <span asp-validation-for="TargetDate" class="text-danger"></span>
            </div>
        </section>

        @* ---------- 3. Items ---------- *@
        <section class="pr-section">
            <div class="pr-section-head pr-items-head">
                <span class="pr-badge"><partial name="_Icon" model='@("briefcase")' /></span>
                <div><h2>@L.T("Requested items")</h2><p>@L.T("Add one line per item with its quantity and specifications.")</p></div>
                <span class="pr-count" data-pr-count>@items.Count</span>
            </div>
            <span asp-validation-for="Items" class="text-danger d-block mb-2"></span>
            <datalist id="pr-units">@foreach (var unit in units) { <option value="@unit"></option> }</datalist>

            <div class="pr-items" data-pr-items>
                @for (var i = 0; i < items.Count; i++)
                {
                    <div class="pr-item" data-pr-item>
                        <div class="pr-item-top">
                            <span class="pr-item-no" data-pr-no>@(i + 1)</span>
                            <div class="pr-field pr-item-name">
                                <label class="form-label" for="Items_@(i)__ItemName">@L.T("Item name")</label>
                                <input class="form-control" id="Items_@(i)__ItemName" name="Items[@i].ItemName" value="@items[i].ItemName" maxlength="200" required placeholder="@L.T("e.g. Laptop")" />
                            </div>
                            <div class="pr-field pr-item-qty">
                                <label class="form-label" for="Items_@(i)__Quantity">@L.T("Quantity")</label>
                                <input class="form-control" type="number" id="Items_@(i)__Quantity" name="Items[@i].Quantity" value="@items[i].Quantity" min="1" max="1000000" required />
                            </div>
                            <div class="pr-field pr-item-unit">
                                <label class="form-label" for="Items_@(i)__Unit">@L.T("Unit")</label>
                                <input class="form-control" id="Items_@(i)__Unit" name="Items[@i].Unit" value="@items[i].Unit" list="pr-units" maxlength="50" required />
                            </div>
                            <button type="button" class="pr-item-remove" data-pr-remove aria-label="@L.T("Remove item")" title="@L.T("Remove item")"><partial name="_Icon" model='@("trash")' /></button>
                        </div>
                        <div class="pr-field">
                            <label class="form-label" for="Items_@(i)__Specifications">@L.T("Specifications")</label>
                            <textarea class="form-control pr-item-specs" id="Items_@(i)__Specifications" name="Items[@i].Specifications" rows="2" maxlength="2000" required placeholder="@L.T("Model, size, brand or any detail the supplier needs.")">@items[i].Specifications</textarea>
                        </div>
                    </div>
                }
            </div>
            <button type="button" class="pr-add-item" data-pr-add><partial name="_Icon" model='@("plus")' /> @L.T("Add another item")</button>
        </section>

        <div class="pr-actions">
            <a class="btn btn-outline-secondary" asp-controller="PurchaseRequisitions" asp-action="MyRequests">@L.T("Cancel")</a>
            <button class="btn btn-primary pr-submit" type="submit"><partial name="_Icon" model='@("check")' /> @L.T("Save draft")</button>
        </div>
    </form>

    <aside class="pr-side">
        <div class="pr-tip">
            <span class="pr-badge"><partial name="_Icon" model='@("file")' /></span>
            <h2>@L.T("Draft workflow")</h2>
            <p>@L.T("Add one line per item with its quantity and specifications. You can edit your draft until you submit it.")</p>
        </div>
        <ul class="pr-checklist">
            <li><partial name="_Icon" model='@("check")' /> @L.T("Use a short, specific title.")</li>
            <li><partial name="_Icon" model='@("check")' /> @L.T("Explain the business need in the reason.")</li>
            <li><partial name="_Icon" model='@("check")' /> @L.T("Choose Urgent only for critical needs.")</li>
        </ul>
    </aside>
</div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Live character counter for the reason box
        document.querySelectorAll('[data-pr-counter]').forEach(counter => {
            const box = document.getElementById(counter.dataset.prCounter);
            if (!box) return;
            const update = () => counter.textContent = box.value.length + ' / ' + box.maxLength;
            box.addEventListener('input', update); update();
        });

        // Add / remove item rows. Field names are renumbered (Items[0], Items[1] ...) so the server binds them in order.
        (() => {
            const list = document.querySelector('[data-pr-items]');
            if (!list) return;
            const count = document.querySelector('[data-pr-count]');
            const renumber = () => {
                const rows = list.querySelectorAll('[data-pr-item]');
                rows.forEach((row, i) => {
                    row.querySelector('[data-pr-no]').textContent = i + 1;
                    row.querySelectorAll('[name^="Items["]').forEach(field => {
                        const prop = field.name.split('.').pop();
                        field.name = `Items[${i}].${prop}`;
                        field.id = `Items_${i}__${prop}`;
                        const label = field.closest('.pr-field')?.querySelector('label');
                        if (label) label.htmlFor = field.id;
                    });
                    row.querySelector('[data-pr-remove]').disabled = rows.length === 1;
                });
                count.textContent = rows.length;
            };
            document.querySelector('[data-pr-add]').addEventListener('click', () => {
                const copy = list.querySelector('[data-pr-item]').cloneNode(true);
                copy.querySelectorAll('input, textarea').forEach(f => f.value = f.name.endsWith('Quantity') ? '1' : f.name.endsWith('Unit') ? 'Piece' : '');
                copy.querySelectorAll('.input-validation-error').forEach(e => e.classList.remove('input-validation-error'));
                list.appendChild(copy);
                renumber();
                copy.querySelector('input').focus();
            });
            list.addEventListener('click', e => {
                const remove = e.target.closest('[data-pr-remove]');
                if (!remove || list.querySelectorAll('[data-pr-item]').length === 1) return;
                remove.closest('[data-pr-item]').remove();
                renumber();
            });
            renumber();
        })();
    </script>
}
