@model RequisitionInput
@{ ViewData["Title"] = "Edit purchase request"; }
<h1>Edit purchase request</h1>
<form asp-action="Edit" asp-route-id="@ViewBag.RequestId" method="post" class="col-lg-8">
    <partial name="_Fields" model="Model" />
    <button class="btn btn-primary" type="submit">Save changes</button>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@ViewBag.RequestId">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
