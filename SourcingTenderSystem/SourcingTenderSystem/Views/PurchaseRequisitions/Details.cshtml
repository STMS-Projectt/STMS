@model PurchaseRequisition
@{
    ViewData["Title"] = L.T("Request details");
    bool canEdit = ViewBag.CanEdit == true;
    bool returned = Model.Status == "Returned";
    bool overviewOnly = ViewBag.OverviewOnly == true;
}
<a class="back-link" asp-action="MyRequests"><partial name="_Icon" model='@("back")' /> @L.T("My Requests")</a>
<header class="page-heading stms-hero admin-record-hero">
    <div><p class="eyebrow">@L.F("Purchase request · PR-{0}", Model.Id)</p><h1>@Model.Title</h1><p>@Model.Department.Name · @L.F("Requested by {0}", Model.CreatedByEmployeeProfile.FullName)</p></div>
    <partial name="_RequestStatus" model="Model.Status" />
</header>
@if (!overviewOnly) { <partial name="_RecordQr" model='@(Url.Action("Details", new { id = Model.Id })!)' /> }
@if (TempData["RequestError"] is string error)
{
    <div class="alert alert-danger" role="alert">@L.T(error)</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ReviewNotes))
{
    <section class="surface detail-card request-review @(returned ? "request-returned" : "")">
        <h2>@L.T(returned ? "Changes requested" : "Latest review notes")</h2>
        <p class="request-prose mb-0">@Model.ReviewNotes</p>
        @if (Model.ReviewedByEmployeeProfile != null) { <small class="subtle">@Model.ReviewedByEmployeeProfile.FullName</small> }
        @if (returned && canEdit) { <p class="subtle mt-2 mb-0">@L.T("Update the request or its items, then submit it again.")</p> }
    </section>
}
<section class="surface detail-card request-section">
    <div class="card-heading"><h2>@L.T("Request overview")</h2>
        @if (canEdit && !overviewOnly) { <a class="btn btn-outline-secondary" data-workspace-dialog asp-action="Edit" asp-route-id="@Model.Id"><partial name="_Icon" model='@("edit")' /> @L.T("Edit request")</a> }
    </div>
    <dl class="request-meta">
        <div><dt>@L.T("Priority")</dt><dd>@L.T(Model.Priority)</dd></div>
        <div><dt>@L.T("Target date")</dt><dd>@Model.TargetDate.ToString("dd MMM yyyy", L.DisplayCulture)</dd></div>
        <div><dt>@L.T("Created")</dt><dd>@Model.CreatedAt.ToString("dd MMM yyyy", L.DisplayCulture)</dd></div>
    </dl>
    <h3>@L.T("Reason for purchase")</h3><p class="request-prose mb-0">@Model.Reason</p>
</section>
@if (!overviewOnly)
{
<section class="surface directory request-section">
    <div class="directory-toolbar">
        <div><h2 class="mb-0">@L.T("Requested items")</h2><span class="result-count">@Model.Items.Count line item(s)</span></div>
        @if (canEdit) { <a class="btn btn-outline-secondary" data-workspace-dialog asp-controller="RequisitionItems" asp-action="Create" asp-route-requestId="@Model.Id"><partial name="_Icon" model='@("plus")' /> @L.T("Add item")</a> }
    </div>
    <partial name="_RequisitionItems" model="Model.Items" />
</section>
@if (canEdit && Model.Items.Count > 0)
{
    <form asp-action="Submit" asp-route-id="@Model.Id" method="post" class="surface detail-card request-submit">
        <div><h2>@L.T(returned ? "Ready to send it back?" : "Ready for review?")</h2><p class="subtle mb-0">@L.T("You can make changes again if the reviewer returns this request.")</p></div>
        <button type="submit" class="btn btn-primary">@L.T(returned ? "Resubmit for review" : "Submit for review") <partial name="_Icon" model='@("arrow")' /></button>
    </form>
}

<div class="button-row mb-3">
    @if (ViewData["ClarificationRequestIds"] is ISet<int> startable && startable.Contains(Model.Id))
    {
        <a data-workspace-page class="btn btn-outline-secondary" asp-controller="Clarifications" asp-action="StartRequest" asp-route-id="@Model.Id"><partial name="_Icon" model='@("mail")' /> @L.T("Start a clarification")</a>
    }
    <a data-workspace-page class="btn btn-outline-secondary" asp-controller="Clarifications" asp-action="Index" asp-route-kind="request" asp-route-recordId="@Model.Id">@L.T("Clarification history")</a>
</div>

<partial name="_TenderHistory" model="Model.Tenders" />
}
