@model PurchaseRequisition
@{
    var items = (string?)ViewData["RequestPanel"] == "items";
    var returned = Model.Status == "Returned";
    ViewData["Title"] = items ? "Requested items" : "Request QR code";
}
<a class="back-link" asp-action="Details" asp-route-id="@Model.Id">@L.T("Back to request")</a>
<header class="page-heading stms-hero admin-record-hero">
    <div><p class="eyebrow">@L.F("Purchase request · PR-{0}", Model.Id)</p><h1>@L.T(ViewData["Title"]?.ToString())</h1><p>@Model.Title</p></div>
    @if (items && ViewBag.CanEdit == true)
    {
        <a class="btn btn-primary" data-workspace-dialog asp-controller="RequisitionItems" asp-action="Create" asp-route-requestId="@Model.Id"><partial name="_Icon" model='@("plus")' /> @L.T("Add item")</a>
    }
</header>
@if (items)
{
    <section class="surface detail-card"><partial name="_RequisitionItems" model="Model.Items" /></section>
    @if (ViewBag.CanEdit == true && Model.Items.Count > 0)
    {
        <form asp-action="Submit" asp-route-id="@Model.Id" method="post" class="surface detail-card request-submit mt-3">
            <div><h2>@L.T(returned ? "Ready to send it back?" : "Ready for review?")</h2><p class="subtle mb-0">@L.T("Send this purchase request and its items to the sourcing officer.")</p></div>
            <button type="submit" class="btn btn-primary">@L.T(returned ? "Resubmit for review" : "Submit for review")</button>
        </form>
    }
}
else
{
    <partial name="_RecordQr" model='@(Url.Action("Details", new { id = Model.Id })!)' />
}
