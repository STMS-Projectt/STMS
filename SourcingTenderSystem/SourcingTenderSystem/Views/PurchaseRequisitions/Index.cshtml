@model DepartmentRequestList
@{ ViewData["Title"] = "My Requests"; }
<header class="page-heading">
    <div><p class="eyebrow">REQUEST TRACKER</p><h1>My Requests</h1><p>Purchase requests from everyone in @Model.Department.</p></div>
    <a data-workspace-dialog class="btn btn-primary" asp-action="Create"><partial name="_Icon" model='@("plus")' /> New request</a>
</header>
<section class="surface directory" aria-label="Department requests">
    <form class="directory-toolbar request-filters" asp-action="MyRequests" method="get" role="search">
        <label class="search-box">
            <span class="visually-hidden">Search by request title</span><partial name="_Icon" model='@("search")' />
            <input class="form-control" name="q" value="@Model.Query" placeholder="Search request titles" />
        </label>
        <label><span class="visually-hidden">Status</span>
            <select class="form-select" name="status">
                <option value="">All statuses</option>
                @foreach (var status in Model.Statuses) { <option value="@status" selected="@(status == Model.Status)">@status</option> }
            </select>
        </label>
        <button class="btn btn-outline-secondary" type="submit">Filter</button>
        <button class="btn btn-outline-secondary" type="button" data-request-voice-search hidden>Voice search</button>
        <span class="visually-hidden" data-request-voice-status role="status" aria-live="polite"></span>
        @if (Model.Status != null || !string.IsNullOrEmpty(Model.Query)) { <a class="text-link" asp-action="MyRequests">Clear filters</a> }
        <span class="result-count">@Model.Requests.Count request(s)</span>
    </form>
    @if (Model.Requests.Count > 0) { <partial name="_RequestTable" model="Model.Requests" /> }
    else
    {
        <div class="empty-state">
            <span class="icon-tile tone-teal"><partial name="_Icon" model='@("file")' /></span>
            @if (Model.Status != null || !string.IsNullOrEmpty(Model.Query))
            { <h2>No matching requests</h2><p>Try a different title or status.</p> }
            else
            { <h2>No purchase requests yet</h2><p>Start a draft when your department needs to buy something.</p><a data-workspace-dialog class="btn btn-primary" asp-action="Create">Create a draft</a> }
        </div>
    }
</section>
@section Scripts { <script src="~/js/department-request-voice-search.js" asp-append-version="true" defer></script> }
