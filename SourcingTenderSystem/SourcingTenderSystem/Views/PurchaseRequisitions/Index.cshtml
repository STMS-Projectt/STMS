@model List<PurchaseRequisition>
@{ ViewData["Title"] = ViewBag.Heading; }
<h1>@ViewBag.Heading</h1>
<div class="d-flex gap-2 mb-3">
    <a class="btn btn-primary" asp-action="Create">New request</a>
    <a class="btn btn-outline-secondary" asp-action="MyRequests">My requests</a>
    <a class="btn btn-outline-secondary" asp-action="Index">Department requests</a>
</div>
@if (Model.Count == 0)
{
    <p>No purchase requests yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th>Title</th><th>Created by</th><th>Priority</th><th>Target date</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var request in Model)
            {
                <tr>
                    <td>@request.Title</td><td>@request.CreatedByEmployeeProfile.FullName</td>
                    <td>@request.Priority</td><td>@request.TargetDate.ToString("yyyy-MM-dd")</td>
                    <td>@request.Status</td>
                    <td><a asp-action="Details" asp-route-id="@request.Id">Details</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
