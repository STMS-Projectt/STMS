@model AccountSettings
@{
    ViewData["Title"] = L.T("Account settings");
    var security = Model.Security != null;
    var information = Model.Supplier != null || string.Equals(Context.Request.Query["tab"], "information", StringComparison.OrdinalIgnoreCase);
}
<header class="surface account-hero">
    <partial name="_ProfileAvatar" />
    <div><p class="eyebrow">@L.T("YOUR ACCOUNT")</p><h1>@(string.IsNullOrWhiteSpace(Model.Personal.PreferredName) ? Model.DisplayName : Model.Personal.PreferredName)</h1><p>@Model.Email</p></div>
    <span class="account-hero-badge"><partial name="_Icon" model='@("shield")' /> @L.T("Account settings")</span>
</header>
<nav class="account-tabs" aria-label="@L.T("Account settings tabs")">
    @if (Model.Supplier is null)
    { <a asp-action="Index" asp-route-tab="personal" aria-current="@(!security && !information ? "page" : null)"><partial name="_Icon" model='@("users")' /> @L.T("Personal")</a> }
    <a asp-action="Index" asp-route-tab="security" aria-current="@(security ? "page" : null)"><partial name="_Icon" model='@("shield")' /> @L.T("Security")</a>
    <a asp-action="Index" asp-route-tab="information" aria-current="@(!security && information ? "page" : null)"><partial name="_Icon" model='@("file")' /> @L.T("Account information")</a>
</nav>
@if (TempData["ProfileError"] is string error) { <div class="alert alert-warning" role="alert">@L.T(error)</div> }
@if (Model.Security is { } methods)
{
    <div class="account-panel">
        <div class="account-section-heading"><h2>@L.T("Sign-in methods")</h2><p>@L.T("Manage your passkey and face recognition. Your profile photo is separate from face recognition.")</p></div>
        <partial name="_SignInMethods" model="methods" />
    </div>
}
else if (information)
{
    <section class="surface detail-card account-fields account-panel account-information-panel">
        <div class="account-info-intro"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("shield")' /></span><div><p class="eyebrow">@L.T("ACCOUNT OVERVIEW")</p><h2>@L.T("Account information")</h2><p>@L.T("Details managed by your organization.")</p></div></div>
        <dl class="account-info-grid">
            <div class="account-info-tile"><span class="icon-tile tone-blue"><partial name="_Icon" model='@("users")' /></span><dt>@L.T(Model.Supplier is null ? "Account name" : "Company")</dt><dd>@Model.DisplayName</dd></div>
            <div class="account-info-tile"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("mail")' /></span><dt>@L.T("Sign-in email")</dt><dd>@Model.Email</dd></div>
            @if (Model.Roles.Count > 0) { <div class="account-info-tile"><span class="icon-tile tone-blue"><partial name="_Icon" model='@("shield")' /></span><dt>@L.T("Access roles")</dt><dd>@string.Join("، ", Model.Roles.Select(L.T))</dd></div> }
            @if (Model.Employee is { } employee)
            {
                <div class="account-info-tile"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("building")' /></span><dt>@L.T("Department")</dt><dd>@(employee.Department?.Name ?? L.T("Unassigned"))</dd></div>
                <div class="account-info-tile"><span class="icon-tile tone-blue"><partial name="_Icon" model='@("briefcase")' /></span><dt>@L.T("Job title")</dt><dd>@(employee.JobTitle ?? L.T("Not set"))</dd></div>
            }
            @if (Model.Supplier is { } supplier)
            {
                <div class="account-info-tile"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("building")' /></span><dt>@L.T("Company phone")</dt><dd>@supplier.ContactPhone</dd></div>
                <div class="account-info-tile"><span class="icon-tile tone-blue"><partial name="_Icon" model='@("building")' /></span><dt>@L.T("Company address")</dt><dd>@supplier.Address</dd></div>
            }
        </dl>
    </section>
}
else
{
    <section class="surface detail-card account-fields account-panel">
        <div class="account-section-heading"><h2>@L.T("Personal details")</h2><p>@L.T("Add contact information and choose how your name appears on this page.")</p></div>
        <div class="account-personal-layout">
            <form asp-action="SavePersonal" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="account-field-grid">
                    <div><label class="form-label" asp-for="Personal.PreferredName"></label><input class="form-control" asp-for="Personal.PreferredName" maxlength="80" /><span asp-validation-for="Personal.PreferredName" class="text-danger"></span></div>
                    <div><label class="form-label" asp-for="Personal.WorkPhone"></label><input class="form-control" asp-for="Personal.WorkPhone" autocomplete="tel" maxlength="40" /><span asp-validation-for="Personal.WorkPhone" class="text-danger"></span></div>
                    <div class="account-field-wide"><label class="form-label" asp-for="Personal.Location"></label><input class="form-control" asp-for="Personal.Location" placeholder="@L.T("City or office")" maxlength="100" /><span asp-validation-for="Personal.Location" class="text-danger"></span></div>
                    <div class="account-field-wide"><label class="form-label" asp-for="Personal.Bio"></label><textarea class="form-control" asp-for="Personal.Bio" rows="4" maxlength="400"></textarea><span asp-validation-for="Personal.Bio" class="text-danger"></span></div>
                </div>
                <div class="form-actions"><button class="btn btn-primary" type="submit"><partial name="_Icon" model='@("check")' /> @L.T("Save changes")</button></div>
                @if (TempData["PersonalDetailsFeedback"] is string saved) { <p class="alert alert-success mt-2 mb-0" role="status">@L.T(saved)</p> }
            </form>
            <div class="account-photo-section" data-photo-upload>
                <div class="account-section-heading"><h3>@L.T("Profile photo")</h3><p>@L.T("Preview your image before saving it to your profile.")</p></div>
                <div class="account-photo-preview">
                    @if (Model.HasPhoto) { <img src="@Url.Action("Photo", "Profile")" alt="@L.T("Current profile photo")" data-photo-preview /> }
                    else { <img alt="@L.T("Selected profile photo preview")" data-photo-preview hidden /><span data-photo-placeholder><partial name="_Icon" model='@("users")' /></span> }
                </div>
                <form asp-action="Upload" method="post" enctype="multipart/form-data">
                    <label class="account-photo-picker" for="photo"><partial name="_Icon" model='@("upload")' /><strong>@L.T("Choose a photo")</strong><span>@L.T("JPEG or PNG · up to 1 MB")</span></label>
                    <input class="visually-hidden" type="file" id="photo" name="photo" accept="image/png,image/jpeg" required aria-describedby="photo-hint" />
                    <p id="photo-hint" class="field-hint" data-photo-status>@L.T("No photo selected.")</p>
                    <div class="account-photo-actions"><button class="btn btn-primary" type="submit" data-photo-save><partial name="_Icon" model='@("check")' /> @L.T("Save photo")</button><button class="btn btn-outline-secondary" type="button" data-photo-cancel hidden>@L.T("Cancel selection")</button></div>
                </form>
                @if (Model.HasPhoto) { <form asp-action="Remove" method="post" class="mt-3"><button class="btn btn-outline-danger" type="submit">@L.T("Remove photo")</button></form> }
                @if (TempData["ProfilePhotoFeedback"] is string photoSaved) { <p class="alert alert-success mt-2 mb-0" role="status">@L.T(photoSaved)</p> }
            </div>
        </div>
    </section>
}
@section Scripts {
    @if (security)
    {
        <script src="~/js/biometrics.js" asp-append-version="true" defer></script>
        <script src="~/js/face-lab.js" asp-append-version="true" defer></script>
    }
    else if (!information) { <partial name="_ValidationScriptsPartial" /><script src="~/js/profile-photo.js" asp-append-version="true" defer></script> }
}
