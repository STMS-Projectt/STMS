@model string
@{ ViewData["Title"] = "My profile"; }
<header class="page-heading"><div><p class="eyebrow">YOUR ACCOUNT</p><h1>My profile</h1><p>@Model</p></div></header>
@if (TempData["ProfileError"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }
<div class="form-shell">
    <section class="surface form-card">
        <div class="d-flex gap-3 align-items-center mb-3"><partial name="_ProfileAvatar" /><div><h2>Profile photo</h2><p class="subtle mb-0">This photo appears in your workspace header.</p></div></div>
        <form asp-action="Upload" method="post" enctype="multipart/form-data">
            <label class="form-label" for="photo">Choose an image</label>
            <input class="form-control mb-2" type="file" id="photo" name="photo" accept="image/png,image/jpeg" required aria-describedby="photo-hint" />
            <p id="photo-hint" class="field-hint mb-3">JPEG or PNG, up to 1 MB. A square image works best.</p>
            <button class="btn btn-primary" type="submit"><partial name="_Icon" model='@("upload")' /> Save photo</button>
        </form>
        @if (ViewData["HasPhoto"] is true) { <form asp-action="Remove" method="post" class="mt-3"><button class="btn btn-outline-danger" type="submit">Remove photo</button></form> }
    </section>
    <aside class="surface helper-card"><h2>Sign-in security</h2><p>Your profile photo is separate from face recognition and does not change your sign-in settings.</p><a class="text-link" asp-controller="Account" asp-action="BiometricSetup">Manage sign-in methods</a></aside>
</div>
