@model LoginInput
@{ ViewData["Title"] = "Sign in"; }
<div class="auth-shell">
    <aside class="auth-aside">
        <div class="banner-art" aria-hidden="true"><span></span><span></span><span></span></div>
        <span class="brand-mark"><partial name="_Icon" model='@("brand")' /></span>
        <p class="eyebrow">SOURCING DESK</p><h2>Your sourcing workspace.</h2>
        <p>Sign in to manage records or follow your supplier application.</p>
    </aside>
    <section class="surface auth-panel">
        <h1>Sign in</h1><p class="subtle">Enter your email and password to continue.</p>
        <form method="post" asp-antiforgery="true">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><input asp-for="ReturnUrl" type="hidden">
            <div class="stack"><div class="field "><label asp-for="Email" class="form-label"></label>
    <input asp-for="Email" class="form-control" autocomplete="username" placeholder="name@example.com">
    <span asp-validation-for="Email" class="text-danger"></span></div><div class="field "><label asp-for="Password" class="form-label"></label>
    <div class="password-control"><input asp-for="Password" class="form-control" autocomplete="current-password"><button type="button" class="btn btn-outline-secondary" data-password-toggle aria-controls="Password" aria-pressed="false" hidden>Show</button></div>
    <span asp-validation-for="Password" class="text-danger"></span></div>
            <div class="form-check"><input class="form-check-input" asp-for="RememberMe"><label class="form-check-label" asp-for="RememberMe"></label></div>
            <button class="btn btn-primary" type="submit">Sign in <partial name="_Icon" model='@("arrow")' /></button></div>
        </form>
        <p class="mt-3 mb-0 subtle">New supplier? <a asp-controller="SupplierRegistration" asp-action="Register">Create an account</a></p>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
