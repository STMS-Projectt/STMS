@model SourcingTenderSystem.ViewModels.Biometrics.BiometricVerifyViewModel
@{
    var first = !Model.HasFace && !Model.HasFingerprint;
    var canCamera = Model.Manage ? !Model.HasFace || Model.CanRenewFace : first || Model.HasFace;
    var canPhone = Model.Manage ? !Model.HasFingerprint : first || Model.HasFingerprint;
    ViewData["Title"] = Model.Manage ? "Sign-in security" : first ? "Set up verification" : "Verify your identity";
}
<section class="review-banner"><div class="review-copy">
<p class="banner-label"><partial name="_Icon" model='@("shield")' /> @(Model.Manage ? "ACCOUNT SECURITY" : "STEP 2 OF 2")</p>
<h1>@ViewData["Title"]</h1>
<p>@(first ? "Set up at least one method before opening your workspace. You can add the other in Sign-in security." : Model.Manage ? "See your registered methods and add a backup." : "Use one of your registered methods to continue.")</p>
</div><div class="banner-art" aria-hidden="true"><span></span><span></span><span></span></div></section>
<div data-bio data-manage="@(Model.Manage ? "true" : "false")" data-camera="@Url.Action("Camera")" data-phone-options="@Url.Action("PhoneOptions")" data-phone="@Url.Action("Phone")">
    @Html.AntiForgeryToken()
    @if (Model.Manage && (canCamera || canPhone))
    {
        <section class="surface detail-card mb-3"><label class="form-label" for="bio-password">Current password</label><input class="form-control" id="bio-password" type="password" autocomplete="current-password" /><p class="field-hint">Required when adding another verification method.</p></section>
    }
    <div class="dashboard-grid">
        <section class="surface detail-card">
            <div class="card-heading"><span class="icon-tile tone-blue"><partial name="_Icon" model='@("shield")' /></span><span class="status-pill @(Model.HasFace ? "status-positive" : "status-neutral")">@(Model.HasFace ? "Registered" : "Not registered")</span></div>
            <h2>Face recognition</h2><p class="subtle">Face++ processes a camera image to register or match your face. Sit in good light with only your face in view.</p>
            @if (canCamera)
            {
                <video data-preview hidden autoplay muted playsinline class="w-100 rounded mb-3" aria-label="Camera preview"></video>
                <div class="button-row"><button type="button" class="btn btn-outline-secondary" data-open-camera>Start camera</button>
                <button type="button" class="btn btn-primary" data-capture disabled>@(Model.CanRenewFace ? "Renew face registration" : Model.HasFace ? "Verify face" : "Register face")</button>
                <button type="button" class="btn btn-outline-secondary" data-stop-camera hidden>Stop camera</button></div>
            }
        </section>
        <section class="surface detail-card">
            <div class="card-heading"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("check")' /></span><span class="status-pill @(Model.HasFingerprint ? "status-positive" : "status-neutral")">@(Model.HasFingerprint ? "Registered" : "Not registered")</span></div>
            <h2>Phone fingerprint</h2><p class="subtle">Open this site on your phone and follow its passkey prompt. Your phone may offer its fingerprint sensor or another screen-unlock method.</p>
            @if (canPhone) { <button type="button" class="btn btn-outline-secondary" data-phone-button data-create="@(!Model.HasFingerprint ? "true" : "false")">@(Model.HasFingerprint ? "Verify with phone" : "Set up on phone")</button> }
        </section>
    </div>
    <p class="mt-3" data-bio-status role="status" aria-live="polite"></p>
    <div class="button-row">
        @if (Model.Manage && !first) { <a class="btn btn-primary" href="@Model.ReturnUrl">Continue to workspace</a> }
        @if (!Model.Manage) { <form asp-action="Logout" method="post"><button type="submit" class="btn btn-outline-secondary">Back to sign in</button></form> }
    </div>
</div>
@section Scripts { <script src="~/js/biometrics.js" asp-append-version="true" defer></script> }
