@inject SourcingTenderSystem.Services.Biometrics.FaceLab FaceLab
@model SourcingTenderSystem.ViewModels.Biometrics.BiometricVerifyViewModel
@{
    var reference = Model.Manage && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier) is { } claim && FaceLab.HasReference(claim.Value);
    var first = !Model.HasFace && !Model.HasFingerprint;
    var canPhone = Model.Manage ? !Model.HasFingerprint : first || Model.HasFingerprint;
    ViewData["Title"] = Model.Manage ? "Sign-in security" : first ? "Set up verification" : "Verify your identity";
}
<section class="review-banner"><div class="review-copy">
<p class="banner-label"><partial name="_Icon" model='@("shield")' /> @(Model.Manage ? "ACCOUNT SECURITY" : "STEP 2 OF 2")</p>
<h1>@ViewData["Title"]</h1>
<p>@(first ? "Set up at least one method before opening your workspace. You can add the other in Sign-in security." : Model.Manage ? "See your registered methods and add a backup." : "Use one of your registered methods to continue.")</p>
</div><div class="banner-art" aria-hidden="true"><span></span><span></span><span></span></div></section>
<div data-bio data-manage="@(Model.Manage ? "true" : "false")" data-phone-options="@Url.Action("PhoneOptions")" data-phone="@Url.Action("Phone")">
    @Html.AntiForgeryToken()
    @if (Model.Manage && canPhone)
    {
        <section class="surface detail-card mb-3"><label class="form-label" for="bio-password">Current password</label><input class="form-control" id="bio-password" type="password" autocomplete="current-password" /><p class="field-hint">Required when adding another verification method.</p></section>
    }
    <div class="dashboard-grid">
        <section class="surface detail-card" data-face-lab data-start="@Url.Action("FaceLabStart")" data-frame="@Url.Action("FaceLabCapture")">
            <div class="card-heading"><span class="icon-tile tone-blue"><partial name="_Icon" model='@("shield")' /></span><span class="status-pill status-neutral">Academic demo</span></div>
            <h2>Face recognition</h2>
            <p class="subtle">Face++ compares camera frames. This demo sends frames to Face++ when you capture them and cannot sign you in.</p>
            @if (Model.Manage && FaceLab.Enabled)
            {
                @if (!reference)
                {
                    <label class="form-label" for="face-lab-password">Confirm your current password</label>
                    <input type="password" class="form-control mb-2" id="face-lab-password" autocomplete="current-password" />
                }
                <div class="button-row">
                    <button type="button" class="btn btn-outline-primary" data-face-start data-enroll="@(!reference ? "true" : "false")">@(reference ? "Try face comparison" : "Enroll face reference")</button>
                    <button type="button" class="btn btn-outline-secondary" data-face-stop hidden>Stop camera</button>
                </div>
                <div data-face-guide hidden class="position-relative mt-3" style="max-width:26rem">
                    <video data-face-video muted playsinline class="w-100 rounded bg-dark" aria-label="Live camera preview"></video>
                    <div aria-hidden="true" class="position-absolute top-50 start-50 translate-middle rounded-circle border border-3 border-light" style="width:43%;height:78%;pointer-events:none"></div>
                </div>
                <p class="mt-2 mb-2" data-face-status role="status" aria-live="polite"></p>
                <button type="button" class="btn btn-primary" data-face-capture hidden>Capture frame</button>
            }
            else
            {
                <p class="field-hint">Camera comparison is unavailable. You can continue with your passkey.</p>
            }
        </section>
        <section class="surface detail-card">
            <div class="card-heading"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("check")' /></span><span class="status-pill @(Model.HasFingerprint ? "status-positive" : "status-neutral")">@(Model.HasFingerprint ? "Registered" : "Not registered")</span></div>
            <h2>Phone fingerprint</h2><p class="subtle">Open this site on your phone and follow its passkey prompt. Your phone may offer its fingerprint sensor or another screen-unlock method.</p>
            @if (canPhone) { <button type="button" class="btn btn-outline-secondary" data-phone-button data-create="@(!Model.HasFingerprint ? "true" : "false")">@(Model.HasFingerprint ? "Verify with phone" : "Set up on phone")</button> }
        </section>
    </div>
    @if (reference)
    {
        <form asp-action="FaceLabDelete" method="post" class="mt-3" data-workspace-confirm="Remove your stored face reference?">
            <button type="submit" class="btn btn-outline-secondary">Remove stored face reference</button>
        </form>
    }
    <p class="mt-3" data-bio-status role="status" aria-live="polite"></p>
    <div class="button-row">
        @if (Model.Manage && !first) { <a class="btn btn-primary" href="@Model.ReturnUrl">Continue to workspace</a> }
        @if (!Model.Manage) { <form asp-action="Logout" method="post"><button type="submit" class="btn btn-outline-secondary">Back to sign in</button></form> }
    </div>
</div>
@section Scripts { <script src="~/js/biometrics.js" asp-append-version="true" defer></script><script src="~/js/face-lab.js" asp-append-version="true" defer></script> }
