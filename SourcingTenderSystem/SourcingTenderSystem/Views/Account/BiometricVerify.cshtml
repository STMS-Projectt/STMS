@model SourcingTenderSystem.ViewModels.Biometrics.BiometricVerifyViewModel
@{
    ViewData["Title"] = Model.Mode == "EnrollAndVerify" ? "First-Time Biometric Setup" : "Biometric Verification Required";
}

<style>
    .verify-tab-group {
        display: flex;
        background: #f1f5f9;
        padding: 4px;
        border-radius: 12px;
        gap: 6px;
        margin-bottom: 20px;
        border: 1px solid #e2e8f0;
    }
    .verify-tab-btn {
        flex: 1;
        border: none;
        outline: none;
        background: transparent;
        padding: 10px 14px;
        font-size: 0.95rem;
        font-weight: 600;
        color: #475569;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        user-select: none;
    }
    .verify-tab-btn:hover { color: #0f172a; background: rgba(255,255,255,0.6); }
    .verify-tab-btn.active {
        background: #0284c7 !important;
        color: #fff !important;
        box-shadow: 0 2px 6px rgba(2,132,199,0.35);
    }
    .face-frame { position: relative; display: inline-block; }
    .face-oval {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 160px; height: 200px;
        border: 3px solid #0ea5e9;
        border-radius: 50%;
        pointer-events: none;
        display: none;
        box-shadow: 0 0 0 4px rgba(14,165,233,0.2);
    }
    .face-oval.visible { display: block; }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="card-header bg-dark text-white p-4 text-center">
                    <div class="mb-2" style="font-size: 2.5rem;">🛡️</div>
                    <h4 class="fw-bold mb-1">
                        @(Model.Mode == "EnrollAndVerify" ? "First-Time Biometric Security Setup" : "Biometric Identity Verification")
                    </h4>
                    <p class="text-white-50 small mb-0">
                        Authenticated as: <strong>@Model.FullName</strong> (@Model.UserEmail)
                    </p>
                </div>

                <div class="card-body p-4">
                    <div id="verifyAlert" class="alert d-none mb-4" role="alert"></div>

                    @if (Model.Mode == "EnrollAndVerify")
                    {
                        <div class="alert alert-info border-0 mb-4">
                            <strong>First Login Security Setup:</strong>
                            Scan your face using the live camera to register your biometric profile.
                            Face++ AI verifies a real face is present — covering the camera will not be accepted.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border mb-4">
                            <strong>Identity Check:</strong>
                            Verify your face or fingerprint to access your dashboard.
                        </div>

                        @if (!string.IsNullOrEmpty(Model.FaceImageUrl))
                        {
                            <div class="d-flex align-items-center justify-content-between p-2 bg-light rounded border mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@Model.FaceImageUrl" alt="Registered Face" style="width: 44px; height: 44px; object-fit: cover; border-radius: 50%; border: 2px solid #0284c7;" />
                                    <div>
                                        <small class="text-muted d-block">Registered Face ID</small>
                                        <strong class="text-dark small">Face++ Verified</strong>
                                    </div>
                                </div>
                                <a asp-action="BiometricVerify" asp-route-email="@Model.UserEmail" asp-route-reset="true" class="btn btn-outline-danger btn-sm">
                                    🔄 Re-enroll
                                </a>
                            </div>
                        }
                    }

                    <!-- Tab Switcher -->
                    <div class="verify-tab-group" role="tablist">
                        <button type="button" class="verify-tab-btn active" id="tab-face" onclick="switchVerifyTab('face')">
                            📷 Face Recognition
                        </button>
                        <button type="button" class="verify-tab-btn" id="tab-fingerprint" onclick="switchVerifyTab('fingerprint')">
                            👆 Fingerprint
                        </button>
                    </div>

                    <!-- Face Pane -->
                    <div id="pane-face" style="display:block;">
                        <div class="text-center my-3">
                            <div class="face-frame bg-dark rounded-4 overflow-hidden shadow-sm" style="width:320px;height:240px; display:inline-block;">
                                <video id="verifyFaceVideo" width="320" height="240" autoplay playsinline
                                       style="width:100%;height:100%;object-fit:cover;display:block;"></video>
                                <div class="face-oval" id="faceOval"></div>
                            </div>
                            <small class="text-muted d-block mt-2">
                                📡 Live camera feed only — powered by Face++ AI face detection
                            </small>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="button" id="btnStartCam" class="btn btn-outline-primary py-2 fw-semibold">
                                📷 Open Live Camera
                            </button>
                            <button type="button" id="btnVerifyFace" class="btn btn-primary py-2 fw-semibold" disabled>
                                🛡️ @(Model.Mode == "EnrollAndVerify" ? "Capture & Register My Face" : "Verify Face & Sign In")
                            </button>
                        </div>

                        @if (Model.Mode != "EnrollAndVerify")
                        {
                            <div class="text-center mt-3">
                                <a asp-action="BiometricVerify" asp-route-email="@Model.UserEmail" asp-route-reset="true" class="text-secondary small text-decoration-none">
                                    🔄 Need to update or re-register your face? Click here
                                </a>
                            </div>
                        }
                    </div>

                    <!-- Fingerprint Pane -->
                    <div id="pane-fingerprint" style="display:none;">
                        <div class="text-center py-5 bg-light rounded-4 border my-3">
                            <div style="font-size:4rem;">👆</div>
                            <h5 class="fw-bold text-dark mt-2">Platform Biometric Sensor</h5>
                            <p class="text-muted small px-4 mb-0">
                                Touch your fingerprint reader, Windows Hello, or Touch ID to @(Model.Mode == "EnrollAndVerify" ? "register" : "authenticate").
                            </p>
                        </div>
                        <div class="d-grid">
                            <button type="button" id="btnVerifyFingerprint" class="btn btn-primary py-2 fw-semibold">
                                👆 @(Model.Mode == "EnrollAndVerify" ? "Register Fingerprint & Sign In" : "Touch to Authenticate")
                            </button>
                        </div>
                    </div>

                    <div class="text-center mt-4 pt-3 border-top">
                        <a asp-action="Login" class="text-muted text-decoration-none small">⬅️ Sign in with a different account</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function switchVerifyTab(tab) {
        document.getElementById('pane-face').style.display = tab === 'face' ? 'block' : 'none';
        document.getElementById('pane-fingerprint').style.display = tab === 'fingerprint' ? 'block' : 'none';
        document.getElementById('tab-face').classList.toggle('active', tab === 'face');
        document.getElementById('tab-fingerprint').classList.toggle('active', tab === 'fingerprint');
        if (tab !== 'face' && window.biometrics) window.biometrics.stopCamera();
    }
</script>

@section Scripts {
    <script src="~/js/biometrics.js"></script>
    <script>
        const userEmail = "@Model.UserEmail";
        const returnUrl = "@Model.ReturnUrl";
        const mode = "@(Model.Mode == "EnrollAndVerify" ? "Enroll" : "Verify")";
        const alertBox = document.getElementById("verifyAlert");

        function showAlert(msg, isSuccess) {
            alertBox.className = "alert " + (isSuccess ? "alert-success" : "alert-danger");
            alertBox.innerHTML = (isSuccess ? "✅ " : "⚠️ ") + msg;
            alertBox.classList.remove("d-none");
            alertBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }

        function setLoading(btn, loading, label) {
            btn.disabled = loading;
            btn.textContent = loading ? "⏳ Processing with Face++ AI..." : label;
        }

        // Open Camera
        document.getElementById("btnStartCam").addEventListener("click", async () => {
            try {
                await window.biometrics.startCamera("verifyFaceVideo");
                document.getElementById("btnVerifyFace").disabled = false;
                document.getElementById("faceOval").classList.add("visible");
                showAlert("Camera active — position your face inside the oval and click Verify.", true);
            } catch (err) {
                showAlert(err.message, false);
            }
        });

        // Face Verify / Enroll
        const faceBtn = document.getElementById("btnVerifyFace");
        const faceBtnLabel = faceBtn.textContent;
        faceBtn.addEventListener("click", async () => {
            let snapshot;
            try {
                snapshot = window.biometrics.captureSnapshot("verifyFaceVideo");
            } catch (err) {
                showAlert(err.message, false);
                return;
            }

            setLoading(faceBtn, true, faceBtnLabel);
            showAlert("Sending photo to Face++ AI for facial recognition...", true);

            try {
                const res = await fetch('/Account/ProcessBiometricVerify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        email: userEmail,
                        biometricType: "Face",
                        mode: mode,
                        imageBase64: snapshot,
                        returnUrl: returnUrl
                    })
                });

                const data = await res.json();
                if (res.ok && data.success) {
                    showAlert(data.message, true);
                    window.biometrics.stopCamera();
                    setTimeout(() => window.location.href = data.redirectUrl || "/", 800);
                } else {
                    showAlert(data.message || "Verification failed.", false);
                    setLoading(faceBtn, false, faceBtnLabel);
                }
            } catch {
                showAlert("Network error — please try again.", false);
                setLoading(faceBtn, false, faceBtnLabel);
            }
        });

        // Fingerprint Verify / Enroll
        const fpBtn = document.getElementById("btnVerifyFingerprint");
        const fpBtnLabel = fpBtn.textContent;
        fpBtn.addEventListener("click", async () => {
            setLoading(fpBtn, true, fpBtnLabel);
            showAlert("Waiting for fingerprint sensor...", true);

            try {
                let cred;
                if (mode === "Enroll") {
                    cred = await window.biometrics.enrollFingerprint(userEmail);
                } else {
                    cred = await window.biometrics.verifyFingerprint();
                }

                const res = await fetch('/Account/ProcessBiometricVerify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        email: userEmail,
                        biometricType: "Fingerprint",
                        mode: mode,
                        credentialId: cred.credentialId,
                        returnUrl: returnUrl
                    })
                });

                const data = await res.json();
                if (res.ok && data.success) {
                    showAlert(data.message, true);
                    setTimeout(() => window.location.href = data.redirectUrl || "/", 800);
                } else {
                    showAlert(data.message || "Fingerprint verification failed.", false);
                    setLoading(fpBtn, false, fpBtnLabel);
                }
            } catch (err) {
                showAlert(err.message, false);
                setLoading(fpBtn, false, fpBtnLabel);
            }
        });
    </script>
}
