@model SourcingTenderSystem.ViewModels.Awards.AwardDetailsViewModel
@{
    ViewData["Title"] = "Award Decision Dossier";
}

<div class="container-fluid py-4">
    <!-- Header Navigation -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Awards List
            </a>
            <h2 class="h3 fw-bold text-dark mb-0">
                Award Decision: <span class="text-primary">@Model.TenderTitle</span>
            </h2>
            <small class="text-muted">Tender ID: #@Model.TenderId | Department: @Model.DepartmentName | Requisition: @Model.RequisitionTitle</small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button onclick="window.print()" class="btn btn-outline-secondary">
                <i class="bi bi-printer me-1"></i> Print Award Certificate
            </button>
            @if (Model.IsAwarded)
            {
                <span class="badge bg-success fs-6 px-3 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-check-circle-fill me-1"></i> Officially Awarded
                </span>
            }
            else
            {
                <a asp-action="Confirm" asp-route-id="@Model.TenderId" class="btn btn-success shadow-sm">
                    <i class="bi bi-award-fill me-1"></i> Confirm Award
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Left: Supplier and Offer Dossier -->
        <div class="col-lg-8">
            <!-- Winning Supplier Card -->
            <div class="card border-0 shadow-sm border-start border-4 border-success mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-building-check text-success me-2"></i>Winning Supplier Profile
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <span class="text-muted small d-block">Company Name</span>
                            <h4 class="fw-bold text-dark mb-2">@Model.CompanyName</h4>
                            <span class="text-muted small d-block">Commercial Registration (CR)</span>
                            <p class="fw-semibold text-dark mb-2">@(string.IsNullOrEmpty(Model.CommercialRegNo) ? "N/A" : Model.CommercialRegNo)</p>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted small d-block">Tax Registration Number</span>
                            <p class="fw-semibold text-dark mb-2">@(string.IsNullOrEmpty(Model.TaxNumber) ? "N/A" : Model.TaxNumber)</p>
                            <span class="text-muted small d-block">Contact Phone</span>
                            <p class="fw-semibold text-dark mb-2">@(string.IsNullOrEmpty(Model.ContactPhone) ? "N/A" : Model.ContactPhone)</p>
                            <span class="text-muted small d-block">Official Address</span>
                            <p class="text-dark mb-0">@(string.IsNullOrEmpty(Model.Address) ? "N/A" : Model.Address)</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Financial Offer Details -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-cash-stack text-primary me-2"></i>Award Contract Financials
                        </h5>
                        <span class="badge bg-light text-dark border">Bid ID: #@Model.BidId</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4 text-center">
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded">
                                <span class="text-muted small text-uppercase d-block">Total Award Value</span>
                                <h3 class="fw-bold text-success mb-0">@Model.TotalAwardAmount.ToString("N2") @Model.Currency</h3>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded">
                                <span class="text-muted small text-uppercase d-block">Committed Delivery Time</span>
                                <h3 class="fw-bold text-primary mb-0">@Model.DeliveryDays Days</h3>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded">
                                <span class="text-muted small text-uppercase d-block">Offer Validity</span>
                                <h3 class="fw-bold text-secondary mb-0">@Model.ValidityDays Days</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Line Items Breakdown Table -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-list-check text-primary me-2"></i>Itemized Bill of Quantities (BOQ)
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (!Model.LineItems.Any())
                    {
                        <div class="text-center py-4 text-muted small">
                            Lump-sum bid or detailed itemized BOQ not specified.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-uppercase fs-7 text-muted">
                                    <tr>
                                        <th class="ps-4">Item Name</th>
                                        <th>Quantity</th>
                                        <th>Unit Price</th>
                                        <th>Total Price</th>
                                        <th class="pe-4">Specifications</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.LineItems)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold text-dark">@item.ItemName</td>
                                            <td>@item.Quantity @item.Unit</td>
                                            <td>@item.UnitPrice.ToString("N2") @Model.Currency</td>
                                            <td class="fw-bold text-success">@item.TotalLinePrice.ToString("N2") @Model.Currency</td>
                                            <td class="pe-4 small text-muted">@item.Specifications</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right: Tender Scope & Decision History -->
        <div class="col-lg-4">
            <!-- Tender Scope Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-info-circle text-primary me-2"></i>Tender Scope
                    </h5>
                </div>
                <div class="card-body p-3">
                    <p class="text-secondary small mb-3">@Model.TenderDescription</p>
                    <h6 class="fw-bold text-dark fs-7 text-uppercase mb-2">Terms & Delivery Conditions</h6>
                    <div class="p-2 bg-light rounded text-muted small">
                        @(string.IsNullOrEmpty(Model.TenderTerms) ? "Standard procurement terms apply." : Model.TenderTerms)
                    </div>
                </div>
            </div>

            <!-- Approvals Audit Trail -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-shield-check text-success me-2"></i>Governance & Approvals Trail
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (!Model.ApprovalsTrail.Any())
                    {
                        <p class="text-muted small mb-0">No recorded approval steps.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var step in Model.ApprovalsTrail)
                            {
                                <li class="list-group-item px-0 py-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong class="text-dark">@step.ApproverName</strong>
                                        <span class="badge @(step.Decision == "Approved" ? "bg-success" : "bg-secondary")">
                                            @step.Decision
                                        </span>
                                    </div>
                                    <small class="text-muted d-block">@step.DecidedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                    @if (!string.IsNullOrEmpty(step.Comments))
                                    {
                                        <p class="mb-0 text-secondary small bg-light p-2 rounded mt-1">@step.Comments</p>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
