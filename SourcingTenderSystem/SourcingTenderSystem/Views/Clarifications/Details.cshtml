@model ClarificationThread
@{
    var row = Model.Record;
    ViewData["Title"] = "Clarification details";
    var kind = row.PurchaseRequisitionId.HasValue ? "request" : row.BidId.HasValue ? "bid" : row.SupplierApplicationId.HasValue ? "supplier" : "tender";
    var record = row.PurchaseRequisitionId ?? row.BidId ?? row.SupplierApplicationId ?? row.TenderId;
    var requested = row.RequestedDocumentType != null;
}
<a class="back-link" asp-action="Index" asp-route-kind="@kind" asp-route-recordId="@record"><partial name="_Icon" model='@("back")' /> @L.T("Transaction history")</a>
<header class="page-heading stms-hero admin-record-hero"><div><p class="eyebrow">@L.F("Clarification #{0}", row.Id)</p><h1>@row.Subject</h1>
<p>@(row.PurchaseRequisition?.Title ?? row.Tender?.Title ?? row.Bid?.Tender.Title ?? row.SupplierApplication?.CompanyName) · @kind #@record</p></div><partial name="_ClarificationStatus" model="row.Status" /></header>
@if (TempData["ClarificationError"] is string error) { <div class="alert alert-warning" role="alert">@L.T(error)</div> }
<div class="stack clarification-conversation">
    <section class="surface detail-card"><h2>@L.T("Question")</h2>
        <p class="subtle">@(row.SenderEmployeeProfile?.FullName ?? row.SenderSupplierProfile?.CompanyName) → @(row.ReceiverEmployeeProfile?.FullName ?? row.ReceiverSupplierProfile?.CompanyName) · @row.CreatedAt.ToString("dd MMM yyyy HH:mm", L.DisplayCulture) UTC</p>
        <p class="mb-0" style="white-space:pre-wrap;overflow-wrap:anywhere">@row.Description</p>
        @if (requested) { <p class="record-panel-label mt-3 mb-0"><partial name="_Icon" model='@("file")' /> @L.F("Requested PDF: {0}", L.T(row.RequestedDocumentType))</p> }
    </section>
    @if (row.Response is not null)
    {
        <section class="surface detail-card clarification-reply"><h2>@L.T("Response")</h2><p class="subtle">@(row.ReceiverEmployeeProfile?.FullName ?? row.ReceiverSupplierProfile?.CompanyName) · @row.AnsweredAt?.ToString("dd MMM yyyy HH:mm", L.DisplayCulture) UTC</p><p class="record-terms mb-0">@row.Response</p></section>
    }
    @if (row.AttachmentName is not null)
    {
        <section class="surface detail-card"><h2>@L.T("Supporting document")</h2>
            <div class="record-list record-list-inset"><article class="record-card">
                <div class="record-name"><span class="avatar"><partial name="_Icon" model='@("file")' /></span><span>@row.AttachmentName<small>@L.T(row.RequestedDocumentType)</small></span></div>
                <dl class="record-facts"><div><dt>@L.T("Review status")</dt><dd>@L.T(row.AttachmentAddedAt.HasValue ? "Approved and added" : row.Status == "Resolved" ? "Closed without adding" : "Awaiting approval")</dd></div>
                    @if (row.AttachmentExpiryDate.HasValue) { <div><dt>@L.T("Expires")</dt><dd>@row.AttachmentExpiryDate.Value.ToString("dd MMM yyyy", L.DisplayCulture)</dd></div> }
                </dl>
                <div class="record-action">
                    @if (Model.CanDownloadAttachment) { <a class="record-icon-action" asp-action="DownloadAttachment" asp-route-id="@row.Id" aria-label="@L.T("Download supplied PDF")" data-tooltip="@L.T("Download PDF")"><partial name="_Icon" model='@("download")' /></a> }
                    @if (Model.CanAddAttachment)
                    {
                        <form asp-action="AddAttachment" asp-route-id="@row.Id" method="post" data-workspace-confirm="Approve and add this file to the @(row.BidId.HasValue ? "bid" : "supplier application")?" onsubmit="return window.stmsWorkspaceReady || confirm(this.dataset.workspaceConfirm);">
                            <button type="submit" class="record-icon-action" aria-label="@L.T("Approve and add document")" data-tooltip="@L.T("Approve and add")"><partial name="_Icon" model='@("check")' /></button>
                        </form>
                    }
                </div>
            </article></div>
        </section>
    }
    @if (Model.CanAnswer)
    {
        <form class="surface form-card" asp-action="Answer" asp-route-id="@row.Id" method="post" enctype="multipart/form-data">
            @if (requested)
            {
                <div class="form-grid mb-3">
                    <label class="field">@L.F("Requested {0} (PDF)", L.T(row.RequestedDocumentType))<input class="form-control" name="attachment" type="file" accept=".pdf,application/pdf" required /></label>
                    @if (row.SupplierApplicationId.HasValue) { <label class="field">@L.T("Expiry date (optional)")<input class="form-control" name="expiryDate" type="date" /></label> }
                </div><p class="field-hint">@L.T("Up to 10 MB. The sourcing officer will review the file before adding it.")</p>
            }
            <label for="response" class="form-label">@(requested ? "Notes (optional)" : "Your response")</label>
            <textarea class="form-control mb-3" id="response" name="response" maxlength="2000" rows="4" required="@(!requested)"></textarea>
            <button class="btn btn-primary" type="submit">@(requested ? "Send document" : "Send response")</button>
        </form>
    }
    @if (Model.CanResolve)
    { <form asp-action="Resolve" asp-route-id="@row.Id" method="post" data-workspace-confirm="@(row.AttachmentName != null ? "Close this clarification without adding the file?" : null)" onsubmit="return !this.dataset.workspaceConfirm || window.stmsWorkspaceReady || confirm(this.dataset.workspaceConfirm);"><button class="btn btn-outline-secondary" type="submit">@(row.AttachmentName != null ? "Resolve without adding" : "Mark as resolved")</button></form> }
    @if (row.ResolvedAt.HasValue) { <p class="subtle">@L.F("Resolved {0} UTC", row.ResolvedAt.Value.ToString("dd MMM yyyy HH:mm", L.DisplayCulture))</p> }
</div>
