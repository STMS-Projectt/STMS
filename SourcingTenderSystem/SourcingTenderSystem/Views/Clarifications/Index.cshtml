@model ClarificationInbox
@{
    ViewData["Title"] = Model.RecordId.HasValue ? "Clarification history" : "Clarifications";
    var pending = Model.Rows.Count(r => r.Status == "Pending");
    var resolved = Model.Rows.Count(r => r.Status == "Resolved");
}
<header class="page-heading stms-hero clarification-hero">
    <div><p class="eyebrow">TRANSACTION COMMUNICATION</p><h1>@ViewData["Title"]</h1>
    <p>@(Model.Route?.Title ?? (User.IsInRole(SourcingTenderSystem.Security.Roles.Admin) ? "Review clarification requests and responses across the workspace." : "Questions and responses involving your account."))</p></div>
    <div class="clarification-hero-side">
        <div class="clarification-hero-total"><strong>@Model.Rows.Count</strong><span>@(Model.Rows.Count == 1 ? "conversation" : "conversations")</span></div>
        <div class="button-row">
        @if (Model.RecordId.HasValue) { <a class="btn btn-outline-secondary" asp-action="Index">All clarifications</a> }
        @if (Model.Route is not null && Model.Kind != "request") { <a data-workspace-dialog class="btn btn-primary" asp-action="Create" asp-route-kind="@Model.Kind" asp-route-recordId="@Model.RecordId"><partial name="_Icon" model='@("plus")' /> New clarification</a> }
        </div>
    </div>
</header>
<div class="clarification-summary clarification-admin-summary" aria-label="Clarification summary">
    <div><span class="icon-tile tone-blue"><partial name="_Icon" model='@("mail")' /></span><strong>@Model.Rows.Count</strong><span>Total conversations</span></div>
    <div><span class="icon-tile tone-amber"><partial name="_Icon" model='@("clock")' /></span><strong>@pending</strong><span>Awaiting response</span></div>
    <div><span class="icon-tile tone-blue"><partial name="_Icon" model='@("mail")' /></span><strong>@Model.Rows.Count(r => r.Status == "Answered")</strong><span>Answered</span></div>
    <div><span class="icon-tile tone-teal"><partial name="_Icon" model='@("check")' /></span><strong>@resolved</strong><span>Resolved</span></div>
</div>
@if (Model.RecordId.HasValue && Model.Route == null)
{ <p class="subtle">@(Model.Kind == "request" ? "Only the request author and the responsible sourcing officer can start a clarification. Submit drafts for review first; an officer may need to take review." : "There are no eligible recipients for a new clarification at this stage.")</p> }
@if (TempData["ClarificationError"] is string error)
{ <div class="alert alert-warning" role="alert">@error</div> }
<section class="surface directory dept-directory clarification-directory" data-directory>
<div class="dept-directory-heading"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("mail")' /></span><div><h2>Conversation history</h2><p>Questions, responses, and their current status.</p></div></div>
@if (Model.Rows.Count == 0)
{
    <div class="empty-state clarification-empty"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("mail")' /></span><h2>No clarifications yet</h2><p>Questions and responses will appear here after a clarification is sent.</p></div>
}
else
{
    <partial name="_ListFilters" model='@("Search clarifications", Model.Rows.Select(r => r.Status))' />
        <partial name="_DirectoryPages" model='@("Clarification pages")' />
        <div class="record-list clarification-records" data-record-list>
            @foreach (var row in Model.Rows)
            {
                var reference = row.PurchaseRequisitionId is int requestId ? $"Request #{requestId}" :
                    row.BidId is int bidId ? $"Bid #{bidId}" : row.TenderId is int tenderId ? $"Tender #{tenderId}" :
                    row.SupplierApplicationId is int supplierId ? $"Supplier application #{supplierId}" : "No linked record";
                <article class="record-card clarification-record" data-record data-status="@row.Status">
                    <div class="record-name"><span class="avatar"><partial name="_Icon" model='@("mail")' /></span><span>@row.Subject<small>#@row.Id · @row.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</small></span></div>
                    <dl class="record-facts">
                        <div><dt class="record-field-icon" title="@reference"><partial name="_Icon" model='@("file")' /><span class="visually-hidden">@reference</span></dt><dd>@(row.PurchaseRequisition?.Title ?? row.Tender?.Title ?? row.Bid?.Tender.Title ?? row.SupplierApplication?.CompanyName ?? "—")<small class="d-block subtle">@reference</small></dd></div>
                        <div><dt class="record-field-icon" title="From"><partial name="_Icon" model='@("users")' /><span class="visually-hidden">From</span></dt><dd>@(row.SenderEmployeeProfile?.FullName ?? row.SenderSupplierProfile?.CompanyName ?? "—")</dd></div>
                        <div><dt class="record-field-icon" title="To"><partial name="_Icon" model='@("arrow")' /><span class="visually-hidden">To</span></dt><dd>@(row.ReceiverEmployeeProfile?.FullName ?? row.ReceiverSupplierProfile?.CompanyName ?? "—")</dd></div>
                        <div><dt class="visually-hidden">Status</dt><dd><partial name="_ClarificationStatus" model="row.Status" />
                            <small>@(row.AnsweredAt is DateTime answered ? $"Last reply {answered:dd MMM yyyy HH:mm} UTC" : "No reply yet")</small>
                        </dd></div>
                    </dl>
                    <div class="record-action"><a data-workspace-dialog="details" class="record-icon-action" asp-action="Details" asp-route-id="@row.Id" aria-label="View clarification: @row.Subject" data-tooltip="View details"><partial name="_Icon" model='@("eye")' /></a></div>
                </article>
            }
        </div>
}
<partial name="_ListFilterEmpty" />
</section>
