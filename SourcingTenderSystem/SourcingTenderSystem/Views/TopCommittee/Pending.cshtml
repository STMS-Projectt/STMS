@model SourcingTenderSystem.ViewModels.TopCommittee.TopCommitteePendingViewModel
@{
    ViewData["Title"] = "Top Committee - Pending Decisions";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>Top Committee Decision Hub
            </h2>
            <p class="text-muted mb-0">High-value & strategic tenders awaiting collective committee review and voting.</p>
        </div>
        <div>
            <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill shadow-sm">
                @Model.TotalCount Pending Decision
            </span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Pending" class="row g-3 align-items-center">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control border-start-0" placeholder="Search by Tender Title, Department, or Supplier..." />
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Search</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Tenders Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Tenders.Any())
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-clipboard2-check text-muted display-4"></i>
                    </div>
                    <h5 class="fw-semibold text-secondary">No High-Value Tenders Pending Decision</h5>
                    <p class="text-muted small">Tenders referred by the Sourcing Manager for Top Committee vote will appear here.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase fs-7 text-muted">
                            <tr>
                                <th class="ps-4">Tender ID</th>
                                <th>Tender Title</th>
                                <th>Department</th>
                                <th>Recommended Supplier</th>
                                <th>Offer Value</th>
                                <th>Manager Status</th>
                                <th>Committee Votes</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Tenders)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">#@item.TenderId</td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.TenderTitle</div>
                                        <small class="text-muted">Report #@item.EvaluationReportId</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@item.DepartmentName</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-primary">@item.RecommendedSupplierName</div>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-success">@item.RecommendedPrice.ToString("N2") @item.Currency</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success border border-success">
                                            @item.ManagerDecision
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="progress flex-grow-1 me-2" style="height: 6px;">
                                                <div class="progress-bar bg-primary" role="progressbar" 
                                                     style="width: @(item.TotalMembers > 0 ? (item.VotesRecorded * 100 / item.TotalMembers) : 0)%">
                                                </div>
                                            </div>
                                            <small class="text-muted fw-bold">@item.VotesRecorded/@item.TotalMembers</small>
                                        </div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            <a asp-action="Details" asp-route-id="@item.TenderId" class="btn btn-sm btn-outline-primary px-3 shadow-sm">
                                                <i class="bi bi-eye me-1"></i> Review & Vote
                                            </a>
                                            <a asp-action="Results" asp-route-id="@item.TenderId" class="btn btn-sm btn-outline-secondary px-2">
                                                <i class="bi bi-pie-chart"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
