@model SourcingTenderSystem.ViewModels.TopCommittee.TopCommitteeResultsViewModel
@{
    ViewData["Title"] = "Top Committee - Voting Results";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Pending" class="btn btn-sm btn-outline-secondary mb-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Pending Decisions
            </a>
            <h2 class="h3 fw-bold text-dark mb-0">
                Official Ballot Results: <span class="text-primary">@Model.TenderTitle</span>
            </h2>
            <small class="text-muted">Tender ID: #@Model.TenderId | Department: @Model.DepartmentName</small>
        </div>
        <div>
            <span class="badge @(Model.TenderStatus == "Committee Approved" ? "bg-success" : Model.TenderStatus == "Committee Rejected" ? "bg-danger" : "bg-warning text-dark") fs-6 px-3 py-2 rounded-pill shadow-sm">
                @Model.FinalOutcome
            </span>
        </div>
    </div>

    <!-- Tally Metrics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <h6 class="text-muted text-uppercase fs-7 mb-1">Total Members</h6>
                <h2 class="fw-bold text-dark mb-0">@Model.TotalMembersCount</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-3 border-bottom border-4 border-success">
                <h6 class="text-muted text-uppercase fs-7 mb-1">Approve Votes</h6>
                <h2 class="fw-bold text-success mb-0">@Model.ApproveCount</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-3 border-bottom border-4 border-danger">
                <h6 class="text-muted text-uppercase fs-7 mb-1">Reject Votes</h6>
                <h2 class="fw-bold text-danger mb-0">@Model.RejectCount</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-3 border-bottom border-4 border-warning">
                <h6 class="text-muted text-uppercase fs-7 mb-1">Need Clarification</h6>
                <h2 class="fw-bold text-warning mb-0">@Model.NeedMoreDetailsCount</h2>
            </div>
        </div>
    </div>

    <!-- Member Votes Breakdown Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-file-earmark-check text-primary me-2"></i>Individual Member Ballots & Justifications
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-muted">
                        <tr>
                            <th class="ps-4">Member Name</th>
                            <th>Role</th>
                            <th>Decision</th>
                            <th>Selected Supplier</th>
                            <th>Justification & Rationale</th>
                            <th class="text-end pe-4">Voted At</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.MemberVotes)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">@v.MemberName</td>
                                <td>
                                    <span class="badge bg-light text-dark border">@v.MemberRole</span>
                                </td>
                                <td>
                                    @if (v.Decision == "Approved")
                                    {
                                        <span class="badge bg-success px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Approved
                                        </span>
                                    }
                                    else if (v.Decision == "Rejected")
                                    {
                                        <span class="badge bg-danger px-2 py-1">
                                            <i class="bi bi-x-circle me-1"></i>Rejected
                                        </span>
                                    }
                                    else if (v.Decision == "NeedMoreDetails")
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1">
                                            <i class="bi bi-question-circle me-1"></i>Clarification
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-2 py-1">Pending</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(v.SelectedSupplierName))
                                    {
                                        <span class="fw-semibold text-primary">@v.SelectedSupplierName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(v.Justification))
                                    {
                                        <span class="text-secondary small">@v.Justification</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">No comment recorded</span>
                                    }
                                </td>
                                <td class="text-end pe-4 text-muted small">
                                    @(v.VotedAt?.ToString("MMM dd, yyyy HH:mm") ?? "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Final Actions Bar -->
    <div class="d-flex justify-content-between align-items-center p-3 bg-white rounded shadow-sm">
        <div>
            <a asp-action="Details" asp-route-id="@Model.TenderId" class="btn btn-outline-secondary">
                <i class="bi bi-file-text me-1"></i> Re-examine Dossier
            </a>
        </div>
        <div class="d-flex gap-2">
            @if (Model.TenderStatus == "Committee Approved")
            {
                <a asp-controller="Awards" asp-action="Confirm" asp-route-id="@Model.TenderId" class="btn btn-success shadow-sm px-4">
                    <i class="bi bi-award-fill me-1"></i> Proceed to Final Award Confirmation
                </a>
            }
            else
            {
                <button class="btn btn-secondary" disabled>
                    <i class="bi bi-hourglass-split me-1"></i> Decision in Progress
                </button>
            }
        </div>
    </div>
</div>
