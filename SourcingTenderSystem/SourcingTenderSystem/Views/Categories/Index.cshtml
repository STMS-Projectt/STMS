@model IReadOnlyList<Category>
@{ ViewData["Title"] = "Supply categories"; }
<header class="page-heading stms-hero"><div><p class="eyebrow">ADMINISTRATION</p><h1>Supply categories</h1><p>Manage the categories that connect purchase requests to eligible suppliers.</p></div>
    <a class="btn btn-primary" data-workspace-dialog asp-action="Create"><partial name="_Icon" model='@("plus")' /> Add category</a>
</header>
<section class="surface directory dept-directory" data-directory>
    <div class="dept-directory-heading"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("filter")' /></span><div><h2>Available categories</h2><p>Search categories by name.</p></div></div>
    @if (Model.Count == 0) { <div class="empty-state"><h2>No categories yet</h2><p>Add the first category to enable supplier registration and new purchase requests.</p></div> }
    else
    {
        <partial name="_ListFilters" model='@("Search supply categories", Enumerable.Empty<string>())' />
        <partial name="_DirectoryPages" model='@("Category pages")' />
        <div class="record-list" data-record-list>
            @foreach (var category in Model)
            {
                <article class="record-card" data-record><div class="record-name"><span class="avatar"><partial name="_Icon" model='@("filter")' /></span><span>@category.Name</span></div></article>
            }
        </div>
        <partial name="_ListFilterEmpty" />
    }
</section>
