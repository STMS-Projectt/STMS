@model IReadOnlyList<Category>
@{ ViewData["Title"] = L.T("Supply categories"); }
<header class="page-heading stms-hero adm-hero"><span class="pr-hero-icon"><partial name="_Icon" model='@("filter")' /></span><div><p class="eyebrow">@L.T("ADMINISTRATION")</p><h1>@L.T("Supply categories")</h1><p>@L.T("Manage the categories that connect purchase requests to eligible suppliers.")</p></div>
    <a class="btn btn-primary" data-workspace-dialog asp-action="Create"><partial name="_Icon" model='@("plus")' /> @L.T("Add category")</a>
</header>
<section class="surface directory dept-directory" data-directory>
    <div class="dept-directory-heading"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("filter")' /></span><div><h2>@L.T("Available categories")</h2><p>@L.T("Search categories by name.")</p></div></div>
    @if (Model.Count == 0) { <div class="empty-state"><h2>@L.T("No categories yet")</h2><p>@L.T("Add the first category to enable supplier registration and new purchase requests.")</p></div> }
    else
    {
        <partial name="_ListFilters" model='@("Search supply categories", Enumerable.Empty<string>())' />
        <partial name="_DirectoryPages" model='@("Category pages")' />
        <div class="record-list" data-record-list>
            @foreach (var category in Model)
            {
                <article class="record-card" data-record><div class="record-name"><span class="avatar"><partial name="_Icon" model='@("filter")' /></span><span>@category.Name</span></div></article>
            }
        </div>
        <partial name="_ListFilterEmpty" />
    }
</section>
