@model BidItemFormViewModel
@* Shared fields for Create and Edit. Quantity is NOT here: it is fixed (the requested quantity). *@
<div class="mb-3">
    <label asp-for="UnitPrice" class="form-label"></label>
    <input asp-for="UnitPrice" type="number" step="0.01" min="0.01" class="form-control" />
    <span asp-validation-for="UnitPrice" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Notes" class="form-label"></label>
    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Notes" class="text-danger"></span>
</div>
@{ var current = ViewBag.BidItem as BidItem; }
<div class="mb-3">
    <label asp-for="SampleImage" class="form-label"></label>
    @if (current?.SampleImagePath != null)
    {
        <div class="mb-2"><img src="@Url.Action("ItemImage", "BidDocuments", new { id = current.Id })" alt="@current.SampleImageName" width="96" height="96" style="object-fit:cover;border-radius:8px" /></div>
    }
    <input asp-for="SampleImage" type="file" accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="form-control" />
    <div class="form-text">@L.T("JPG or PNG photo of the sample, maximum 10 MB. A new photo replaces the current one.")</div>
    <span asp-validation-for="SampleImage" class="text-danger"></span>
</div>
