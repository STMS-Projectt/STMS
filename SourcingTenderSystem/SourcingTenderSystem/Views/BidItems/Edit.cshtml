@model BidItemFormViewModel
@{
    var bidItem = (BidItem)ViewBag.BidItem;
    ViewData["Title"] = L.T("Edit price");
    ViewData["Bid"] = bidItem.Bid;
    ViewData["RequestedItem"] = bidItem.PurchaseRequisitionItem;
    ViewData["BidItem"] = bidItem;
    // The bid item id goes in the URL (/BidItems/Edit/12); the controller loads it again and checks the owner
    ViewData["FormAction"] = Url.Action("Edit", "BidItems", new { id = bidItem.Id });
    ViewData["SubmitText"] = L.T("Save");
}
<partial name="_BidItemForm" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/bid-item-form.js" asp-append-version="true"></script>
}
