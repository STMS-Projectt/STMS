@model BidItemFormViewModel
@{
    var bidItem = (BidItem)ViewBag.BidItem;
    var bid = bidItem.Bid;
    var item = bidItem.PurchaseRequisitionItem;
    ViewData["Title"] = "Edit price";
}
<h1>Edit price</h1>
<p>Bid for: <strong>@bid.Tender.Title</strong></p>

@* The requested item (read only) *@
<div class="card mb-3">
    <div class="card-header">Requested item</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Item</dt>
            <dd class="col-sm-9">@item.ItemName</dd>
            <dt class="col-sm-3">Specifications</dt>
            <dd class="col-sm-9">@item.Specifications</dd>
            <dt class="col-sm-3">Quantity</dt>
            <dd class="col-sm-9">@item.Quantity @item.Unit <small class="text-muted">(fixed by the requesting department)</small></dd>
            <dt class="col-sm-3">Currency</dt>
            <dd class="col-sm-9">@bid.Currency</dd>
        </dl>
    </div>
</div>

@* The bid item id goes in the URL (/BidItems/Edit/12); the controller loads it again and checks the owner *@
<form asp-action="Edit" asp-route-id="@bidItem.Id" method="post" asp-antiforgery="true" class="admin-form">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <partial name="_BidItemFields" model="Model" />
    <p class="form-text">Line total = unit price × @item.Quantity</p>
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-outline-secondary" asp-controller="Bids" asp-action="Details" asp-route-id="@bid.Id">Cancel</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
