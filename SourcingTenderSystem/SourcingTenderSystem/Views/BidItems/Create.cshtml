@model BidItemFormViewModel
@{
    var bid = (Bid)ViewBag.Bid;
    var item = (PurchaseRequisitionItem)ViewBag.RequestedItem;
    ViewData["Title"] = L.T("Add price");
    ViewData["Bid"] = bid;
    ViewData["RequestedItem"] = item;
    // bidId and purchaseRequisitionItemId go in the URL; the controller checks them again on POST
    ViewData["FormAction"] = Url.Action("Create", "BidItems", new { bidId = bid.Id, purchaseRequisitionItemId = item.Id });
    ViewData["SubmitText"] = L.T("Save price");
}
<partial name="_BidItemForm" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/bid-item-form.js" asp-append-version="true"></script>
}
