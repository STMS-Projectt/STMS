@model DashboardCounts
@{
    ViewData["Title"] = L.T("Analytics & Statistics");
    var tenderCounts = (Dictionary<string, int>)ViewBag.TenderCounts;
    var trend = ((string Month, int Tenders, int Requests)[])ViewBag.TenderTrend;
    var months = (int)ViewBag.TrendMonths;
    var latest = trend[^1];
    var high = trend.Max(t => Math.Max(t.Tenders, t.Requests));
    var step = Math.Max(1, (int)Math.Ceiling(high / 4d));
    var trendMax = 4d * step;
    var total = Model.PendingSuppliers + Model.ApprovedSuppliers + Model.RejectedSuppliers + Model.SuspendedSuppliers;
    var pending = total == 0 ? 0 : 100d * Model.PendingSuppliers / total;
    var approved = pending + (total == 0 ? 0 : 100d * Model.ApprovedSuppliers / total);
    var rejected = approved + (total == 0 ? 0 : 100d * Model.RejectedSuppliers / total);
    var chart = FormattableString.Invariant($"--pending:{pending:F3}%;--approved:{approved:F3}%;--rejected:{rejected:F3}%");
    // Analytics dashboard data (see AdminDashboardController.LoadAnalyticsAsync)
    var kpis = (List<ReportKpi>)ViewBag.Kpis;
    var byDepartment = (List<DashboardBar>)ViewBag.RequestsByDepartment;
    var byStatus = (List<DashboardBar>)ViewBag.RequestsByStatus;
    var topSuppliers = (List<DashboardBar>)ViewBag.TopSuppliers;
    // The longest bar of each chart is full width; the other bars are a part of it.
    var departmentMax = 1;
    foreach (var row in byDepartment) { if (row.Count > departmentMax) departmentMax = row.Count; }
    var statusMax = 1;
    foreach (var row in byStatus) { if (row.Count > statusMax) statusMax = row.Count; }
    var supplierMax = 1;
    foreach (var row in topSuppliers) { if (row.Count > supplierMax) supplierMax = row.Count; }
}
<header class="page-heading stms-hero admin-overview">
    <div>
        <p class="eyebrow">@L.T("ADMIN WORKSPACE")</p>
        <h1>@L.T("Analytics & Statistics")</h1>
        <p>@L.T("Track procurement activity, review supplier applications, and manage access.")</p>
    </div>
</header>
<div class="admin-analytics">
<section aria-labelledby="snapshot-title">
    <div class="section-heading"><h2 id="snapshot-title">@L.T("Organization snapshot")</h2><span>@L.T("Current totals")</span></div>
    <div class="metrics-grid">
        @foreach (var item in new[] {
            ("Purchase requests", Model.Requests, "file", "blue", "AdminOperations", "Requests"),
            ("Tenders", Model.Tenders, "dashboard", "teal", "AdminOperations", "Tenders"),
            ("Suppliers", total, "supplier", "amber", "Suppliers", "Index"),
            ("Active employees", Model.ActiveEmployees, "users", "violet", "Employees", "Index") })
        {
            <a class="metric surface admin-metric-link" asp-controller="@item.Item5" asp-action="@item.Item6" aria-label="@L.F("View {0}", L.T(item.Item1))">
                <span class="icon-tile tone-@item.Item4"><partial name="_Icon" model="item.Item3" /></span>
                <strong data-count="@item.Item2">@item.Item2</strong><span>@L.T(item.Item1)</span>
                <span class="admin-metric-arrow" aria-hidden="true"><partial name="_Icon" model='@("arrow")' /></span>
            </a>
        }
    </div>
</section>
<section aria-labelledby="indicators-title">
    <div class="section-heading"><h2 id="indicators-title">@L.T("Key indicators")</h2><a class="text-link" asp-controller="Reports" asp-action="Index">@L.T("Open reports") <partial name="_Icon" model='@("arrow")' /></a></div>
    <div class="metrics-grid analytics-kpis">
        @foreach (var kpi in kpis)
        {
            <a class="metric surface admin-metric-link report-kpi" href="@kpi.Link" aria-label="@kpi.Label: @kpi.Value">
                <span class="icon-tile tone-@kpi.Tone"><partial name="_Icon" model="kpi.Icon" /></span>
                <strong>@kpi.Value</strong>
                <span>@kpi.Label</span>
                @if (kpi.Hint != null) { <small class="report-kpi-hint">@kpi.Hint</small> }
                <span class="admin-metric-arrow" aria-hidden="true"><partial name="_Icon" model='@("arrow")' /></span>
            </a>
        }
    </div>
</section>
<div class="admin-chart-grid">
    <section class="surface dashboard-card admin-trend" data-procurement-chart>
        <div class="card-heading"><div><h2>@L.T("Procurement activity")</h2><p>@L.F("New requests and tenders · last {0} months (UTC)", months)</p></div></div>
        <nav class="directory-status-options admin-chart-period" aria-label="@L.T("Activity period")">
            @foreach (var period in new[] { 3, 6, 12 })
            { <a asp-action="Index" asp-route-months="@period" aria-current="@(months == period ? "page" : null)">@L.F("{0} months", period)</a> }
        </nav>
        <div class="admin-chart-legend"><span>@L.T("Purchase requests")</span><span>@L.T("Tenders")</span></div>
        @if (high == 0) { <p class="admin-chart-empty">@L.T("No requests or tenders were created in this period.")</p> }
        else
        {
            <div class="admin-chart-viewport" data-wide-chart="@(months == 12 ? "true" : null)">
            <div class="admin-chart">
                <div class="admin-chart-axis" aria-hidden="true">
                    @for (var tick = 4; tick >= 0; tick--) { <span>@(tick * step)</span> }
                </div>
                <div class="admin-chart-plot" role="group" aria-label="@L.T("Monthly request and tender counts")" style="--month-count:@months">
                    @foreach (var point in trend)
                    {
                        var heights = FormattableString.Invariant($"--requests:{100 * point.Requests / trendMax:F3}%;--tenders:{100 * point.Tenders / trendMax:F3}%");
                        <button type="button" class="admin-chart-month" style="@heights" aria-pressed="@(point.Equals(latest) ? "true" : "false")"
                                data-month="@point.Month" data-requests="@point.Requests" data-tenders="@point.Tenders"
                                aria-label="@L.F("{0}: {1} requests, {2} tenders", point.Month, point.Requests, point.Tenders)">
                            <span class="admin-chart-bars" aria-hidden="true"><i></i><i></i></span>
                            <span class="admin-chart-label" aria-hidden="true">@point.Month</span>
                        </button>
                    }
                </div>
            </div>
            </div>
            <output class="admin-chart-selection" data-chart-selection>@L.F("{0} · {1} requests · {2} tenders", latest.Month, latest.Requests, latest.Tenders)</output>
        }
    </section>
    <section class="surface dashboard-card">
        <div class="card-heading"><div><h2>@L.T("Supplier status")</h2><p>@L.T("Application breakdown")</p></div><a class="text-link" asp-controller="Suppliers" asp-action="Index">@L.T("View suppliers") <partial name="_Icon" model='@("arrow")' /></a></div>
        <div class="status-overview">
            <div class="donut @(total == 0 ? "donut-empty" : "")" style="@chart"><div><strong>@total</strong><span>@L.T("Total")</span></div></div>
            <div class="status-legend">
                @foreach (var item in new[] { ("Pending", Model.PendingSuppliers, "waiting"), ("Approved", Model.ApprovedSuppliers, "positive"), ("Rejected", Model.RejectedSuppliers, "negative"), ("Suspended", Model.SuspendedSuppliers, "neutral") })
                {
                    <a asp-controller="Suppliers" asp-action="Index" asp-route-status="@item.Item1"><span class="legend-dot dot-@item.Item3"></span><span>@L.T(item.Item1)</span><strong>@item.Item2</strong></a>
                }
            </div>
        </div>
    </section>
</div>
<div class="analytics-breakdowns">
    <section class="surface dashboard-card">
        <div class="card-heading"><div><h2>@L.T("Requests by department")</h2><p>@L.T("Select a department to open its report")</p></div></div>
        @if (byDepartment.Count == 0) { <p class="subtle mb-0">@L.T("No purchase requests yet.")</p> }
        @foreach (var row in byDepartment)
        {
            <div class="stms-stat-row" title="@L.F("{0}: {1} requests", row.Name, row.Count)">
                <a asp-controller="Reports" asp-action="Index" asp-route-tab="requests" asp-route-departmentId="@row.Id">@row.Name</a>
                <meter min="0" max="@departmentMax" value="@row.Count" aria-label="@row.Name"></meter><strong>@row.Count</strong>
            </div>
        }
    </section>
    <section class="surface dashboard-card">
        <div class="card-heading"><div><h2>@L.T("Requests by status")</h2><p>@L.T("Select a status to list its requests")</p></div></div>
        @if (byStatus.Count == 0) { <p class="subtle mb-0">@L.T("No purchase requests yet.")</p> }
        @foreach (var row in byStatus)
        {
            <div class="stms-stat-row" title="@L.F("{0}: {1} requests", L.T(row.Name), row.Count)">
                <a asp-controller="AdminOperations" asp-action="Requests" asp-route-status="@row.Name">@L.T(row.Name)</a>
                <meter min="0" max="@statusMax" value="@row.Count" aria-label="@L.T(row.Name)"></meter><strong>@row.Count</strong>
            </div>
        }
    </section>
    <section class="surface dashboard-card">
        <div class="card-heading"><div><h2>@L.T("Top suppliers by awards")</h2><p>@L.T("Select a supplier to open its performance")</p></div></div>
        @if (topSuppliers.Count == 0) { <p class="subtle mb-0">@L.T("No tender has been awarded yet.")</p> }
        @foreach (var row in topSuppliers)
        {
            <div class="stms-stat-row" title="@L.F("{0}: {1} awards", row.Name, row.Count)">
                <a asp-controller="Reports" asp-action="Index" asp-route-tab="suppliers" asp-route-supplierId="@row.Id" asp-fragment="performance">@row.Name</a>
                <meter min="0" max="@supplierMax" value="@row.Count" aria-label="@row.Name"></meter><strong>@row.Count</strong>
            </div>
        }
    </section>
</div>
<div class="dashboard-grid admin-secondary">
    <section class="surface dashboard-card">
        <div class="card-heading"><div><h2>@L.T("Quick actions")</h2><p>@L.T("Common administration tasks")</p></div></div>
        <div class="quick-actions">
            <a data-workspace-dialog asp-controller="Departments" asp-action="Create"><span class="icon-tile tone-blue"><partial name="_Icon" model='@("building")' /></span><span><strong>@L.T("Add department")</strong><small>@L.T("Organize employees by team")</small></span><partial name="_Icon" model='@("arrow")' /></a>
            <a data-workspace-dialog asp-controller="Employees" asp-action="Create"><span class="icon-tile tone-violet"><partial name="_Icon" model='@("users")' /></span><span><strong>@L.T("Add employee")</strong><small>@L.T("Create an account and assign access")</small></span><partial name="_Icon" model='@("arrow")' /></a>
            <a asp-controller="Suppliers" asp-action="Index"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("supplier")' /></span><span><strong>@L.T("Manage suppliers")</strong><small>@L.T("Review applications and documents")</small></span><partial name="_Icon" model='@("arrow")' /></a>
        </div>
    </section>
<section class="surface dashboard-card">
    <div class="card-heading"><div><h2>@L.T("Tenders by status")</h2><p>@L.T("Share of all recorded tenders")</p></div><a class="text-link" asp-controller="AdminOperations" asp-action="Tenders">@L.T("View tenders")</a></div>
    @if (Model.Tenders == 0) { <p class="subtle mb-0">@L.T("Tender statistics will appear once a tender is created.")</p> }
    @foreach (var row in tenderCounts)
    {
        <div class="stms-stat-row"><a asp-controller="AdminOperations" asp-action="Tenders" asp-route-status="@row.Key">@L.T(row.Key)</a><meter min="0" max="@Model.Tenders" value="@row.Value" aria-label="@L.T(row.Key)"></meter><strong>@row.Value</strong></div>
    }
</section>
</div>
<section aria-labelledby="admin-totals">
    <div class="section-heading"><h2 id="admin-totals">@L.T("Workspace at a glance")</h2><span>@L.T("Current totals")</span></div>
    <div class="admin-total-grid">
        <a class="surface admin-total-card" asp-controller="Departments" asp-action="Index">
            <span class="icon-tile tone-blue"><partial name="_Icon" model='@("building")' /></span>
            <span><strong data-count="@Model.Departments">@Model.Departments.ToString("N0")</strong><small>@L.T("Departments")</small></span>
            <partial name="_Icon" model='@("arrow")' />
        </a>
        <div class="surface admin-total-card"><span class="icon-tile tone-violet"><partial name="_Icon" model='@("users")' /></span><span><strong data-count="@Model.Users">@Model.Users.ToString("N0")</strong><small>@L.T("All user accounts")</small></span></div>
    </div>
</section>
</div>
@section Scripts {
    <script src="~/js/admin-dashboard.js" asp-append-version="true" defer></script>
}
