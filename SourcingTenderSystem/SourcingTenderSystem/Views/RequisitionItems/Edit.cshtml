@model RequisitionItemInput
@{ ViewData["Title"] = L.T("Edit item"); }
<a class="back-link" asp-controller="PurchaseRequisitions" asp-action="Details" asp-route-id="@ViewBag.RequestId"><partial name="_Icon" model='@("back")' /> @L.T("Request details")</a>
<header class="page-heading stms-hero"><div><p class="eyebrow">@L.T("PURCHASE REQUESTS")</p><h1>@L.T("Edit item")</h1><p>@L.T("Update the quantity, unit, or specifications for this line.")</p></div></header>
<div class="form-shell">
    <form class="surface form-card" asp-action="Edit" asp-route-id="@ViewBag.ItemId" method="post">
        <partial name="_Fields" model="Model" />
        <div class="button-row"><button class="btn btn-primary" type="submit">@L.T("Save changes")</button><a class="btn btn-outline-secondary" asp-controller="PurchaseRequisitions" asp-action="Details" asp-route-id="@ViewBag.RequestId">@L.T("Cancel")</a></div>
    </form>
    <aside class="surface helper-card"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("file")' /></span><h2>@L.T("Specifications")</h2><p class="mb-0">@L.T("Include the features, dimensions, or service requirements the reviewer needs to understand the item.")</p></aside>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
