@model PurchaseRequisitionItem
@{ ViewData["Title"] = "Delete request item"; }
<h1>Delete item</h1>
<p>Delete <strong>@Model.ItemName</strong> (@Model.Quantity @Model.Unit) from this request?</p>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete item</button>
    <a class="btn btn-outline-secondary" asp-controller="PurchaseRequisitions" asp-action="Details" asp-route-id="@Model.PurchaseRequisitionId">Cancel</a>
</form>
