@model WinnerBrief
@{
    Layout = null;
    ViewData["WinnerPrint"] = true;
}
<!doctype html>
<html lang="@L.Language" dir="@L.Direction">
<head>
    <partial name="_BrandHead" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@L.T("Winning supplier brief")</title>
    <style>
        :root { color-scheme:light; background:white; color:#132e43; font-family:system-ui,sans-serif }
        body { margin:2rem auto; max-width:48rem; padding-inline:1rem; line-height:1.6; overflow-wrap:anywhere }
        header { border-block-end:2px solid #08766c; }
        h1,h2,h3 { line-height:1.25 }
        .ai-pick { background:#eef8f6; border-inline-start:4px solid #08766c; padding:.75rem 1rem; break-inside:avoid }
        .ai-reasons { padding-inline-start:1.5rem }
        .wb-hero { background:#eef8f6; border-inline-start:4px solid #08766c; padding:.75rem 1rem; border-radius:8px; break-inside:avoid }
        .wb-hero-top { display:flex; align-items:center; gap:1rem } .wb-hero-title { flex:1 } .wb-trophy { display:none }
        .wb-kicker { margin:0; font-size:.75rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:#08766c } .wb-hero h3 { margin:0 }
        .wb-score strong { font-size:1.4rem } .wb-score span { display:grid; text-align:center }
        .wb-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:.5rem; margin:1rem 0 } .wb-stat { border:1px solid #d5e2e0; border-radius:6px; padding:.4rem .6rem }
        .wb-stat dt { font-size:.75rem; color:#56657a } .wb-stat dd { margin:0; font-weight:700 } .wb-stat .icon, .wb-section-icon { display:none }
        .wb-section { break-inside:avoid; margin-top:1rem } .wb-section-title { margin:0 0 .3rem } .wb-list { padding-inline-start:1.5rem }
        .wb-footer { margin-top:1rem; font-size:.8rem; color:#56657a } .wb-ai-chip { font-weight:700 }
        a,button { font:inherit }
        @@media print { body { margin:0; padding:0 } .print-action { display:none } h2,h3 { break-after:avoid } }
    </style>
</head>
<body>
    <header>
        <h1>@L.T("Winning supplier brief")</h1>
        <p>@L.F("Tender #{0}", Model.Input.TenderId) · <bdi>@Model.Input.TenderTitle</bdi></p>
        <p>@L.T("Advisory only.") · @L.F("Prepared for {0}", User.Identity?.Name ?? "")</p>
        <button class="print-action" type="button" onclick="window.print()">@L.T("Print summary")</button>
    </header>
    <main><partial name="_WinnerBrief" model="Model" /></main>
</body>
</html>

