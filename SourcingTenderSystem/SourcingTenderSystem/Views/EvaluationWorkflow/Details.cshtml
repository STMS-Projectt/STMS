@inject ProtectedPdf PdfSecurity
@model EvaluationWorkflowDetails
@{
    ViewData["Title"] = "Evaluation progress";
    var tender = Model.Tender;
    var report = tender.EvaluationReport;
}
<a class="back-link" asp-action="Index"><partial name="_Icon" model='@("back")' /> Evaluations</a>
<header class="page-heading"><div><p class="eyebrow">TENDER #@tender.Id</p><h1>@tender.Title</h1><p>@(report?.Status ?? tender.Status)</p></div></header>
<partial name="_RecordQr" model='@(Url.Action("Details", new { id = tender.Id })!)' />
@if (TempData["WorkflowError"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }
<section class="surface directory mb-3">
    <div class="directory-toolbar"><h2 class="mb-0">Committee progress · @Model.Progress.Count(p => p.Complete) / 4 submitted</h2></div>
    <div class="table-responsive" role="region" aria-label="Committee progress" tabindex="0"><table class="directory-table">
        <thead><tr><th scope="col">Reviewer</th><th scope="col">Seat</th><th scope="col">Scores saved</th><th scope="col">Status</th></tr></thead>
        <tbody>@foreach (var member in Model.Progress)
        { <tr><td>@member.Employee</td><td>@member.Seat</td><td>@member.Scored / @member.Required</td><td><span class="status-pill @(member.Complete ? "status-positive" : "status-waiting")">@(member.Complete ? "Submitted" : member.Scored > 0 ? "In progress" : "Pending")</span> @if (member.SubmittedAt is DateTime submitted) { <small>@submitted.ToString("yyyy-MM-dd HH:mm") UTC</small> }</td></tr> }
        </tbody>
    </table></div>
</section>
<section class="surface detail-card mb-3">
    <h2>Saved evaluations</h2>
    @if (Model.Scores.Count == 0) { <p class="subtle mb-0">No scores saved yet.</p> }
    else
    {
        <details><summary>View scores and reviewer notes</summary>
            <div class="table-responsive" role="region" aria-label="Saved evaluations" tabindex="0"><table class="directory-table mt-2">
                <thead><tr><th scope="col">Reviewer</th><th scope="col">Supplier</th><th scope="col">Criterion</th><th scope="col">Score</th><th scope="col">Notes</th></tr></thead>
                <tbody>@foreach (var score in Model.Scores)
                {
                    var member = tender.CommitteeMembers.FirstOrDefault(m => m.EmployeeProfileId == score.EmployeeId);
                    var bid = tender.Bids.First(b => b.Id == score.BidId);
                    var criterion = tender.EvaluationCriteria.First(c => c.Id == score.CriterionId);
                    <tr><td>@member?.EmployeeProfile.FullName</td><td>@bid.SupplierProfile.CompanyName</td><td>@criterion.Name</td><td>@score.Score / @criterion.MaxScore</td><td>@score.Notes</td></tr>
                }</tbody>
            </table></div>
        </details>
    }
</section>
@if (ViewBag.Comparison is List<SupplierEvaluationResult> comparison)
{
    <section class="surface detail-card mb-3">
        <h2>Weighted supplier comparison</h2>
        <p>Each criterion is normalized and averaged across reviewers, then multiplied by its published weight.</p>
        <ul>@foreach (var c in tender.EvaluationCriteria) { <li>@c.Name · @c.Type · @c.WeightPercent%</li> }</ul>
        <div class="table-responsive"><table class="table"><thead><tr><th>Supplier</th><th>Compliance</th><th>Price</th><th>Technical</th><th>Financial</th><th>Total / 100</th><th>Evidence</th></tr></thead>
        <tbody>@foreach (var row in comparison)
        {
            <tr><td>@row.Supplier</td><td>@row.Compliance @if (!string.IsNullOrWhiteSpace(row.ComplianceNotes)) { <small>@row.ComplianceNotes</small> }</td><td>@row.Price @row.Currency</td>
                <td>@row.Technical</td><td>@row.Financial</td><td>@row.Total</td><td>@if (row.Compliance == "Compliant" || User.IsInRole("SourcingOfficer"))
                {
                    @foreach (var documentId in row.EvidenceIds)
                    { <a class="me-2" asp-controller="BidDocuments" asp-action="Download" asp-route-id="@documentId">Document #@documentId</a> }
                }
                else { <span>@row.EvidenceIds.Count documents</span> }</td></tr>
        }</tbody></table></div>
    </section>
}
@if (Model.CanUpload)
{
    <section class="surface form-card mb-3">
        <h2>Upload final evaluation report</h2>
        <p class="subtle">All four reviewers have finished. Uploading the PDF closes scoring and sends the report to the sourcing officer.</p>
        <form asp-action="Upload" asp-route-id="@tender.Id" method="post" enctype="multipart/form-data">
            <label class="field mb-3 d-block">Recommended bid<select class="form-select" name="RecommendedBidId" required><option value="">Select supplier</option>
            @foreach (var bid in tender.Bids) { <option value="@bid.Id">@bid.SupplierProfile.CompanyName · @bid.TotalPrice.ToString("N2") @bid.Currency</option> }
            </select></label>
            <label class="field mb-3 d-block">Summary<textarea class="form-control" name="Summary" maxlength="1000" required></textarea></label>
            <label class="field mb-3 d-block">Final report PDF<input class="form-control" type="file" name="File" accept="application/pdf,.pdf" required /></label>
            <button class="btn btn-primary" type="submit">Upload and close evaluation</button>
        </form>
    </section>
}
else if (report == null && User.IsInRole("SourcingManager"))
{
    <p class="subtle">The final report can be uploaded once all four members submit scores for every criterion on every compliant bid.</p>
}
@if (report != null)
{
    <section class="surface detail-card mb-3">
        <h2>Final report</h2>
        <p>Recommended supplier: <strong>@(tender.Bids.FirstOrDefault(b => b.Id == report.RecommendedBidId)?.SupplierProfile.CompanyName ?? "—")</strong></p>
        <p style="white-space:pre-wrap">@report.Summary</p>
        @if (report.FinalizedAt is DateTime finalized)
        {
            <p><strong>@tender.Status</strong> · @finalized.ToString("yyyy-MM-dd HH:mm:ss") UTC</p>
        }
        @if (report.ResultsSnapshot is null)
        {
            <p class="alert alert-warning">Legacy report: no verified evaluation snapshot is available.</p>
        }
        @if (report.FileKey != null)
        {
            <div class="button-row mb-3">
                <a class="btn btn-outline-secondary" asp-action="Download" asp-route-id="@tender.Id" asp-route-preview="true" target="_blank" rel="noopener">Preview PDF</a>
                <a class="btn btn-outline-secondary" asp-action="Download" asp-route-id="@tender.Id">Download PDF</a>
            </div>
            @if (PdfSecurity.SigningEnabled && (User.IsInRole("SourcingManager") || User.IsInRole("SourcingOfficer")))
            {
                <details class="border rounded p-3 mb-3"><summary>Download a digitally signed copy</summary>
                    <form asp-action="SignDocument" asp-route-id="@tender.Id" method="post" class="mt-3">
                        <p class="subtle">Your password confirms the request. The organization certificate signs this watermarked copy.</p>
                        <label class="form-label">Current password<input name="password" type="password" required autocomplete="current-password" class="form-control" /></label>
                        <button class="btn btn-primary" type="submit">Sign and download</button>
                    </form>
                </details>
            }
        }
        @if (Model.NextStage != null)
        {
            <form asp-action="Approve" asp-route-id="@tender.Id" method="post">
                <input type="hidden" name="expectedStage" value="@report.Status" />
                <label class="field mb-3 d-block">Approval notes<textarea class="form-control" name="comments" maxlength="1000" rows="2"></textarea></label>
                <label class="field mb-2 d-block">Current password<input class="form-control" type="password" name="password" autocomplete="current-password" required /></label>
                <label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="confirmDecision" value="true" required /> I confirm this official decision.</label>
                @if (report.Status == "Pending Top Committee")
                {
                    <p class="subtle">Unanimous approval required: @report.TenderApprovals.Count(a => a.Decision == "Top Committee Approved") / 4</p>
                    <div class="button-row"><button class="btn btn-primary" type="submit" name="vote" value="approve">Approve award</button><a class="btn btn-outline-danger" data-workspace-dialog asp-action="Reject" asp-route-id="@tender.Id">Reject and cancel</a></div>
                }
                else
                {
                <button class="btn btn-primary" type="submit">@(Model.NextStage == "Pending Manager Approval" ? "Approve and send to sourcing manager" : Model.NextStage == "Pending Top Committee" ? "Approve and send to top committee" : "Approve final report")</button>
                }
            </form>
        }
        @if (report.TenderApprovals.Count > 0)
        {
            <h3 class="mt-3">Approval history</h3><ul class="mb-0">
            @foreach (var entry in report.TenderApprovals.OrderBy(a => a.DecidedAt))
            { <li>@entry.ApproverEmployeeProfile.FullName · @entry.Decision · @entry.DecidedAt.ToString("dd MMM yyyy HH:mm") UTC @if (PdfSecurity.SigningEnabled) { <a class="ms-2" asp-action="DecisionPdf" asp-route-id="@entry.Id">Signed decision PDF</a> } @if (!string.IsNullOrWhiteSpace(entry.Comments)) { <p>@entry.Comments</p> }</li> }
            </ul>
        }
    </section>
}

<div class="mb-3"><a class="btn btn-outline-secondary" asp-controller="Clarifications" asp-action="Index" asp-route-kind="tender" asp-route-recordId="@tender.Id">Clarification history</a></div>

@if (report?.Status == TenderRules.AwaitingReturn && User.IsInRole("SourcingManager"))
{
    <section class="surface detail-card mt-3"><h2>Return the cancelled tender</h2><p>The sourcing officer can prepare a new tender for the same request after you return this one.</p>
        <form asp-action="ReturnToOfficer" asp-route-id="@tender.Id" method="post"><button class="btn btn-primary" type="submit">Return to sourcing officer</button></form>
    </section>
}
@if (ViewData["CanRetender"] is true && User.IsInRole("SourcingOfficer"))
{
    <a data-workspace-dialog class="btn btn-primary mt-3" asp-controller="Tenders" asp-action="Create" asp-route-purchaseRequisitionId="@tender.PurchaseRequisitionId">Create replacement tender</a>
}
