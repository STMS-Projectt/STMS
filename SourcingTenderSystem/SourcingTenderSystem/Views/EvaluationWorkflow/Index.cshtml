@model IReadOnlyList<Tender>
@{
    var top = User.IsInRole("TopCommittee");
    ViewData["Title"] = top ? "Award decisions" : "Evaluation progress";
}
<header class="page-heading stms-hero"><div><p class="eyebrow">EVALUATION WORKFLOW</p><h1>@ViewData["Title"]</h1><p>@(top ? "Review final reports, record your vote and track completed decisions." : "Track committee reviews and approval of final reports.")</p></div></header>
@if (top)
{
    <section class="metrics-grid stms-metrics" aria-label="Award decision statistics">
        <article class="surface metric"><span class="icon-tile tone-blue"><partial name="_Icon" model='@("file")' /></span><strong>@Model.Count</strong><span>Evaluation reports</span></article>
        <article class="surface metric"><span class="icon-tile tone-amber"><partial name="_Icon" model='@("clock")' /></span><strong>@Model.Count(t => t.EvaluationReport?.Status == "Pending Top Committee")</strong><span>Awaiting committee decision</span></article>
        <article class="surface metric"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("check")' /></span><strong>@Model.Count(t => t.Status == "Awarded")</strong><span>Awarded</span></article>
        <article class="surface metric"><span class="icon-tile tone-violet"><partial name="_Icon" model='@("shield")' /></span><strong>@Model.Count(t => t.Status == "Cancelled")</strong><span>Cancelled</span></article>
    </section>
}
<section class="surface directory dept-directory" data-directory>
    @if (Model.Count == 0)
    { <div class="empty-state"><h2>No evaluations to review</h2><p>Tenders appear here when they reach your workflow.</p></div> }
    else
    {
        <div class="dept-directory-heading"><h2>Evaluation register</h2><p>Find a tender by name or stage.</p></div>
        <partial name="_ListFilters" model='@("Search evaluations", Model.Select(t => t.EvaluationReport?.Status ?? t.Status))' />
        <partial name="_DirectoryPages" model='@("Evaluation pages")' />
        <div class="record-list" data-record-list>
        @foreach (var tender in Model)
        {
            <article class="record-card" data-record data-status="@(tender.EvaluationReport?.Status ?? tender.Status)">
                <div class="record-name"><span class="avatar"><partial name="_Icon" model='@("check")' /></span><span>@tender.Title<small>#@tender.Id</small></span></div>
                <dl class="record-facts"><div><dt class="visually-hidden">Stage</dt><dd><partial name="_Status" model="@(tender.EvaluationReport?.Status ?? tender.Status)" /></dd></div></dl>
                <div class="record-action">
                    @foreach (var (panel, label, icon) in new[] { ("progress", "Reviewer progress", "eye"), ("comparison", "Weighted comparison", "chart"), ("decision", "Report and decision", "file") })
                    {
                        <a data-workspace-dialog="details" class="record-icon-action" asp-action="Details" asp-route-id="@tender.Id" asp-route-panel="@panel" aria-label="@label: @tender.Title" data-tooltip="@label"><partial name="_Icon" model="icon" /></a>
                    }
                    @if (User.IsInRole("SourcingOfficer"))
                    {
                        <a data-workspace-dialog="details" class="record-icon-action" asp-controller="Tenders" asp-action="Details" asp-route-id="@tender.Id" aria-label="View related tender" data-tooltip="View tender"><partial name="_Icon" model='@("briefcase")' /></a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a data-workspace-dialog="details" class="record-icon-action" asp-controller="AdminOperations" asp-action="Tender" asp-route-id="@tender.Id" aria-label="View related tender" data-tooltip="View related tender" title="View related tender"><partial name="_Icon" model='@("briefcase")' /></a>
                        <a data-workspace-dialog="details" class="record-icon-action" asp-controller="AdminOperations" asp-action="TenderQr" asp-route-id="@tender.Id" aria-label="Show tender QR code" data-tooltip="Show tender QR code" title="Show tender QR code"><partial name="_Icon" model='@("qr")' /></a>
                    }
                </div>
            </article>
        }
        </div>
        <partial name="_ListFilterEmpty" />
    }
</section>
