@model Tender
@{ ViewData["Title"] = "Reject recommendation"; }
<header class="page-heading admin-action-heading"><span class="icon-tile tone-amber"><partial name="_Icon" model='@("shield")' /></span><div><p class="eyebrow">@L.F("Official decision · Tender #{0}", Model.Id)</p><h1>@L.T("Reject and cancel tender")</h1><p>@Model.Title</p></div></header>
<form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="admin-form">
    <input type="hidden" name="expectedStage" value="Pending Top Committee" />
    <input type="hidden" name="vote" value="reject" />
    <label class="field d-block mb-3">@L.T("Rejection reason")<textarea class="form-control" name="comments" required maxlength="1000" rows="3"></textarea></label>
    <label class="field d-block">@L.T("Current password")<input class="form-control" name="password" type="password" autocomplete="current-password" required /></label>
    <label class="form-check mt-3"><input class="form-check-input" name="confirmDecision" type="checkbox" value="true" required /> @L.T("I confirm cancellation.")</label>
    <div class="form-actions"><a class="btn btn-outline-secondary" data-dialog-cancel asp-action="Details" asp-route-id="@Model.Id">@L.T("Cancel")</a><button type="submit" class="btn btn-danger">@L.T("Record rejection")</button></div>
</form>
