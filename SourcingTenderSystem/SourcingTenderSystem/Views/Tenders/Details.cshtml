@using SourcingTenderSystem.Services
@model SourcingTenderSystem.Models.Tender

@{
    ViewData["Title"] = "Tender Details";
    int count = ViewBag.OfferCount;
    var rounds = (List<TenderRound>)ViewBag.Rounds;
    var submitted = (List<string>)ViewBag.SubmittedSuppliers;
    var invitable = (List<string>)ViewBag.InvitableSuppliers;
    var isDraft = Model.Status == "Draft";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.Title</h1>
    <span class="badge bg-secondary fs-6">@Model.Status</span>
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Purchase Request</dt>
            <dd class="col-sm-9">@Model.PurchaseRequisition.Title</dd>

            <dt class="col-sm-3">Department</dt>
            <dd class="col-sm-9">@Model.PurchaseRequisition.Department.Name</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Terms</dt>
            <dd class="col-sm-9" style="white-space: pre-line;">@Model.Terms</dd>

            <dt class="col-sm-3">Open Date</dt>
            <dd class="col-sm-9">@Model.OpenDate.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-3">Close Date</dt>
            <dd class="col-sm-9">@Model.CloseDate.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-3">Created By</dt>
            <dd class="col-sm-9">@Model.CreatedByEmployeeProfile.FullName</dd>

            <dt class="col-sm-3">Created At</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-3">Invitations</dt>
            <dd class="col-sm-9">@ViewBag.InvitationCount</dd>

            <dt class="col-sm-3">Bids</dt>
            <dd class="col-sm-9 mb-0">@ViewBag.BidCount</dd>
        </dl>
    </div>
</div>

<div class="d-flex flex-wrap gap-2">
    <a data-workspace-dialog asp-action="Criteria" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Evaluation criteria</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
    @if (isDraft)
    {
        <a data-workspace-dialog asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
    }
    @if (TenderRules.CanEvaluate(Model, count))
    {
        <a data-workspace-dialog asp-action="AssignCommittee" asp-route-id="@Model.Id" class="btn btn-primary">Evaluation committee</a>
    }
    @if (Model.Status == "Open" && Model.CloseDate <= DateTime.UtcNow)
    {
        <form asp-action="Close" asp-route-id="@Model.Id" method="post"><button class="btn btn-primary" type="submit">Close tender</button></form>
    }
    <a asp-controller="Invitations" asp-action="Index" asp-route-tenderId="@Model.Id"
       class="btn btn-outline-success">Invitation</a>
</div>

<div class="mb-3"><a class="btn btn-outline-secondary" asp-controller="Clarifications" asp-action="Index" asp-route-kind="tender" asp-route-recordId="@Model.Id">Clarification history</a></div>

<partial name="_RecordQr" model='@(Url.Action("Details", new { id = Model.Id })!)' />

@if (Model.Status == "Draft")
{
    <form asp-action="Publish" asp-route-id="@Model.Id" method="post" class="mt-3"><button class="btn btn-primary" type="submit">Submit tender</button></form>
}
<section class="surface detail-card mt-3">
    <h2>Round @Model.Counter of @TenderRules.MaxRounds</h2>
    <p>@count distinct eligible suppliers · @TenderRules.Minimum(Model) required · @(TenderRules.MaxRounds - Model.Counter) rounds remaining</p>
    @if (Model.Counter == TenderRules.MaxRounds)
    {
        <p>Final round: one eligible bid is sufficient after closing, subject to compliance review. Zero bids always blocks evaluation.</p>
    }
    @if (TenderRules.CanReopen(Model, count))
    {
        <a data-workspace-dialog asp-action="Reopen" asp-route-id="@Model.Id" class="btn btn-primary">Open round @(Model.Counter + 1)</a>
    }
    else
    {
        <p class="subtle">@(Model.Status != "Closed" ? "Reopening is available only after a round closes." : Model.Counter == TenderRules.MaxRounds ? "All three rounds have been used." : "The tender already has three eligible suppliers.")</p>
    }
    @if (Model.Status == "Closed")
    {
        <p>@(TenderRules.CanEvaluate(Model, count) ? "Bid minimum met. Complete compliance review before assignment." : "Evaluation is blocked because the bid minimum has not been met.")</p>
        <a asp-controller="Compliance" asp-action="Review" asp-route-tenderId="@Model.Id">Compliance review</a>
    }
    @if (Model.Status is "Draft" or "Open" or "Published")
    {
        <a data-workspace-dialog asp-controller="Invitations" asp-action="Create" asp-route-tenderId="@Model.Id" class="btn btn-outline-primary">Invite suppliers</a>
        <p class="mt-2">Available to invite: @(invitable.Count == 0 ? "None" : string.Join(", ", invitable))</p>
    }
    <p>Previously submitted: @(submitted.Count == 0 ? "None" : string.Join(", ", submitted))</p>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Round</th><th>Opens (UTC)</th><th>Deadline (UTC)</th><th>Outcome</th><th>Reason</th></tr></thead>
            <tbody>
            @foreach (var round in rounds)
            {
                <tr><td>@round.Number</td><td>@(round.OpensAt?.ToString("yyyy-MM-dd HH:mm") ?? "Unknown")</td>
                    <td>@(round.ClosesAt?.ToString("yyyy-MM-dd HH:mm") ?? "Unknown")</td>
                    <td>@(round.ClosingOutcome ?? "Not closed") @if (round.EligibleSuppliersAtClose is int n) { <small>(@n eligible)</small> }</td>
                    <td>@round.ReopenReason</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>
