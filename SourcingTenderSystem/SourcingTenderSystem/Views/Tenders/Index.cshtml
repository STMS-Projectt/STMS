@model IEnumerable<SourcingTenderSystem.Models.Tender>

@{
    ViewData["Title"] = L.T("Tender Management");
    var tenders = Model.ToList();
    var now = DateTime.UtcNow;
    var upcoming = tenders.Where(t => (t.Status is "Open" or "Published") && t.CloseDate > now).OrderBy(t => t.CloseDate).Take(4).ToList();
    var metrics = new[] { ("All tenders", tenders.Count, "file", "blue"), ("Open for bidding", tenders.Count(t => t.Status == "Open"), "clock", "teal"), ("In review", tenders.Count(t => t.Status is "Under Evaluation" or "Evaluation Closed" or "Awaiting Manager Review" or "Awaiting Committee Decision"), "users", "violet"), ("Awarded", tenders.Count(t => t.Status == "Awarded"), "check", "amber") };
}

@functions {
    static string BadgeClass(string status) => status switch
    {
        "Draft" => "bg-secondary",
        "Published" => "bg-info text-dark",
        "Open" => "bg-primary",
        "Closed" => "bg-dark",
        "Under Evaluation" => "bg-warning text-dark",
        "Awaiting Manager Review" => "bg-warning text-dark",
        "Awaiting Committee Decision" => "bg-warning text-dark",
        "Awarded" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}

<header class="page-heading stms-hero">
    <div><p class="eyebrow">@L.T("PROCUREMENT WORKSPACE")</p><h1>@L.T("Tender Management")</h1><p>@L.T("Track bidding, evaluation, and award decisions in one place.")</p></div>
    <a data-workspace-dialog asp-action="Create" class="btn btn-primary"><span aria-hidden="true">+</span> @L.T("New Tender")</a>
</header>
<partial name="_DesignMetrics" model="metrics" />

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L.T("Close")"></button>
    </div>
}
@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L.T("Close")"></button>
    </div>
}

<section class="surface directory dept-directory" data-directory>
    <div class="dept-directory-heading"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("briefcase")' /></span><div><h2>@L.T("All tenders")</h2><p>@L.T("Set evaluation criteria on drafts or close bidding on an open tender from its card.")</p></div></div>
    <partial name="_ListFilters" model='@("Search tenders", Model.Select(t => t.Status))' />
    <partial name="_DirectoryPages" model='@("Tender pages")' />
@if (!Model.Any()) { <div class="empty-state"><h2>@L.T("No tenders yet")</h2></div> }
else
{
    <div class="record-list" data-record-list>
    @foreach (var t in Model)
    {
        var early = TenderRules.IsOpen(t, now);
        var canClose = early || t.Status is ("Open" or "Published") && t.CloseDate <= now;
        <article class="record-card" data-record data-status="@t.Status">
            <div class="record-name"><span class="avatar"><partial name="_Icon" model='@("briefcase")' /></span><span>@t.Title<small>Tender #@t.Id · @t.CreatedByEmployeeProfile.FullName · @t.CreatedAt.ToString("dd MMM yyyy", L.DisplayCulture)</small></span></div>
            <dl class="record-facts"><div><dt>@L.T("Purchase request")</dt><dd>@t.PurchaseRequisition.Title</dd></div><div><dt>@L.T("Opens (UTC)")</dt><dd>@t.OpenDate.ToString("dd MMM yyyy HH:mm", L.DisplayCulture)</dd></div><div><dt>@L.T("Closes (UTC)")</dt><dd>@t.CloseDate.ToString("dd MMM yyyy HH:mm", L.DisplayCulture)</dd></div><div><dt>@L.T("Status")</dt><dd><span class="badge @BadgeClass(t.Status)">@L.T(t.Status)</span></dd></div></dl>
            <div class="record-action">
                <a class="record-icon-action" data-workspace-dialog="details" asp-action="Details" asp-route-id="@t.Id" asp-route-panel="overview" aria-label="View tender @t.Title" data-tooltip="@L.T("Tender summary")"><partial name="_Icon" model='@("eye")' /></a>
                <a class="record-icon-action" data-workspace-dialog="details" asp-action="Details" asp-route-id="@t.Id" asp-route-panel="rounds" aria-label="Bidding rounds for @t.Title" data-tooltip="@L.T("Bidding rounds")"><partial name="_Icon" model='@("clock")' /></a>
                <a class="record-icon-action" data-workspace-dialog="details" asp-action="Details" asp-route-id="@t.Id" asp-route-panel="qr" aria-label="QR code for @t.Title" data-tooltip="@L.T("Tender QR code")"><partial name="_Icon" model='@("qr")' /></a>
                @if (t.Status == "Draft")
                {
                    <a class="record-icon-action" data-workspace-dialog asp-action="Edit" asp-route-id="@t.Id" aria-label="Edit tender @t.Title" data-tooltip="@L.T("Edit")"><partial name="_Icon" model='@("edit")' /></a>
                    <form asp-action="Delete" asp-route-id="@t.Id" method="post" data-workspace-confirm="@L.T("Delete this tender? The purchase request will go back to Approved.")" onsubmit="return window.stmsWorkspaceReady || confirm(this.dataset.workspaceConfirm);">
                        <button type="submit" class="record-icon-action record-icon-danger" aria-label="Delete tender @t.Title" data-tooltip="@L.T("Delete")"><partial name="_Icon" model='@("close")' /></button>
                    </form>
                }
                <a class="record-icon-action" data-workspace-dialog asp-controller="Invitations" asp-action="Index" asp-route-tenderId="@t.Id" aria-label="Invitations for @t.Title" data-tooltip="@L.T("Invitations")"><partial name="_Icon" model='@("mail")' /></a>
                @if (t.Status == "Closed")
                {
                    <a class="record-icon-action" data-workspace-dialog asp-action="AssignCommittee" asp-route-id="@t.Id" aria-label="Assign committee for @t.Title" data-tooltip="@L.T("Assign committee")"><partial name="_Icon" model='@("users")' /></a>
                }
            </div>
            @if (t.Status == "Draft" || canClose)
            {
                <div class="tender-card-quick-actions">
                    @if (t.Status == "Draft")
                    {
                        <a class="btn btn-outline-secondary" data-workspace-dialog asp-action="Criteria" asp-route-id="@t.Id" aria-label="Evaluation criteria for @t.Title"><partial name="_Icon" model='@("filter")' /> @L.T("Evaluation criteria")</a>
                    }
                    @if (canClose)
                    {
                        <form asp-action="Close" asp-route-id="@t.Id" asp-route-fromList="true" method="post"
                              data-workspace-confirm="@(early ? $"Close bidding early for “{t.Title}”? This stops new submissions for the current round." : null)"
                              onsubmit="return !this.dataset.workspaceConfirm || window.stmsWorkspaceReady || confirm(this.dataset.workspaceConfirm);">
                            <input type="hidden" name="confirmClose" value="@(early ? "true" : "false")" />
                            <button class="btn btn-outline-danger" type="submit" aria-label="@(early ? "Close bidding early for" : "Close bidding for") @t.Title"><partial name="_Icon" model='@("pause")' /> @(early ? "Close bidding early" : "Close bidding")</button>
                        </form>
                    }
                </div>
            }
        </article>
    }
    </div>
}
<partial name="_ListFilterEmpty" />
</section>
<div class="stms-page-panels">
<section class="surface dashboard-card">
    <div class="card-heading"><div><h2>@L.T("Procurement pipeline")</h2><p>@L.T("Where current tenders stand")</p></div></div>
    @foreach (var group in tenders.GroupBy(t => t.Status).OrderByDescending(g => g.Count()).ThenBy(g => g.Key))
    {
        <div class="stms-stat-row"><span>@group.Key</span><meter min="0" max="@tenders.Count" value="@group.Count()" aria-label="@group.Key"></meter><strong>@group.Count()</strong></div>
    }
    @if (tenders.Count == 0) { <p class="subtle mb-0">@L.T("No tenders in the pipeline yet.")</p> }
</section>
<section class="surface dashboard-card">
    <div class="card-heading"><div><h2>@L.T("Upcoming deadlines")</h2><p>@L.T("Closing times in UTC")</p></div></div>
    @if (upcoming.Count == 0) { <p class="subtle mb-0">@L.T("No upcoming bidding deadlines.")</p> }
    else
    {
        <div class="record-list record-list-inset">
            @foreach (var tender in upcoming)
            {
                <article class="record-card">
                    <div class="record-name"><span class="avatar"><partial name="_Icon" model='@("calendar")' /></span><span>@tender.Title</span></div>
                    <dl class="record-facts"><div><dt>@L.T("Closes (UTC)")</dt><dd><time datetime="@tender.CloseDate.ToString("yyyy-MM-ddTHH:mm:ss")Z">@tender.CloseDate.ToString("dd MMM yyyy · HH:mm")</time></dd></div></dl>
                    <div class="record-action"><a data-workspace-dialog="details" class="record-icon-action" asp-action="Details" asp-route-id="@tender.Id" asp-route-panel="overview" aria-label="View tender @tender.Title" data-tooltip="@L.T("View tender")"><partial name="_Icon" model='@("eye")' /></a></div>
                </article>
            }
        </div>
    }
</section>
</div>
