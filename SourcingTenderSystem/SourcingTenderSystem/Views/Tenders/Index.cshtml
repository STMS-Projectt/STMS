@model IEnumerable<SourcingTenderSystem.Models.Tender>

@{
    ViewData["Title"] = "Tender Management";
    var tenders = Model.ToList();
    var now = DateTime.UtcNow;
    var upcoming = tenders.Where(t => (t.Status is "Open" or "Published") && t.CloseDate > now).OrderBy(t => t.CloseDate).Take(4).ToList();
    var metrics = new[] { ("All tenders", tenders.Count, "file", "blue"), ("Open for bidding", tenders.Count(t => t.Status == "Open"), "clock", "teal"), ("In review", tenders.Count(t => t.Status is "Under Evaluation" or "Evaluation Closed" or "Awaiting Manager Review" or "Awaiting Committee Decision"), "users", "violet"), ("Awarded", tenders.Count(t => t.Status == "Awarded"), "check", "amber") };
}

@functions {
    static string BadgeClass(string status) => status switch
    {
        "Draft" => "bg-secondary",
        "Published" => "bg-info text-dark",
        "Open" => "bg-primary",
        "Closed" => "bg-dark",
        "Under Evaluation" => "bg-warning text-dark",
        "Awaiting Manager Review" => "bg-warning text-dark",
        "Awaiting Committee Decision" => "bg-warning text-dark",
        "Awarded" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}

<header class="page-heading stms-hero">
    <div><p class="eyebrow">PROCUREMENT WORKSPACE</p><h1>Tender Management</h1><p>Track bidding, evaluation, and award decisions in one place.</p></div>
    <a data-workspace-dialog asp-action="Create" class="btn btn-primary">+ New Tender</a>
</header>
<partial name="_DesignMetrics" model="metrics" />

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<section class="surface directory dept-directory" data-directory><div class="directory-toolbar"><h2 class="h5 mb-0">All tenders</h2></div><partial name="_ListFilters" model='@("Search tenders", Model.Select(t => t.Status))' />
    <div class="table-responsive" tabindex="0" role="region" aria-label="All tenders">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Title</th>
                <th>Purchase Request</th>
                <th>Open Date</th>
                <th>Close Date</th>
                <th>Status</th>
                <th>Created By</th>
                <th>Created At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                var isDraft = t.Status == "Draft";
                var canAssign = t.Status == "Closed";
                <tr data-status="@t.Status">
                    <td>@t.Id</td>
                    <td>@t.Title</td>
                    <td>@t.PurchaseRequisition.Title</td>
                    <td class="text-nowrap">@t.OpenDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="text-nowrap">@t.CloseDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td><span class="badge @BadgeClass(t.Status)">@t.Status</span></td>
                    <td>@t.CreatedByEmployeeProfile.FullName</td>
                    <td class="text-nowrap">@t.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-info">Details</a>

                            @if (isDraft)
                            {
                                <a data-workspace-dialog asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline"
                                      data-workspace-confirm="Delete this tender? The purchase request will go back to Approved." onsubmit="return window.stmsWorkspaceReady || confirm(this.dataset.workspaceConfirm);">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled
                                        title="Only draft tenders can be edited">
                                    Edit
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled
                                        title="Only draft tenders can be deleted">
                                    Delete
                                </button>
                            }

                            <a asp-controller="Invitations" asp-action="Index" asp-route-tenderId="@t.Id"
                               class="btn btn-sm btn-outline-success">Invitation</a>

                            @if (canAssign)
                            {
                                <a data-workspace-dialog asp-action="AssignCommittee" asp-route-id="@t.Id"
                                   class="btn btn-sm btn-outline-dark">Assign</a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled
                                        title="Committee assignment is unavailable after bidding closes">
                                    Assign
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">No tenders yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<partial name="_ListFilterEmpty" />
</section>
<div class="stms-page-panels">
<section class="surface dashboard-card">
    <div class="card-heading"><div><h2>Procurement pipeline</h2><p>Where current tenders stand</p></div></div>
    @foreach (var group in tenders.GroupBy(t => t.Status).OrderByDescending(g => g.Count()).ThenBy(g => g.Key))
    {
        <div class="stms-stat-row"><span>@group.Key</span><meter min="0" max="@tenders.Count" value="@group.Count()" aria-label="@group.Key"></meter><strong>@group.Count()</strong></div>
    }
    @if (tenders.Count == 0) { <p class="subtle mb-0">No tenders in the pipeline yet.</p> }
</section>
<section class="surface dashboard-card">
    <div class="card-heading"><div><h2>Upcoming deadlines</h2><p>Closing times in UTC</p></div></div>
    @if (upcoming.Count == 0) { <p class="subtle mb-0">No upcoming bidding deadlines.</p> }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var tender in upcoming)
            {
                <li class="list-group-item d-flex gap-2 flex-wrap justify-content-between">
                    <a asp-action="Details" asp-route-id="@tender.Id">@tender.Title</a>
                    <time datetime="@tender.CloseDate.ToString("yyyy-MM-ddTHH:mm:ss")Z">@tender.CloseDate.ToString("dd MMM yyyy · HH:mm")</time>
                </li>
            }
        </ul>
    }
</section>
</div>
