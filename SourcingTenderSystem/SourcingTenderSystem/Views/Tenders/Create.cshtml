@model SourcingTenderSystem.Controllers.TenderFormViewModel

@{
    ViewData["Title"] = "New Tender";
}

<h1 class="h3 mb-3">New Tender</h1>
@if (TempData["Success"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

@if (!Model.PurchaseRequests.Any())
{
    <div class="alert alert-warning">
        There are no approved purchase requests waiting for a tender.
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Create" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="PurchaseRequisitionId" class="form-label"></label>
                <select asp-for="PurchaseRequisitionId" asp-items="Model.PurchaseRequests" class="form-select">
                    <option value="">-- Select an approved purchase request --</option>
                </select>
                <span asp-validation-for="PurchaseRequisitionId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Terms" class="form-label"></label>
                <textarea asp-for="Terms" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Terms" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="OpenDate" class="form-label"></label>
                    <input asp-for="OpenDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="OpenDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="CloseDate" class="form-label"></label>
                    <input asp-for="CloseDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="CloseDate" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@(!Model.PurchaseRequests.Any())">Create Tender</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
