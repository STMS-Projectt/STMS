@model SourcingTenderSystem.Controllers.AssignCommitteeViewModel
@{
    ViewData["Title"] = L.T("Assign Evaluation Committee");
    string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
    // Colour per committee role
    string Tone(string role) => role switch
    {
        "Sourcing Manager" => "manager", "Technical Representative" => "tech", "Financial Representative" => "fin", _ => "dept"
    };
    string Icon(string role) => role switch
    {
        "Sourcing Manager" => "briefcase", "Technical Representative" => "shield", "Financial Representative" => "chart", _ => "building"
    };
}
<div class="pr-create ac">
<header class="iv-intro">
    <span class="pr-badge"><partial name="_Icon" model='@("users")' /></span>
    <div><p class="eyebrow">@L.T("SOURCING WORKSPACE")</p><h1>@L.T("Assign Evaluation Committee")</h1><p>@L.T("Review the proposed members before confirming the committee.")</p></div>
</header>

<section class="bf-tender">
    <span class="tm-icon"><partial name="_Icon" model='@("briefcase")' /></span>
    <div><h2>@Model.TenderTitle</h2><p>@L.T("Requesting department:") <strong>@Model.DepartmentName</strong></p></div>
    @if (Model.AlreadyAssigned) { <span class="cw-badge is-ok">@L.T("Already assigned")</span> }
</section>

@if (Model.Problems.Any())
{
    <div class="cm-alert ac-problems"><span class="pr-badge"><partial name="_Icon" model='@("warning")' /></span>
        <ul class="mb-0">@foreach (var problem in Model.Problems) { <li>@L.SystemMessage(problem)</li> }</ul></div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning tm-alert" role="alert"><partial name="_Icon" model='@("warning")' /> @L.T(error)</div>
}

<section class="pr-card prd-card">
    <div class="prd-card-head">
        <div class="pr-section-head mb-0"><span class="pr-badge"><partial name="_Icon" model='@("users")' /></span><div><h2>@L.T("Committee members")</h2>
            <p>@L.T("The committee includes three evaluation employees and the employee who created the purchase request.")</p></div></div>
        <span class="pr-count">@Model.Members.Count</span>
    </div>
    <div class="ac-grid">
        @foreach (var member in Model.Members)
        {
            <article class="ac-member ac-@Tone(member.Role)">
                <span class="ac-avatar">@Initials(member.FullName)</span>
                <div class="ac-body">
                    <h3>@member.FullName</h3>
                    <p>@string.Join(" · ", new[] { member.JobTitle, member.Department }.Where(x => !string.IsNullOrWhiteSpace(x)))</p>
                    <div class="ac-tags">
                        <span class="ac-role"><partial name="_Icon" model="Icon(member.Role)" /> @L.T(member.Role)</span>
                        <span class="ac-kind">@L.T(member.IsFixed ? "Fixed" : "Requester")</span>
                    </div>
                </div>
            </article>
        }
    </div>
</section>

<form asp-action="AssignCommittee" asp-route-id="@Model.TenderId" method="post" class="ac-footer">
    @if (!Model.IsOpen)
    {
        <p><partial name="_Icon" model='@("clock")' /> @L.T("Assigning the committee starts evaluation after the minimum offer count and compliance checks are complete.")</p>
    }
    <div class="ac-actions">
        <a asp-action="Index" data-dialog-cancel class="btn btn-outline-secondary">@L.T("Cancel")</a>
        <button type="submit" class="btn btn-primary pr-submit" disabled="@Model.Problems.Any()"><partial name="_Icon" model='@("check")' /> @L.T(Model.IsOpen ? "Update committee" : "Assign committee and start evaluation")</button>
    </div>
</form>
</div>
