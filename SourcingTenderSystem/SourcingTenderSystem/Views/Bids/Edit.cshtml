@model BidFormViewModel
@{
    var bid = (Bid)ViewBag.Bid;
    ViewData["Title"] = L.T("Edit bid");
}
<div class="pr-create bf">
<header class="iv-intro">
    <span class="pr-badge"><partial name="_Icon" model='@("edit")' /></span>
    <div><p class="eyebrow">@L.T("SUPPLIER BID")</p><h1>@L.T("Edit bid")</h1><p>@L.T("Tender:") <strong>@bid.Tender.Title</strong></p></div>
</header>

<section class="bf-tender">
    <span class="tm-icon"><partial name="_Icon" model='@("briefcase")' /></span>
    <div><h2>@bid.Tender.Title</h2><p>@L.F("Supplier bid #{0}", bid.Id)</p></div>
    <span class="bf-close"><partial name="_Icon" model='@("clock")' /> @L.F("Closes {0} (UTC)", bid.Tender.CloseDate.ToString("dd MMM yyyy · HH:mm", L.DisplayCulture))</span>
</section>

@* The bid id goes in the URL (/Bids/Edit/5); the controller loads the bid again and checks the owner *@
<form asp-action="Edit" asp-route-id="@bid.Id" method="post" enctype="multipart/form-data" asp-antiforgery="true" class="pr-card bf-card">
    <div asp-validation-summary="ModelOnly" class="text-danger px-4 pt-3" role="alert"></div>
    <partial name="_BidFields" model="Model" />
    <div class="pr-actions">
        <a class="btn btn-outline-secondary" data-dialog-cancel asp-action="Details" asp-route-id="@bid.Id">@L.T("Cancel")</a>
        <button type="submit" class="btn btn-primary pr-submit"><partial name="_Icon" model='@("check")' /> @L.T("Save")</button>
    </div>
</form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show the chosen file name inside the upload box
        document.querySelectorAll('[data-bf-file]:not([data-bf-ready])').forEach(input => {
            input.dataset.bfReady = '1';
            input.addEventListener('change', () => {
                const box = input.closest('.bf-drop');
                if (input.files.length) { box.querySelector('[data-bf-name]').textContent = input.files[0].name; box.classList.add('has-file'); }
            });
        });
    </script>
}
