@model BidFormViewModel
@* Shared fields for Create and Edit. ViewBag.Currencies comes from the controller. *@
<div class="mb-3">
    <label asp-for="Currency" class="form-label"></label>
    <select asp-for="Currency" asp-items="ViewBag.Currencies" class="form-select"></select>
    <span asp-validation-for="Currency" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="DeliveryDays" class="form-label"></label>
    <input asp-for="DeliveryDays" class="form-control" />
    <span asp-validation-for="DeliveryDays" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="ValidityDays" class="form-label"></label>
    <input asp-for="ValidityDays" class="form-control" />
    <span asp-validation-for="ValidityDays" class="text-danger"></span>
</div>
