@model BidFormViewModel
@{
    var tender = (Tender)ViewBag.Tender;
    ViewData["Title"] = L.T("Create bid");
}
<header class="page-heading admin-action-heading"><span class="icon-tile tone-teal"><partial name="_Icon" model='@("file")' /></span><div><p class="eyebrow">@L.T("SUPPLIER BID")</p><h1>@L.T("Create bid")</h1></div></header>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">@tender.Title</h2>
        <p class="card-text">@tender.Description</p>
        <p class="card-text mb-0"><small class="text-muted">@L.F("Closes {0} (UTC)", tender.CloseDate.ToString("yyyy-MM-dd HH:mm", L.DisplayCulture))</small></p>
    </div>
</div>

@* tenderId goes in the URL (asp-route-tenderId); the controller checks it again on POST *@
<form asp-action="Create" asp-route-tenderId="@tender.Id" method="post" enctype="multipart/form-data" asp-antiforgery="true" class="admin-form">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <partial name="_BidFields" model="Model" />
    <button type="submit" class="btn btn-primary">@L.T("Create draft bid")</button>
    <a class="btn btn-outline-secondary" asp-action="MyBids">@L.T("Cancel")</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
