@model BidFormViewModel
@{
    var tender = (Tender)ViewBag.Tender;
    ViewData["Title"] = L.T("Create bid");
}
<div class="pr-create bf">
<header class="iv-intro">
    <span class="pr-badge"><partial name="_Icon" model='@("file")' /></span>
    <div><p class="eyebrow">@L.T("SUPPLIER BID")</p><h1>@L.T("Create bid")</h1><p>@L.T("Fill in your offer terms. You add item prices and documents after saving the draft.")</p></div>
</header>

<section class="bf-tender">
    <span class="tm-icon"><partial name="_Icon" model='@("briefcase")' /></span>
    <div>
        <h2>@tender.Title</h2>
        @if (!string.IsNullOrWhiteSpace(tender.Description)) { <p>@tender.Description</p> }
    </div>
    <span class="bf-close"><partial name="_Icon" model='@("clock")' /> @L.F("Closes {0} (UTC)", tender.CloseDate.ToString("dd MMM yyyy · HH:mm", L.DisplayCulture))</span>
</section>

@* tenderId goes in the URL (asp-route-tenderId); the controller checks it again on POST *@
<form asp-action="Create" asp-route-tenderId="@tender.Id" method="post" enctype="multipart/form-data" asp-antiforgery="true" class="pr-card bf-card">
    <div asp-validation-summary="ModelOnly" class="text-danger px-4 pt-3" role="alert"></div>
    <partial name="_BidFields" model="Model" />
    <div class="pr-actions">
        <a class="btn btn-outline-secondary" data-dialog-cancel asp-action="MyBids">@L.T("Cancel")</a>
        <button type="submit" class="btn btn-primary pr-submit"><partial name="_Icon" model='@("check")' /> @L.T("Create draft bid")</button>
    </div>
</form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show the chosen file name inside the upload box
        document.querySelectorAll('[data-bf-file]:not([data-bf-ready])').forEach(input => {
            input.dataset.bfReady = '1';
            input.addEventListener('change', () => {
                const box = input.closest('.bf-drop');
                if (input.files.length) { box.querySelector('[data-bf-name]').textContent = input.files[0].name; box.classList.add('has-file'); }
            });
        });
    </script>
}
