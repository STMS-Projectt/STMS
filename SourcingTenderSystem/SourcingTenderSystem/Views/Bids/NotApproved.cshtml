@{
    ViewData["Title"] = "Bids not available";
}
<h1>@L.T("My bids")</h1>
<div class="alert alert-warning" role="alert">
    @L.F("Your supplier account is not approved (current status: {0}).", L.T((string)ViewBag.SupplierStatus))
    @L.T("You can't create, edit or submit bids until your account is approved.")
</div>
<a class="btn btn-outline-secondary" asp-controller="SupplierRegistration" asp-action="RegistrationStatus">@L.T("View registration status")</a>
