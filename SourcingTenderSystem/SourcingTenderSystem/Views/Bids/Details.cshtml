@model BidDetailsViewModel
@{
    var bid = Model.Bid;
    var panel = Context.Request.Query["panel"].ToString();
    var labels = new Dictionary<string, string> { ["overview"] = "Bid summary", ["prices"] = "Item prices", ["documents"] = "Bid documents", ["submission"] = "Bid submission" };
    var full = !labels.TryGetValue(panel, out var label);
    ViewData["Title"] = label ?? "Bid details";
    var priced = Model.Rows.Count - Model.MissingPrices;
    var tone = bid.Status switch { "Draft" => "draft", "Submitted" => "open", "Compliant" => "done", "Non-Compliant" or "Withdrawn" => "stop", _ => "review" };
    var ready = Model.Rows.Count > 0 && Model.MissingPrices == 0 && bid.BidDocuments.Count > 0;
}
<div class="pr-create prd bd tm-@tone">
<a class="back-link" asp-action="MyBids"><partial name="_Icon" model='@("back")' /> @L.T("My bids")</a>

<header class="pr-hero prd-hero">
    <span class="pr-hero-icon"><partial name="_Icon" model='@("file")' /></span>
    <div>
        <p class="eyebrow">@L.F("Supplier bid #{0}", bid.Id)</p>
        <h1>@(label is null ? bid.Tender.Title : L.T(label))</h1>
        <p class="prd-meta">
            <span><partial name="_Icon" model='@("briefcase")' /> @bid.Tender.Title</span>
            <span><partial name="_Icon" model='@("clock")' /> @L.F("Closes {0} (UTC)", bid.Tender.CloseDate.ToString("dd MMM yyyy · HH:mm", L.DisplayCulture))</span>
        </p>
    </div>
    <div class="prd-status"><span class="tm-status"><i></i>@L.T(bid.Status)</span>
        @if (bid.AwardOutcome is string result) { <span class="tm-status bd-result">@L.F("Result: {0}", L.T(result))</span> }</div>
</header>

@if (bid.Status == "Draft" && bid.Currency != Bid.JordanianDinar)
{
    <p class="prd-note is-returned"><span>@L.T("Only bids in Jordanian dinars can be submitted. Contact the sourcing officer about this older draft.")</span></p>
}
@if (TempData["Msg"] != null) { <div class="alert alert-success tm-alert" role="status"><partial name="_Icon" model='@("check")' /> @TempData["Msg"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger tm-alert" role="alert"><partial name="_Icon" model='@("warning")' /> @TempData["Error"]</div> }
@if (bid.Status == "Draft" && !Model.TenderIsOpen)
{
    <p class="prd-note is-returned"><span>@L.T("The tender is closed. This draft can no longer be changed or submitted.")</span></p>
}

@if (full || panel == "overview")
{
    @* ---------- Overview ---------- *@
    <section class="pr-card prd-card record-section">
        <div class="prd-card-head">
            <div class="pr-section-head mb-0"><span class="pr-badge"><partial name="_Icon" model='@("dashboard")' /></span><div><h2>@L.T("My bid")</h2><p>@L.T("Offer details, item prices and supporting documents.")</p></div></div>
            @if (Model.CanChange) { <a data-workspace-dialog class="btn tm-btn" asp-action="Edit" asp-route-id="@bid.Id"><partial name="_Icon" model='@("edit")' /> @L.T("Edit bid info")</a> }
        </div>
        <div class="prd-stats">
            <div class="prd-stat"><span>@L.T("Total price")</span><strong>@bid.TotalPrice.ToString("N2")</strong><small>@bid.Currency</small></div>
            <div class="prd-stat"><span>@L.T("Final cost (with tax)")</span><strong>@bid.TotalWithTax.ToString("N2")</strong><small>@bid.Currency</small></div>
            <div class="prd-stat"><span>@L.T("Delivery")</span><strong>@L.F("{0} days", bid.DeliveryDays)</strong></div>
            <div class="prd-stat"><span>@L.T("Offer validity")</span><strong>@L.F("{0} days", bid.ValidityDays)</strong></div>
        </div>
        <div class="bd-meta">
            <span><partial name="_Icon" model='@("clock")' /> @L.T("Submitted (UTC)"): <strong>@(bid.SubmittedAt?.ToString("dd MMM yyyy HH:mm", L.DisplayCulture) ?? "—")</strong></span>
            <span><partial name="_Icon" model='@("briefcase")' /> @L.T("Tender status"): <strong>@L.T(bid.Tender.Status)</strong></span>
        </div>
        @if (bid.ComplianceNotes != null)
        {
            <div class="prd-note mt-3 mb-0"><span class="pr-badge"><partial name="_Icon" model='@("mail")' /></span><div><h2>@L.T("Compliance notes")</h2><p class="mb-0">@bid.ComplianceNotes</p></div></div>
        }
        <div class="prd-reason">
            <h3>@L.T("Tender")</h3>
            <p class="record-terms mb-0">@bid.Tender.Description</p>
            <details class="td-terms"><summary><partial name="_Icon" model='@("file")' /> @L.T("Tender terms")</summary><p class="record-terms mt-2 mb-0">@bid.Tender.Terms</p></details>
        </div>
    </section>
    <partial name="_BidGuaranteeSummary" model="bid" />
    <div class="bd-links record-section"><a class="prd-link" data-workspace-dialog="details" asp-controller="Clarifications" asp-action="Index" asp-route-kind="bid" asp-route-recordId="@bid.Id"><partial name="_Icon" model='@("mail")' /> @L.T("Clarification history")</a></div>
}

@if (full || panel == "prices")
{
    @* ---------- Item prices ---------- *@
    <section class="pr-card prd-card record-section">
        <div class="prd-card-head">
            <div class="pr-section-head mb-0"><span class="pr-badge"><partial name="_Icon" model='@("briefcase")' /></span><div><h2>@L.T("Requested items and my prices")</h2><p>@L.F("{0} of {1} items priced", priced, Model.Rows.Count)</p></div></div>
            <span class="bd-total">@bid.TotalPrice.ToString("N2") <small>@bid.Currency</small></span>
        </div>
        @if (Model.Rows.Count > 0)
        {
            <div class="tm-bar bd-progress"><i style="width:@(priced * 100 / Model.Rows.Count)%"></i></div>
        }
        @if (Model.Rows.Count == 0)
        {
            <div class="prd-empty"><span class="pr-badge"><partial name="_Icon" model='@("inbox")' /></span><h3>@L.T("This tender has no requested items.")</h3></div>
        }
        else
        {
            <ol class="prd-items">
                @for (var i = 0; i < Model.Rows.Count; i++)
                {
                    var row = Model.Rows[i];
                    <li class="prd-item bd-item @(row.BidItem == null ? "is-missing" : "")">
                        <span class="pr-item-no">@(i + 1)</span>
                        <div class="prd-item-body">
                            <h3>@row.RequestedItem.ItemName</h3>
                            <p>@row.RequestedItem.Specifications</p>
                            @if (!string.IsNullOrWhiteSpace(row.BidItem?.Notes)) { <p class="bd-note">@row.BidItem.Notes</p> }
                            @if (row.BidItem?.Images.Count > 0) { <partial name="_ItemPhotos" model="row.BidItem.Images" view-data='@(new ViewDataDictionary(ViewData) { ["GalleryTitle"] = row.RequestedItem.ItemName })' /> }
                        </div>
                        <div class="bd-price">
                            <small>@row.RequestedItem.Quantity @L.T(row.RequestedItem.Unit) × @(row.BidItem?.UnitPrice.ToString("N2") ?? "—")</small>
                            <strong>@(row.BidItem == null ? L.T("Not priced") : (row.BidItem.UnitPrice * row.BidItem.Quantity).ToString("N2"))</strong>
                        </div>
                        @if (Model.CanChange)
                        {
                            <div class="record-action">
                                @if (row.BidItem == null)
                                {
                                    <a data-workspace-dialog class="btn tm-btn tm-btn-main" asp-controller="BidItems" asp-action="Create" asp-route-bidId="@bid.Id" asp-route-purchaseRequisitionItemId="@row.RequestedItem.Id" aria-label="@L.F("Add price for {0}", row.RequestedItem.ItemName)"><partial name="_Icon" model='@("plus")' /> @L.T("Add price")</a>
                                }
                                else
                                {
                                    <a data-workspace-dialog class="record-icon-action" asp-controller="BidItems" asp-action="Edit" asp-route-id="@row.BidItem.Id" aria-label="@L.F("Edit price for {0}", row.RequestedItem.ItemName)" data-tooltip="@L.T("Edit price")"><partial name="_Icon" model='@("edit")' /></a>
                                    <form asp-controller="BidItems" asp-action="Delete" asp-route-id="@row.BidItem.Id" method="post" data-workspace-confirm="@L.T("Delete the price for this item?")" onsubmit="return window.stmsWorkspaceReady || confirm(this.dataset.workspaceConfirm);">
                                        <button type="submit" class="record-icon-action record-icon-danger" aria-label="@L.F("Delete price for {0}", row.RequestedItem.ItemName)" data-tooltip="@L.T("Delete price")"><partial name="_Icon" model='@("trash")' /></button>
                                    </form>
                                }
                            </div>
                        }
                    </li>
                }
            </ol>
        }
    </section>
}

@if (full || panel == "documents")
{
    @* ---------- Documents ---------- *@
    <section class="pr-card prd-card record-section">
        <div class="prd-card-head">
            <div class="pr-section-head mb-0"><span class="pr-badge"><partial name="_Icon" model='@("file")' /></span><div><h2>@L.T("Supporting documents")</h2><p>@L.F("{0} attached", bid.BidDocuments.Count)</p></div></div>
            @if (Model.CanChange) { <a data-workspace-dialog class="btn tm-btn tm-btn-main" asp-controller="BidDocuments" asp-action="Upload" asp-route-bidId="@bid.Id"><partial name="_Icon" model='@("upload")' /> @L.T("Upload document")</a> }
            else if (bid.AwardOutcome == "Awarded") { <a data-workspace-dialog class="btn tm-btn tm-btn-main" asp-controller="BidDocuments" asp-action="Upload" asp-route-bidId="@bid.Id"><partial name="_Icon" model='@("upload")' /> @L.T("Upload warranty / guarantee")</a> }
        </div>
        @if (bid.BidDocuments.Count == 0)
        {
            <div class="prd-empty"><span class="pr-badge"><partial name="_Icon" model='@("file")' /></span><h3>@L.T("No documents uploaded.")</h3></div>
        }
        else
        {
            <div class="bd-docs">
                @foreach (var document in bid.BidDocuments)
                {
                    <article class="bd-doc">
                        @if (document.IsImage) { <img class="bd-thumb" src="@Url.Action("Download", "BidDocuments", new { id = document.Id, preview = true })" alt="@document.FileName" /> }
                        else { <span class="bd-pdf">PDF</span> }
                        <div class="bd-doc-body"><strong>@L.T(document.DocumentType)</strong><small>@document.FileName</small><small>@document.UploadedAt.ToString("dd MMM yyyy", L.DisplayCulture)</small></div>
                        <div class="record-action">
                            <a class="record-icon-action" asp-controller="BidDocuments" asp-action="Download" asp-route-id="@document.Id" asp-route-preview="true" target="_blank" rel="noopener" aria-label="@L.F("Preview {0}", document.FileName)" data-tooltip="@L.T(document.IsImage ? "Preview image" : "Preview PDF")"><partial name="_Icon" model='@("eye")' /></a>
                            <a class="record-icon-action" asp-controller="BidDocuments" asp-action="Download" asp-route-id="@document.Id" aria-label="@L.F("Download {0}", document.FileName)" data-tooltip="@L.T("Download")"><partial name="_Icon" model='@("download")' /></a>
                            @if (Model.CanChange)
                            {
                                <form asp-controller="BidDocuments" asp-action="Delete" asp-route-id="@document.Id" method="post" asp-antiforgery="true" data-workspace-confirm="@L.T("Delete this document?")" onsubmit="return window.stmsWorkspaceReady || confirm(this.dataset.workspaceConfirm);">
                                    <button type="submit" class="record-icon-action record-icon-danger" aria-label="@L.F("Remove {0}", document.FileName)" data-tooltip="@L.T("Remove")"><partial name="_Icon" model='@("trash")' /></button>
                                </form>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>
}

@if (full || panel == "submission")
{
    @* ---------- Submission ---------- *@
    <section class="pr-card prd-card record-section bd-submit-card">
        <div class="prd-card-head">
            <div class="pr-section-head mb-0"><span class="pr-badge"><partial name="_Icon" model='@("check")' /></span><div><h2>@L.T("Submission status")</h2>
                <p>@(bid.SubmittedAt is DateTime submitted ? L.F("Submitted {0} UTC", submitted.ToString("dd MMM yyyy HH:mm", L.DisplayCulture)) : Model.CanChange ? L.T("Check that the bid is ready before sending it.") : L.T("This bid cannot be changed."))</p></div></div>
        </div>
        @if (Model.CanChange)
        {
            <ul class="bd-checklist" aria-label="@L.T("Before you submit")">
                <li class="@(Model.Rows.Count > 0 && Model.MissingPrices == 0 ? "is-ok" : "")"><span class="bd-tick"><partial name="_Icon" model='@(Model.Rows.Count > 0 && Model.MissingPrices == 0 ? "check" : "close")' /></span>@L.F("Prices: {0} of {1} items priced", priced, Model.Rows.Count)</li>
                <li class="@(bid.BidDocuments.Count > 0 ? "is-ok" : "")"><span class="bd-tick"><partial name="_Icon" model='@(bid.BidDocuments.Count > 0 ? "check" : "close")' /></span>@L.F("Documents: {0} uploaded (at least 1 required)", bid.BidDocuments.Count)</li>
            </ul>
        }
        <div class="bd-submit-actions">
            @if (Model.CanSubmit)
            {
                <form asp-action="Submit" asp-route-id="@bid.Id" method="post" asp-antiforgery="true" data-workspace-confirm="@L.T("Submit this bid? You will not be able to change it after submitting.")" onsubmit="return window.stmsWorkspaceReady || confirm(this.dataset.workspaceConfirm);">
                    <button type="submit" class="btn btn-primary pr-submit"><partial name="_Icon" model='@("arrow")' /> @L.T("Submit bid")</button>
                </form>
            }
            else if (Model.CanChange)
            {
                <button type="button" class="btn btn-primary pr-submit" disabled title="@L.T(ready ? "Submit bid" : "Before you submit")"><partial name="_Icon" model='@("arrow")' /> @L.T("Submit bid")</button>
            }
            @if (Model.CanWithdraw)
            {
                <form asp-action="Withdraw" asp-route-id="@bid.Id" method="post" asp-antiforgery="true" data-workspace-confirm="@L.T("Withdraw this bid? You will NOT be able to bid again on this tender.")" onsubmit="return window.stmsWorkspaceReady || confirm(this.dataset.workspaceConfirm);">
                    <button type="submit" class="btn tm-btn tm-btn-danger"><partial name="_Icon" model='@("close")' /> @L.T("Withdraw bid")</button>
                </form>
            }
        </div>
    </section>
}
</div>
