@using System.Globalization
@model CommitteeBid
@{
    ViewData["Title"] = L.T("Review bid");
    var locked = ViewBag.ReadOnly is true;
    var entries = Model.Scores.Select((row, index) => (row, index)).ToList();
    string Percent(decimal value) => EvaluationRules.Round(value).ToString("0.##", CultureInfo.InvariantCulture) + "%";
    decimal Earned(CommitteeScoreRow row) => row.Score.GetValueOrDefault() * row.WeightPercent / row.Criterion.MaxScore;
}
<a class="back-link" asp-action="Details" asp-route-id="@Model.Bid.TenderId"><partial name="_Icon" model='@("back")' /> @L.T("Tender evaluation")</a>
<header class="page-heading stms-hero admin-record-hero"><div><p class="eyebrow">BID #@Model.Bid.Id · @Model.Bid.Tender.Title</p><h1>@Model.Bid.SupplierProfile.CompanyName</h1><p>@Model.Bid.TotalPrice.ToString("N2") @Model.Bid.Currency · Delivery in @Model.Bid.DeliveryDays days</p></div></header>
@if (TempData["ReviewError"] is string error) { <div class="alert alert-warning" role="alert">@L.T(error)</div> }
<div class="review-workspace">
<aside class="review-references" aria-label="@L.T("Bid reference materials")">
<details class="surface detail-card mb-3 bid-evidence">
    <summary>@L.T("Offered items") <span class="record-panel-label">@Model.Bid.BidItems.Count</span></summary>
    @if (Model.Bid.BidItems.Count == 0) { <div class="empty-state">@L.T("No items were attached to this bid.")</div> }
    else
    {
        <div class="record-list">
            @foreach (var item in Model.Bid.BidItems)
            {
                <article class="record-card"><div class="record-name"><span class="avatar"><partial name="_Icon" model='@("inbox")' /></span><span>@item.PurchaseRequisitionItem.ItemName<small>@item.PurchaseRequisitionItem.Specifications</small></span></div>
                    <dl class="record-facts"><div><dt>@L.T("Quantity")</dt><dd>@item.Quantity</dd></div><div><dt>@L.T("Unit price")</dt><dd>@item.UnitPrice.ToString("N2") @Model.Bid.Currency</dd></div>
                        @if (!string.IsNullOrWhiteSpace(item.Notes)) { <div><dt>@L.T("Supplier notes")</dt><dd>@item.Notes</dd></div> }</dl>
                </article>
            }
        </div>
    }
</details>
<details class="surface detail-card mb-3 bid-evidence"><summary>@L.T("Bid documents") <span class="record-panel-label">@Model.Bid.BidDocuments.Count</span></summary>
    @if (Model.Bid.BidDocuments.Count == 0) { <p class="subtle mb-0">@L.T("No documents attached.")</p> }
    else
    {
        <div class="record-list record-list-inset">
            @foreach (var doc in Model.Bid.BidDocuments)
            {
                <article class="record-card"><div class="record-name"><span class="avatar"><partial name="_Icon" model='@("file")' /></span><span>@doc.FileName<small>@L.T(doc.DocumentType)</small></span></div>
                    <div class="record-action"><a class="record-icon-action" asp-controller="BidDocuments" asp-action="Download" asp-route-id="@doc.Id" aria-label="Download @doc.FileName" data-tooltip="@L.T("Download")"><partial name="_Icon" model='@("download")' /></a></div>
                </article>
            }
        </div>
    }
</details>
</aside>
<section class="surface detail-card bid-checklist" aria-label="@L.T("Your evaluation")">
    <div class="record-section-heading"><div><h2>@L.T("Your evaluation checklist")</h2><p>@L.T(locked ? "Saved scores are read-only." : "Check each criterion the offer meets, then save the checklist for this bid.")</p></div>
        <span class="record-panel-label" data-checklist-total>@Percent(Model.Scores.Sum(Earned)) / @Percent(Model.Scores.Sum(r => r.WeightPercent))</span>
    </div>
    @if (Model.Scores.Count == 0) { <p class="subtle">@L.T("No valid criteria are selected for this evaluation.")</p> }
    else
    {
        <form asp-action="SaveChecklist" asp-route-id="@Model.Bid.Id" method="post" data-bid-checklist>
            @if (!locked && Model.Scores.Any(r => r.Score is decimal score && score > 0 && score < r.Criterion.MaxScore))
            {
                <p class="alert alert-info">@L.T("This bid has older partial scores. Saving this checklist replaces them with full weight or zero.")</p>
            }
            <div class="checklist-columns">
                @foreach (var (kind, icon) in new[] { ("Technical", "briefcase"), ("Financial", "chart") })
                {
                    var rows = entries.Where(e => e.row.Criterion.Type == kind).ToList();
                    var possible = rows.Sum(e => e.row.WeightPercent);
                    <fieldset class="checklist-group" data-checklist-group>
                        <legend><span class="icon-tile tone-teal"><partial name="_Icon" model="icon" /></span>@kind</legend>
                        <p class="checklist-subtotal"><output data-checklist-subtotal>@Percent(rows.Sum(e => Earned(e.row))) / @Percent(possible)</output></p>
                        @if (rows.Count == 0) { <p class="subtle mb-0">No active @kind.ToLowerInvariant() criteria.</p> }
                        @foreach (var (row, index) in rows)
                        {
                            <div class="checklist-entry">
                                <label class="checklist-choice">
                                    <input type="hidden" name="checks[@index].CriterionId" value="@row.Criterion.Id" />
                                    <input type="checkbox" name="checks[@index].Met" value="true" checked="@(row.Score == row.Criterion.MaxScore)" disabled="@locked"
                                           data-checklist-choice data-weight="@row.WeightPercent.ToString(CultureInfo.InvariantCulture)" />
                                    <span>@row.Criterion.Name</span>
                                    <strong>+@Percent(row.WeightPercent)</strong>
                                </label>
                                @if (locked)
                                {
                                    @if (row.Score.HasValue) { <p class="field-hint mb-0">Earned @Percent(Earned(row))</p> }
                                    @if (!string.IsNullOrWhiteSpace(row.Notes)) { <p class="field-hint mb-0">@row.Notes</p> }
                                    @if (row.Taxes.HasValue) { <p class="field-hint mb-0">Taxes: @row.Taxes · Extra costs: @row.Extras</p> }
                                }
                                else
                                {
                                    <details>
                                        <summary>@L.T(kind == "Financial" ? "Notes and costs" : "Review notes")</summary>
                                        <div class="form-grid mt-2">
                                            @if (kind == "Financial")
                                            {
                                                <label class="field">Taxes (@Model.Bid.Currency)<input class="form-control" name="checks[@index].Taxes" type="number" min="0" step=".01" value="@((row.Taxes ?? 0).ToString(CultureInfo.InvariantCulture))" /></label>
                                                <label class="field">Extra costs (@Model.Bid.Currency)<input class="form-control" name="checks[@index].Extras" type="number" min="0" step=".01" value="@((row.Extras ?? 0).ToString(CultureInfo.InvariantCulture))" /></label>
                                            }
                                            <label class="field field-wide">@L.T("Notes")<textarea class="form-control" name="checks[@index].Notes" rows="2" maxlength="1000">@row.Notes</textarea></label>
                                        </div>
                                    </details>
                                }
                            </div>
                        }
                    </fieldset>
                }
            </div>
            @if (!locked)
            {
                <div class="form-actions mt-3 checklist-save"><button class="btn btn-primary" type="submit"><partial name="_Icon" model='@("check")' /> @L.T("Save checklist")</button></div>
            }
        </form>
    }
</section>
</div>
