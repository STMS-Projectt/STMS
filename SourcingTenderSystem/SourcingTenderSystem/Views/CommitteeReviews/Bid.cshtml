@using System.Globalization
@model CommitteeBid
@{
    ViewData["Title"] = L.T("Review bid");
    var locked = ViewBag.ReadOnly is true;
    var entries = Model.Scores.Select((row, index) => (row, index)).ToList();
    string Percent(decimal value) => EvaluationRules.Round(value).ToString("0.##", CultureInfo.InvariantCulture) + "%";
    decimal Earned(CommitteeScoreRow row) => row.Score.GetValueOrDefault() * row.WeightPercent / row.Criterion.MaxScore;
    string Fill(decimal earned, decimal possible) => (possible <= 0 ? 0 : Math.Min(100, earned * 100 / possible)).ToString("0.##", CultureInfo.InvariantCulture) + "%";
}
<div class="pr-create prd rb">
<a class="back-link" asp-action="Details" asp-route-id="@Model.Bid.TenderId"><partial name="_Icon" model='@("back")' /> @L.T("Tender evaluation")</a>
<header class="pr-hero prd-hero">
    <span class="pr-hero-icon"><partial name="_Icon" model='@("supplier")' /></span>
    <div>
        <p class="eyebrow">@L.F("Bid #{0}", Model.Bid.Id) · @Model.Bid.Tender.Title</p>
        <h1>@Model.Bid.SupplierProfile.CompanyName</h1>
        <p class="prd-meta"><span><partial name="_Icon" model='@("briefcase")' /> @Model.Bid.Tender.Title</span></p>
    </div>
    <div class="prd-status"><span class="tm-status"><i></i>@L.T(locked ? "Locked" : "In progress")</span></div>
    <div class="cm-stats">
        <div><strong>@Model.Bid.TotalPrice.ToString("N2")</strong><span>@L.T("Total price") · @Model.Bid.Currency</span></div>
        <div><strong>@Model.Bid.TotalWithTax.ToString("N2")</strong><span>@L.T("Final cost (with tax)")</span></div>
        <div><strong>@L.F("{0} days", Model.Bid.DeliveryDays)</strong><span>@L.T("Delivery")</span></div>
        <div class="is-hot"><strong data-checklist-total-mirror>@Percent(Model.Scores.Sum(Earned)) / @Percent(Model.Scores.Sum(r => r.WeightPercent))</strong><span>@L.T("Your evaluation")</span></div>
    </div>
</header>
@if (TempData["ReviewError"] is string error) { <div class="alert alert-warning tm-alert" role="alert"><partial name="_Icon" model='@("warning")' /> @L.T(error)</div> }

<section class="pr-card prd-card bid-checklist rb-checklist" aria-label="@L.T("Your evaluation")">
    <div class="record-section-heading"><div class="pr-section-head mb-0"><span class="pr-badge"><partial name="_Icon" model='@("check")' /></span><div><h2>@L.T("Your evaluation checklist")</h2><p>@L.T(locked ? "Saved scores are read-only." : "Check each criterion the offer meets, then save the checklist for this bid.")</p></div></div>
        <span class="record-panel-label checklist-total" data-checklist-total>@Percent(Model.Scores.Sum(Earned)) / @Percent(Model.Scores.Sum(r => r.WeightPercent))</span>
    </div>
    <div class="checklist-meter checklist-meter-total" data-checklist-meter style="--fill:@Fill(Model.Scores.Sum(Earned), Model.Scores.Sum(r => r.WeightPercent))" aria-hidden="true"><span></span></div>
    @if (Model.Scores.Count == 0) { <p class="subtle">@L.T("No valid criteria are selected for this evaluation.")</p> }
    else
    {
        <form asp-action="SaveChecklist" asp-route-id="@Model.Bid.Id" method="post" data-bid-checklist>
            @if (!locked && Model.Scores.Any(r => r.Score is decimal score && score > 0 && score < r.Criterion.MaxScore))
            {
                <p class="alert alert-info">@L.T("This bid has older partial scores. Saving this checklist replaces them with full weight or zero.")</p>
            }
            <div class="checklist-columns">
                @foreach (var (kind, icon) in new[] { ("Technical", "briefcase"), ("Financial", "chart") })
                {
                    var rows = entries.Where(e => e.row.Criterion.Type == kind).ToList();
                    var possible = rows.Sum(e => e.row.WeightPercent);
                    <fieldset class="checklist-group checklist-@kind.ToLowerInvariant()" data-checklist-group>
                        <legend><span class="icon-tile @(kind == "Technical" ? "tone-teal" : "tone-blue")"><partial name="_Icon" model="icon" /></span>@L.T(kind)</legend>
                        <p class="checklist-subtotal"><output data-checklist-subtotal>@Percent(rows.Sum(e => Earned(e.row))) / @Percent(possible)</output></p>
                        <div class="checklist-meter" data-checklist-meter style="--fill:@Fill(rows.Sum(e => Earned(e.row)), possible)" aria-hidden="true"><span></span></div>
                        @if (rows.Count == 0) { <p class="subtle mb-0">@L.F("No active {0} criteria.", L.T(kind))</p> }
                        @foreach (var (row, index) in rows)
                        {
                            <div class="checklist-entry">
                                <label class="checklist-choice">
                                    <input type="hidden" name="checks[@index].CriterionId" value="@row.Criterion.Id" />
                                    <input type="checkbox" name="checks[@index].Met" value="true" checked="@(row.Score == row.Criterion.MaxScore)" disabled="@locked"
                                           data-checklist-choice data-weight="@row.WeightPercent.ToString(CultureInfo.InvariantCulture)" />
                                    <span>@row.Criterion.Name</span>
                                    <strong>+@Percent(row.WeightPercent)</strong>
                                </label>
                                @if (locked)
                                {
                                    @if (row.Score.HasValue) { <p class="field-hint mb-0">@L.F("Earned {0}", Percent(Earned(row)))</p> }
                                    @if (!string.IsNullOrWhiteSpace(row.Notes)) { <p class="field-hint mb-0">@row.Notes</p> }
                                    @if (row.Taxes.HasValue) { <p class="field-hint mb-0">@L.F("Taxes: {0} · Extra costs: {1}", row.Taxes, row.Extras)</p> }
                                }
                                else
                                {
                                    <details>
                                        <summary>@L.T(kind == "Financial" ? "Notes and costs" : "Review notes")</summary>
                                        <div class="form-grid mt-2">
                                            @if (kind == "Financial")
                                            {
                                                <label class="field">@L.F("Taxes ({0})", Model.Bid.Currency)<input class="form-control" name="checks[@index].Taxes" type="number" min="0" step=".01" value="@((row.Taxes ?? 0).ToString(CultureInfo.InvariantCulture))" /></label>
                                                <label class="field">@L.F("Extra costs ({0})", Model.Bid.Currency)<input class="form-control" name="checks[@index].Extras" type="number" min="0" step=".01" value="@((row.Extras ?? 0).ToString(CultureInfo.InvariantCulture))" /></label>
                                            }
                                            <label class="field field-wide">@L.T("Notes")<textarea class="form-control" name="checks[@index].Notes" rows="2" maxlength="1000">@row.Notes</textarea></label>
                                        </div>
                                    </details>
                                }
                            </div>
                        }
                    </fieldset>
                }
            </div>
            @if (!locked)
            {
                <div class="form-actions mt-3 checklist-save"><button class="btn btn-primary" type="submit"><partial name="_Icon" model='@("check")' /> @L.T("Save checklist")</button></div>
            }
        </form>
    }
</section>

<div class="rb-refs">
    @* ---------- Offered items ---------- *@
    <section class="pr-card prd-card">
        <div class="prd-card-head"><div class="pr-section-head mb-0"><span class="pr-badge"><partial name="_Icon" model='@("inbox")' /></span><div><h2>@L.T("Offered items")</h2></div></div><span class="pr-count">@Model.Bid.BidItems.Count</span></div>
        @if (Model.Bid.BidItems.Count == 0) { <div class="prd-empty"><h3>@L.T("No items were attached to this bid.")</h3></div> }
        else
        {
            <ol class="prd-items">
                @foreach (var item in Model.Bid.BidItems)
                {
                    <li class="prd-item bd-item">
                        <span class="pr-item-no"><partial name="_Icon" model='@("inbox")' /></span>
                        <div class="prd-item-body">
                            <h3>@item.PurchaseRequisitionItem.ItemName</h3>
                            <p>@item.PurchaseRequisitionItem.Specifications</p>
                            @if (!string.IsNullOrWhiteSpace(item.Notes)) { <p class="bd-note">@L.T("Supplier notes"): @item.Notes</p> }
                            @if (item.Images.Count > 0) { <partial name="_ItemPhotos" model="item.Images" view-data='@(new ViewDataDictionary(ViewData) { ["GalleryTitle"] = item.PurchaseRequisitionItem.ItemName })' /> }
                        </div>
                        <div class="bd-price"><small>@item.Quantity × @item.UnitPrice.ToString("N2")</small><strong>@((item.Quantity * item.UnitPrice).ToString("N2")) <small>@Model.Bid.Currency</small></strong></div>
                    </li>
                }
            </ol>
        }
    </section>

    @* ---------- Documents ---------- *@
    <section class="pr-card prd-card">
        <div class="prd-card-head"><div class="pr-section-head mb-0"><span class="pr-badge"><partial name="_Icon" model='@("file")' /></span><div><h2>@L.T("Bid documents")</h2></div></div><span class="pr-count">@Model.Bid.BidDocuments.Count</span></div>
        @if (Model.Bid.BidDocuments.Count == 0) { <div class="prd-empty"><h3>@L.T("No documents attached.")</h3></div> }
        else
        {
            <div class="bd-docs rb-docs">
                @foreach (var doc in Model.Bid.BidDocuments)
                {
                    <article class="bd-doc">
                        @if (doc.IsImage) { <img class="bd-thumb" src="@Url.Action("Download", "BidDocuments", new { id = doc.Id, preview = true })" alt="@doc.FileName" /> } else { <span class="bd-pdf">PDF</span> }
                        <div class="bd-doc-body"><strong>@L.T(doc.DocumentType)</strong><small>@doc.FileName</small></div>
                        <div class="record-action">
                            <a class="record-icon-action" asp-controller="BidDocuments" asp-action="Download" asp-route-id="@doc.Id" asp-route-preview="true" target="_blank" rel="noopener" aria-label="@L.F("Preview {0}", doc.FileName)" data-tooltip="@L.T("Preview PDF")"><partial name="_Icon" model='@("eye")' /></a>
                            <a class="record-icon-action" asp-controller="BidDocuments" asp-action="Download" asp-route-id="@doc.Id" aria-label="@L.F("Download {0}", doc.FileName)" data-tooltip="@L.T("Download")"><partial name="_Icon" model='@("download")' /></a>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>

<partial name="_BidGuaranteeSummary" model="Model.Bid" />
</div>
