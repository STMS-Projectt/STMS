@model AiRecommendationView
@if (Model.Analysis is null)
{
    <div class="ai-box-state" role="status">
        <partial name="_Icon" model='@("warning")' />
        <div>
            <strong>@L.T("The AI recommendation is not available right now.")</strong>
            <p class="subtle mb-2">@Model.Error</p>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-ai-retry>@L.T("Try again")</button>
        </div>
    </div>
}
else
{
    var analysis = Model.Analysis;
    var best = analysis.RecommendedBid;
    var bestFacts = analysis.Facts.Single(f => f.BidId == best.BidId);
    <div class="ai-pick">
        <span class="ai-pick-icon" aria-hidden="true"><partial name="_Icon" model='@("trophy")' /></span>
        <div class="ai-pick-body">
            <p class="ai-label">@L.T("Best offer according to the AI")</p>
            <h3>@best.Supplier</h3>
            <ul class="ai-pick-facts">
                <li><strong>@best.TotalPrice.ToString("N2")</strong> @best.Currency</li>
                <li>@L.F("Delivery in {0} days", best.DeliveryDays)</li>
                <li>@L.F("{0} of {1} items covered", bestFacts.ItemsCovered, bestFacts.ItemsRequested)</li>
            </ul>
            <p class="ai-headline">@analysis.Output.Headline</p>
        </div>
    </div>
    @if (analysis.Output.WhyChosen.Count > 0)
    {
        <p class="ai-reasons-title">@L.T("Why the AI chose this offer over the others")</p>
        <ul class="ai-reasons">
            @foreach (var reason in analysis.Output.WhyChosen.Take(3)) { <li>@reason</li> }
        </ul>
    }
    <div class="ai-actions ai-report-actions">
        <a class="btn btn-primary" asp-action="AiReport" asp-route-id="@Model.TenderId"><partial name="_Icon" model='@("download")' /> @L.T("Download full AI report") <span class="ai-file-badge">PDF</span></a>
        <span class="ai-report-meta"><partial name="_Icon" model='@("clock")' /> @L.F("Generated {0} · {1} · {2} bids compared", analysis.GeneratedAtUtc.ToLocalTime().ToString("g", L.DisplayCulture), analysis.Model, analysis.Input.Bids.Count)</span>
    </div>
}
